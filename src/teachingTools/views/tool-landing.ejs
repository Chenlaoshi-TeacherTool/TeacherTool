<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#194f45">
  <title><%= toolGuide.title %> - Chen Laoshi's Teaching Toolkit</title>
  <%- include('partials/seo', { pageDescription: toolGuide.summary }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/stylesheets/content-pages.css">
</head>
<body>
  <header class="content-hero content-hero--tool">
    <div class="content-shell">
      <p class="content-kicker"><%= toolGuide.eyebrow %></p>
      <h1><%= toolGuide.title %></h1>
      <p><%= toolGuide.summary %></p>
      <div class="content-actions">
        <a class="btn" href="<%= toolGuide.appUrl %>"><%= t('toolLanding.openTool') %></a>
        <a class="text-link" href="<%= sectionPath %>"><%= t('toolLanding.viewAllPrefix') %> <%= sectionLabel %></a>
      </div>
    </div>
  </header>

  <main>
    <% if (typeof showToolGuide === 'undefined' || showToolGuide) { %>
      <%- include('partials/tool-guide', { toolGuide: toolGuide }) %>
    <% } %>
    <section class="content-section content-section--soft">
      <div class="content-shell content-cta">
        <div>
          <p class="content-kicker"><%= t('toolLanding.beforeYouBegin') %></p>
          <h2><%= t('toolLanding.startHeading') %></h2>
          <p><%= t('toolLanding.startText') %></p>
        </div>
        <a class="btn" href="<%= toolGuide.appUrl %>"><%= t('toolLanding.openToolNow') %></a>
      </div>
    </section>
  </main>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
