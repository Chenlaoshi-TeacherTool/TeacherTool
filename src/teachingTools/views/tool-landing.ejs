<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#194f45">
  <title><%= toolGuide.title %> - Chen Laoshi's Teaching Toolkit</title>
  <%- include('partials/seo', { pageDescription: toolGuide.summary }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/stylesheets/content-pages.css">
</head>
<body>
  <header class="content-hero content-hero--tool">
    <div class="content-shell">
      <p class="content-kicker"><%= toolGuide.eyebrow %></p>
      <h1><%= toolGuide.title %></h1>
      <p><%= toolGuide.summary %></p>
      <div class="content-actions">
        <a class="btn" href="<%= toolGuide.appUrl %>">Open the tool →</a>
        <a class="text-link" href="<%= sectionPath %>">View all <%= sectionLabel %></a>
      </div>
    </div>
  </header>

  <main>
    <% if (toolGuide.title !== 'Vocabulary Sudoku' && (typeof showToolGuide === 'undefined' || showToolGuide)) { %>
      <%- include('partials/tool-guide', { toolGuide: toolGuide }) %>
    <% } %>
    <section class="content-section content-section--soft">
      <div class="content-shell content-cta">
        <div>
          <p class="content-kicker">Before you begin</p>
          <h2>Start with the learning goal, then open the generator</h2>
          <p>The generator handles layout or randomization. You still choose the content, difficulty, and classroom interaction. Test the finished material from a student's point of view before class.</p>
        </div>
        <a class="btn" href="<%= toolGuide.appUrl %>">Open the tool now</a>
      </div>
    </section>
  </main>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
