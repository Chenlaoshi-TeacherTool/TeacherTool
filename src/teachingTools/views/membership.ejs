<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="theme-color" content="#194f45">
  <title><%= t('membership.kicker') %> - Chen Laoshi's Teaching Toolkit</title>
  <%- include('partials/seo', { pageDescription: 'Every classroom tool on Chen Laoshi’s Teaching Toolkit stays free. See the planned teacher membership for cloud saving and the founding member price.' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css"><link rel="stylesheet" href="/stylesheets/content-pages.css">
</head>
<body>
  <header class="content-hero"><div class="content-shell">
    <p class="content-kicker"><%= t('membership.kicker') %></p>
    <h1><%= t('membership.title') %></h1>
    <p><%= t('membership.intro') %></p>
  </div></header>
  <main>
    <section class="content-section"><div class="content-shell">
      <% if (!paymentsOpen) { %><p class="plan-notice" role="note"><%= t('membership.notice') %></p><% } %>
      <div class="plan-grid">
        <article class="plan-card">
          <h2><%= t('membership.freeName') %></h2>
          <p class="plan-price"><strong><%= t('membership.freePrice') %></strong> <span><%= t('membership.freePer') %></span></p>
          <ul><li><%= t('membership.freeLi1') %></li><li><%= t('membership.freeLi2') %></li><li><%= t('membership.freeLi3') %></li></ul>
        </article>
        <% plans.forEach(function (plan) { var half = plan.key === 'half-year'; %>
          <article class="plan-card<%= plan.recommended ? ' plan-card--featured' : '' %>">
            <p class="plan-badges"><span class="printable-badge printable-badge--inline"><%= t('membership.foundingBadge') %></span><% if (plan.recommended) { %> <span class="plan-best"><%= t('membership.recommended') %></span><% } %></p>
            <h2><%= t(half ? 'membership.halfName' : 'membership.yearName') %></h2>
            <p class="plan-price"><s aria-label="<%= t('membership.regularLabel') %>">$<%= plan.regular %></s> <strong>$<%= plan.founding %></strong> <span><%= t(half ? 'membership.perHalf' : 'membership.perYear') %></span></p>
            <p class="plan-note"><%= t(half ? 'membership.halfMonthly' : 'membership.yearMonthly') %></p>
            <ul><li><%= t('membership.paidLi1') %></li><li><%= t('membership.paidLi2') %></li><li><%= t('membership.paidLi3') %></li><li><%= t('membership.paidLi4') %></li><li><%= t('membership.paidLi5') %></li></ul>
            <button class="btn plan-button" type="button" disabled><%= t('membership.comingSoon') %></button>
          </article>
        <% }) %>
      </div>
    </div></section>
    <section class="content-section content-section--soft"><div class="content-shell prose-grid">
      <article><h2><%= t('membership.faqTitle') %></h2>
        <h3><%= t('membership.q1') %></h3><p><%= t('membership.a1') %></p>
        <h3><%= t('membership.q2') %></h3><p><%= t('membership.a2') %></p>
        <h3><%= t('membership.q3') %></h3><p><%= t('membership.a3') %></p>
      </article>
      <article>
        <h3><%= t('membership.q4') %></h3><p><%= t('membership.a4') %></p>
        <h3><%= t('membership.q5') %></h3><p><%= t('membership.a5Before') %><a href="mailto:clsteachingtools@gmail.com">clsteachingtools@gmail.com</a><%= t('membership.a5After') %></p>
      </article>
    </div></section>
  </main>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
