<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#194f45">
  <title><%= article.title %> - Chen Laoshi's Teaching Resources</title>
  <%- include('../partials/adsense') %>
  <%- include('../partials/seo', { pageDescription: article.description, pageType: 'article' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/stylesheets/content-pages.css">
</head>
<body>
  <header class="article-hero">
    <div class="article-shell">
      <p class="content-kicker"><%= article.category %> · <%= article.readTime %></p>
      <h1><%= article.title %></h1>
      <p><%= article.description %></p>
      <p class="article-byline">Chen Laoshi's Teaching Resources · Last updated August 20, 2026</p>
    </div>
  </header>

  <main class="article-shell article-layout">
    <article class="article-content">
      <% article.intro.forEach(function(paragraph) { %><p class="article-lead"><%= paragraph %></p><% }) %>
      <% article.sections.forEach(function(section) { %>
        <section>
          <h2><%= section.heading %></h2>
          <% (section.paragraphs || []).forEach(function(paragraph) { %><p><%= paragraph %></p><% }) %>
          <% if (section.list) { %><ul><% section.list.forEach(function(item) { %><li><%= item %></li><% }) %></ul><% } %>
          <% if (section.callout) { %><aside class="article-callout"><strong>Classroom note:</strong> <%= section.callout %></aside><% } %>
        </section>
      <% }) %>
      <section class="article-tool-cta">
        <div><p class="content-kicker">Put the method into practice</p><h2>Related tool or resource</h2><p>Choose the learning goal before the tool. The tool can save preparation time; the teacher still makes the instructional decisions.</p></div>
        <a class="btn" href="<%= article.relatedTool.href %>"><%= article.relatedTool.label %> →</a>
      </section>
      <p class="article-editorial-note"><strong>Editorial note:</strong> This site does not publish articles for volume. Each resource is organized around a clear classroom task and teacher judgment. Adapt the ideas for student age, subject knowledge, language proficiency, learning needs, and school policy.</p>
    </article>
    <aside class="article-sidebar" aria-label="More teaching resources">
      <p class="content-kicker">Keep reading</p>
      <h2>More classroom methods</h2>
      <% relatedArticles.forEach(function(item) { %>
        <a href="/resources/<%= item.slug %>"><span><%= item.category %></span><strong><%= item.title %></strong></a>
      <% }) %>
      <a class="article-sidebar__all" href="/resources">View all teaching resources →</a>
    </aside>
  </main>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
