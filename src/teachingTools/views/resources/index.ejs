<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#194f45">
  <title>Teaching Resources and Teacher Blog - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/adsense') %>
  <%- include('../partials/seo', { pageDescription: 'Practical teaching articles with classroom workflows, examples, and teacher decision points. Includes Chinese language teaching and ideas adaptable across subjects.' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/stylesheets/content-pages.css">
</head>
<body>
  <header class="content-hero">
    <div class="content-shell">
      <p class="content-kicker"><%= t('resourcesIndex.kicker') %></p>
      <h1><%= t('resourcesIndex.title') %></h1>
      <p><%= t('resourcesIndex.intro') %></p>
    </div>
  </header>
  <main class="content-section">
    <div class="content-shell">
      <nav class="filter-chips" aria-label="Resource categories">
        <a href="/resources" class="<%= !activeCategory ? 'active' : '' %>"><%= t('resourcesIndex.allResources') %></a>
        <% categories.forEach(function(category) { %><a href="/resources?category=<%= encodeURIComponent(category) %>" class="<%= activeCategory === category ? 'active' : '' %>"><%= category %></a><% }) %>
      </nav>
      <div class="resource-grid">
        <% articles.forEach(function(article) { %>
          <article class="resource-card">
            <p class="resource-card__meta"><%= article.category %> · <%= article.readTime %></p>
            <h2><a href="/resources/<%= article.slug %>"><%= article.title %></a></h2>
            <p><%= article.description %></p>
            <a class="resource-card__link" href="/resources/<%= article.slug %>"><%= t('resourcesIndex.readGuide') %></a>
          </article>
        <% }) %>
      </div>
      <% if (!articles.length) { %><p class="empty-state"><%= t('resourcesIndex.emptyState') %></p><% } %>
    </div>
  </main>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
