<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Theme Activities - Teacher Toolkit</title>
    <%- include('../partials/seo', { pageDescription: 'Browse Chinese language lessons, games, songs, and classroom-ready activities by theme.' }) %>

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f8f9fa;
            color: #333;
            line-height: 1.6;
        }

        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 40px 20px;
            text-align: center;
        }

        .header h1 {
            margin-bottom: 10px;
        }

        .back-btn {
            position: absolute;
            top: 20px;
            left: 20px;
            background-color: rgba(255, 255, 255, 0.2);
            border: 1px solid white;
            color: white;
            padding: 10px 15px;
            text-decoration: none;
            border-radius: 5px;
        }

        /* 🔍 SEARCH BOX */
        .search-container {
            text-align: center;
            margin: 20px;
        }

        #searchBox {
            width: 80%;
            max-width: 500px;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #ccc;
            font-size: 16px;
        }

        .tools-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 20px;
            padding: 40px 20px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .tool-card {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            text-align: center;
            transition: transform 0.3s;
        }

        .tool-card:hover {
            transform: translateY(-5px);
        }

        .tool-card:has(.btn:disabled) {
            background: #f3f4f6;
            box-shadow: none;
            opacity: 0.68;
        }

        .tool-card:has(.btn:disabled):hover {
            transform: none;
        }

        .tool-card h3 {
            color: #667eea;
            margin-bottom: 10px;
        }

        .tool-card p {
            margin-bottom: 15px;
            font-size: 14px;
        }

        .btn {
            background-color: #667eea;
            color: white;
            padding: 10px 18px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            font-size: 14px;
        }

        .btn:hover {
            background-color: #5a67d8;
        }

        .btn:disabled {
            background-color: #aab1bf;
            color: #f8fafc;
            cursor: not-allowed;
        }

        @media (max-width: 768px) {
            .tools-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <link rel="stylesheet" href="/stylesheets/site-theme.css">
</head>

<body>

    <a href="/" class="back-btn">← <%= t('themeActivities.backToHomepage') %></a>

    <section class="header">
        <h1><%= t('themeActivities.title') %></h1>
        <p><%= t('themeActivities.intro') %></p>
    </section>

    <!-- 🔍 SEARCH BOX -->
    <div class="search-container">
        <input
            type="text"
            id="searchBox"
            placeholder="🔍 <%= t('themeActivities.searchPlaceholder') %>"
            onkeyup="filterThemes()"
        >
    </div>

    <section class="tools-grid">
        <% (typeof customThemes === 'undefined' ? [] : customThemes).forEach(function (theme) { %>
        <div class="tool-card" data-tags="<%= theme.key %> <%= theme.en %> <%= theme.zh %>">
            <h3><%= lang === 'zh' ? theme.zh : theme.en %></h3>
            <p><%= lang === 'zh' ? '主题课堂活动与可打印材料。' : 'Themed classroom activities and printable materials.' %></p>
            <a href="<%= theme.href %>" class="btn"><%= t('themeActivities.openTheme') %></a>
        </div>
        <% }) %>

        <div class="tool-card" data-tags="materials upload 活动材料 上传 教材关联">
            <h3>📄 <%= lang === 'zh' ? '活动材料' : 'Activity materials' %></h3>
            <p><%= lang === 'zh' ? '浏览、上传和编辑材料，手动关联适用教材课次。' : 'Browse, upload and edit materials, and link them to textbook lessons.' %></p>
            <a href="/materials" class="btn"><%= lang === 'zh' ? '查看材料' : 'Browse materials' %></a>
        </div>

        <div class="tool-card" data-tags="five-elements Five Elements 五行 五行星球 星球寻宝 金木水火土">
            <h3>🪐 <%= lang === 'zh' ? '五行' : 'Five Elements' %></h3>
            <p><%= lang === 'zh' ? '五行主题课堂活动、可打印材料与教材配套资源。' : 'Classroom activities, printable materials and textbook resources about the Five Elements.' %></p>
            <a href="/theme-activities/five-elements" class="btn"><%= t('themeActivities.openTheme') %></a>
        </div>

        <div class="tool-card" data-tags="self-introduction personal introduction 个人介绍 自我介绍 我是谁 Who Am I">
            <h3>👋 <%= lang === 'zh' ? '个人介绍' : 'Self-introduction' %></h3>
            <p><%= lang === 'zh' ? '通过人物介绍阅读与配对活动，练习介绍自己。' : 'Practice personal introductions with character reading and matching activities.' %></p>
            <a href="/theme-activities/self-introduction" class="btn"><%= t('themeActivities.openTheme') %></a>
        </div>

        <div class="tool-card" data-tags="halloween Halloween 万圣节">
            <h3>🎃 <%= lang === 'zh' ? '万圣节' : 'Halloween' %></h3>
            <p><%= lang === 'zh' ? '词汇、游戏与可打印材料。' : 'Vocabulary, games, and printables.' %></p>
            <a href="/theme-activities/halloween" class="btn"><%= t('themeActivities.openTheme') %></a>
        </div>

        <div class="tool-card" data-tags="chinese-new-year Chinese New Year 春节">
            <h3>🧧 <%= lang === 'zh' ? '春节' : 'Chinese New Year' %></h3>
            <p><%= lang === 'zh' ? '词汇、游戏与可打印材料。' : 'Vocabulary, games, and printables.' %></p>
            <a href="/theme-activities/chinese-new-year" class="btn"><%= t('themeActivities.openTheme') %></a>
        </div>

        <div class="tool-card" data-tags="animals Animals 动物">
            <h3>🐾 <%= lang === 'zh' ? '动物' : 'Animals' %></h3>
            <p><%= lang === 'zh' ? '词汇、游戏与可打印材料。' : 'Vocabulary, games, and printables.' %></p>
            <a href="/theme-activities/animals" class="btn"><%= t('themeActivities.openTheme') %></a>
        </div>


        <div class="tool-card" data-tags="weather seasons 四季 天气">
            <h3>🌦 <%= t('themeActivities.weatherTitle') %></h3>
            <p><%= t('themeActivities.weatherDesc') %></p>
            <a href="/theme-activities/weather" class="btn"><%= t('themeActivities.openTheme') %></a>
        </div>

        <div class="tool-card" data-tags="festivals holidays mid autumn 中秋节 节日">
            <h3>🥮 <%= t('themeActivities.midAutumnTitle') %></h3>
            <p><%= t('themeActivities.midAutumnDesc') %></p>
            <a href="/resources/teaching-mid-autumn-festival-grade-one" class="btn"><%= t('themeActivities.readLesson') %></a>
        </div>

        <div class="tool-card" data-tags="games vocabulary classroom 中文 游戏 词汇">
            <h3>🎲 <%= t('themeActivities.gameIdeasTitle') %></h3>
            <p><%= t('themeActivities.gameIdeasDesc') %></p>
            <a href="/resources/ten-games-for-chinese-beginners" class="btn"><%= t('themeActivities.readGameGuide') %></a>
        </div>
    </section>

    <!-- 🔍 JS SEARCH FUNCTION -->
    <script>
        function filterThemes() {
            let input = document.getElementById("searchBox").value.toLowerCase();
            let cards = document.querySelectorAll(".tool-card");

            cards.forEach(card => {
                let tags = card.getAttribute("data-tags").toLowerCase();
                let text = card.innerText.toLowerCase();

                if (tags.includes(input) || text.includes(input)) {
                    card.style.display = "block";
                } else {
                    card.style.display = "none";
                }
            });
        }
    </script>
    <script src="/javascripts/account-coming-soon.js"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
