<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>主题活动 · Theme Activities - Chen Laoshi's Teaching Toolkit</title>
    <%- include('../partials/seo', { pageDescription: 'Browse Chinese language lessons, games, songs, and classroom-ready activities by theme.' }) %>

    <style>
        /* Colours, fonts, cards and buttons come from site-theme.css; this is page layout only. */
        .header { text-align: center; }
        .header h1 { margin-bottom: 10px; }

        .theme-directory { max-width: 1240px; margin: 0 auto; padding: 0 20px 40px; }

        .theme-search { max-width: 650px; margin: 30px 0 22px; }
        .theme-search label { display: block; margin: 0 0 8px; color: var(--chalk); font-weight: 800; }
        .theme-search-input { position: relative; }
        .theme-search-input span { position: absolute; top: 50%; left: 15px; transform: translateY(-50%); color: var(--leaf); pointer-events: none; }
        .theme-search input { box-sizing: border-box; width: 100%; padding: 13px 16px 13px 42px; font-size: 1rem; }
        .theme-search-status { min-height: 1.6em; margin: 7px 0 0; color: var(--muted); font-size: .9rem; }
        .theme-search-status.is-empty { color: var(--ink); font-weight: 700; }
        .theme-search .btn { margin-top: 10px; }
        .theme-search .btn[hidden] { display: none; }

        .theme-jump { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 28px; }
        .theme-jump a { padding: 8px 14px; border: 1px solid #cbdac2; border-radius: 22px; color: var(--chalk); font-weight: 700; text-decoration: none; }
        .theme-jump a:hover { background: var(--leaf-wash); }
        .theme-jump a[hidden] { display: none; }
        .theme-group { margin: 0 0 32px; scroll-margin-top: 24px; }
        .theme-group h2 { margin: 0 0 14px; color: var(--chalk); }
        .theme-group[hidden], .tool-card[hidden] { display: none; }

        .tools-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; }
        .tool-card { padding: 25px; text-align: center; }
        .tool-card h3 { margin-bottom: 10px; }
        .tool-card p { margin-bottom: 15px; font-size: 14px; }
        .btn { display: inline-block; padding: 10px 18px; font-size: 14px; cursor: pointer; }

        @media (max-width: 768px) {
            .tools-grid { grid-template-columns: 1fr; }
        }
    </style>
    <link rel="stylesheet" href="/stylesheets/site-theme.css">
    <link rel="stylesheet" href="/shared/tool-favorites.css?v=2">
</head>

<body>

    <section class="header">
        <h1><%= t('themeActivities.title') %></h1>
        <p><%= t('themeActivities.intro') %></p>
    </section>

    <main class="theme-directory">
        <section class="theme-search" aria-labelledby="theme-search-label">
            <label id="theme-search-label" for="searchBox"><%= t('themeActivities.findLabel') %></label>
            <div class="theme-search-input">
                <span aria-hidden="true">⌕</span>
                <input type="search" id="searchBox" placeholder="<%= t('themeActivities.searchPlaceholder') %>" autocomplete="off" aria-describedby="themeSearchStatus">
            </div>
            <p id="themeSearchStatus" class="theme-search-status" role="status"></p>
            <%# Message templates live in text (not data-* attributes) so the 繁体 converter in services/zhHant.js reaches them. %>
            <div id="themeSearchMessages" hidden>
                <span data-msg="all"><%= t('themeActivities.resultsAll') %></span>
                <span data-msg="for"><%= t('themeActivities.resultsFor') %></span>
                <span data-msg="none"><%= t('themeActivities.noResults') %></span>
            </div>
            <button id="clearThemeSearch" class="btn" type="button" hidden><%= t('themeActivities.clearSearch') %></button>
        </section>

        <nav class="theme-jump" aria-label="<%= lang === 'zh' ? '主题分类' : 'Theme categories' %>">
            <% categories.forEach(function(category) { %>
            <a href="#<%= category.key %>"><%= category[lang] %></a>
            <% }); %>
        </nav>

        <% var groups = otherThemes.length ? categories.concat({ key: 'other-themes', en: 'Other Themes', zh: '其他主题', themes: otherThemes }) : categories;
        groups.forEach(function(category) { %>
        <section class="theme-group" id="<%= category.key %>" aria-labelledby="<%= category.key %>-heading">
            <h2 id="<%= category.key %>-heading"><%= category[lang] %></h2>
            <div class="tools-grid">
                <% category.themes.forEach(function(theme) { %>
                <div class="tool-card" data-fav-ref="<%= theme.key %>" data-fav-kind="theme" data-tags="<%= category.en %> <%= category.zh %> <%= theme.key %> <%= theme.en %> <%= theme.zh %> <%= theme.tags || '' %>">
                    <h3><%= theme.icon ? theme.icon + ' ' : '' %><%= theme[lang] %></h3>
                    <p><%= lang === 'zh' ? (theme.descZh || '主题课堂活动与可打印材料。') : (theme.descEn || 'Themed classroom activities and printable materials.') %></p>
                    <a href="<%= theme.href %>" class="btn"><%= t('themeActivities.openTheme') %></a>
                </div>
                <% }); %>
                <% if (category.key === 'festivals-culture' && showMidAutumnLesson) { %>
                <div class="tool-card" data-tags="festivals culture holidays mid autumn 中秋节 节日 文化">
                    <h3>🥮 <%= t('themeActivities.midAutumnTitle') %></h3>
                    <p><%= t('themeActivities.midAutumnDesc') %></p>
                    <a href="/resources/teaching-mid-autumn-festival-grade-one" class="btn"><%= t('themeActivities.readLesson') %></a>
                </div>
                <% } %>
            </div>
        </section>
        <% }); %>

        <section class="theme-group" aria-labelledby="theme-guide-heading">
            <h2 id="theme-guide-heading"><%= lang === 'zh' ? '通用活动指南' : 'General Activity Guide' %></h2>
            <div class="tools-grid">
                <div class="tool-card" data-tags="games vocabulary classroom 中文 游戏 词汇">
                    <h3>🎲 <%= t('themeActivities.gameIdeasTitle') %></h3>
                    <p><%= t('themeActivities.gameIdeasDesc') %></p>
                    <a href="/resources/ten-games-for-chinese-beginners" class="btn"><%= t('themeActivities.readGameGuide') %></a>
                </div>
            </div>
        </section>
    </main>

    <script>
        (function () {
            var search = document.getElementById('searchBox');
            var groups = document.querySelectorAll('.theme-group');
            var status = document.getElementById('themeSearchStatus');
            var clearSearch = document.getElementById('clearThemeSearch');

            var messages = {};
            document.querySelectorAll('#themeSearchMessages [data-msg]').forEach(function(el) { messages[el.dataset.msg] = el.textContent; });

            function fill(template, count, query) {
                return template.replace('{count}', count).replace('{query}', query);
            }

            function filterThemes() {
                var raw = search.value.trim();
                var query = raw.toLowerCase();
                var total = 0;
                groups.forEach(function(group) {
                    group.querySelectorAll('.tool-card').forEach(function(card) {
                        card.hidden = !(card.dataset.tags + ' ' + card.textContent).toLowerCase().includes(query);
                        if (!card.hidden) total += 1;
                    });
                    group.hidden = Boolean(query) && !group.querySelector('.tool-card:not([hidden])');
                    // Hide the category chip too, so it never points at an empty section.
                    if (group.id) {
                        var chip = document.querySelector('.theme-jump a[href="#' + group.id + '"]');
                        if (chip) chip.hidden = group.hidden;
                    }
                });
                status.textContent = !query ? fill(messages.all, total, '')
                    : total ? fill(messages.for, total, raw) : fill(messages.none, 0, raw);
                status.classList.toggle('is-empty', Boolean(query) && !total);
                clearSearch.hidden = !query || total > 0;
            }

            clearSearch.addEventListener('click', function() {
                search.value = '';
                filterThemes();
                search.focus();
            });
            search.addEventListener('input', filterThemes);
            filterThemes();
            document.addEventListener('click', function(event) {
                var link = event.target.closest('.theme-jump a, .site-tool-categories a');
                if (link && link.pathname.replace(/\/$/, '') === '/theme-activities' && search.value) {
                    search.value = '';
                    filterThemes();
                }
            });
        })();
    </script>
    <script src="/shared/tool-favorites.js?v=2"></script>
    <script>window.ChenFavorites.attachStars(document); window.ChenFavorites.load();</script>
    <script src="/javascripts/account-coming-soon.js"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
