<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Theme Activities - Teacher Toolkit</title>
    <%- include('../partials/seo', { pageDescription: 'Browse Chinese language lessons, games, songs, and classroom-ready activities by theme.' }) %>

    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f8f9fa;
            color: #333;
            line-height: 1.6;
        }

        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 40px 20px;
            text-align: center;
        }

        .header h1 {
            margin-bottom: 10px;
        }

        .back-btn {
            position: absolute;
            top: 20px;
            left: 20px;
            background-color: rgba(255, 255, 255, 0.2);
            border: 1px solid white;
            color: white;
            padding: 10px 15px;
            text-decoration: none;
            border-radius: 5px;
        }

        /* 🔍 SEARCH BOX */
        .search-container {
            text-align: center;
            margin: 20px;
        }

        #searchBox {
            width: 80%;
            max-width: 500px;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #ccc;
            font-size: 16px;
        }

        .theme-directory {
            margin: 0 auto;
            max-width: 1240px;
            padding: 0 20px 40px;
        }

        .theme-jump { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 28px; }
        .theme-jump a {
            padding: 8px 14px;
            border: 1px solid #cbdac2;
            border-radius: 22px;
            color: #194f45;
            font-weight: 700;
            text-decoration: none;
        }

        .theme-jump a:hover { background: #edf5df; }
        .theme-group { margin: 0 0 32px; scroll-margin-top: 24px; }
        .theme-group h2 { margin: 0 0 14px; color: #194f45; }
        .theme-group[hidden], .tool-card[hidden] { display: none; }

        .tools-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 20px;
        }

        .tool-card {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            text-align: center;
            transition: transform 0.3s;
        }

        .tool-card:hover {
            transform: translateY(-5px);
        }

        .tool-card:has(.btn:disabled) {
            background: #f3f4f6;
            box-shadow: none;
            opacity: 0.68;
        }

        .tool-card:has(.btn:disabled):hover {
            transform: none;
        }

        .tool-card h3 {
            color: #667eea;
            margin-bottom: 10px;
        }

        .tool-card p {
            margin-bottom: 15px;
            font-size: 14px;
        }

        .btn {
            background-color: #667eea;
            color: white;
            padding: 10px 18px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
            font-size: 14px;
        }

        .btn:hover {
            background-color: #5a67d8;
        }

        .btn:disabled {
            background-color: #aab1bf;
            color: #f8fafc;
            cursor: not-allowed;
        }

        @media (max-width: 768px) {
            .tools-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <link rel="stylesheet" href="/stylesheets/site-theme.css">
</head>

<body>

    <a href="/" class="back-btn">← <%= t('themeActivities.backToHomepage') %></a>

    <section class="header">
        <h1><%= t('themeActivities.title') %></h1>
        <p><%= t('themeActivities.intro') %></p>
    </section>

    <div class="search-container">
        <input type="search" id="searchBox" aria-label="<%= t('themeActivities.searchPlaceholder') %>"
            placeholder="🔍 <%= t('themeActivities.searchPlaceholder') %>">
    </div>

    <main class="theme-directory">
        <nav class="theme-jump" aria-label="<%= lang === 'zh' ? '主题分类' : 'Theme categories' %>">
            <% categories.forEach(function(category) { %>
            <a href="#<%= category.key %>"><%= category[lang] %></a>
            <% }); %>
        </nav>

        <% var groups = otherThemes.length ? categories.concat({ key: 'other-themes', en: 'Other Themes', zh: '其他主题', themes: otherThemes }) : categories;
        groups.forEach(function(category) { %>
        <section class="theme-group" id="<%= category.key %>" aria-labelledby="<%= category.key %>-heading">
            <h2 id="<%= category.key %>-heading"><%= category[lang] %></h2>
            <div class="tools-grid">
                <% category.themes.forEach(function(theme) { %>
                <div class="tool-card" data-tags="<%= category.en %> <%= category.zh %> <%= theme.key %> <%= theme.en %> <%= theme.zh %> <%= theme.tags || '' %>">
                    <h3><%= theme.icon ? theme.icon + ' ' : '' %><%= theme[lang] %></h3>
                    <p><%= lang === 'zh' ? (theme.descZh || '主题课堂活动与可打印材料。') : (theme.descEn || 'Themed classroom activities and printable materials.') %></p>
                    <a href="<%= theme.href %>" class="btn"><%= t('themeActivities.openTheme') %></a>
                </div>
                <% }); %>
                <% if (category.key === 'festivals-culture' && showMidAutumnLesson) { %>
                <div class="tool-card" data-tags="festivals culture holidays mid autumn 中秋节 节日 文化">
                    <h3>🥮 <%= t('themeActivities.midAutumnTitle') %></h3>
                    <p><%= t('themeActivities.midAutumnDesc') %></p>
                    <a href="/resources/teaching-mid-autumn-festival-grade-one" class="btn"><%= t('themeActivities.readLesson') %></a>
                </div>
                <% } %>
            </div>
        </section>
        <% }); %>

        <section class="theme-group" aria-labelledby="theme-guide-heading">
            <h2 id="theme-guide-heading"><%= lang === 'zh' ? '通用活动指南' : 'General Activity Guide' %></h2>
            <div class="tools-grid">
                <div class="tool-card" data-tags="games vocabulary classroom 中文 游戏 词汇">
                    <h3>🎲 <%= t('themeActivities.gameIdeasTitle') %></h3>
                    <p><%= t('themeActivities.gameIdeasDesc') %></p>
                    <a href="/resources/ten-games-for-chinese-beginners" class="btn"><%= t('themeActivities.readGameGuide') %></a>
                </div>
            </div>
        </section>
    </main>

    <script>
        (function () {
            var search = document.getElementById('searchBox');
            var groups = document.querySelectorAll('.theme-group');

            function filterThemes() {
                var query = search.value.trim().toLowerCase();
                groups.forEach(function(group) {
                    group.querySelectorAll('.tool-card').forEach(function(card) {
                        card.hidden = !(card.dataset.tags + ' ' + card.textContent).toLowerCase().includes(query);
                    });
                    group.hidden = Boolean(query) && !group.querySelector('.tool-card:not([hidden])');
                });
            }

            search.addEventListener('input', filterThemes);
            document.addEventListener('click', function(event) {
                var link = event.target.closest('.theme-jump a, .site-tool-categories a');
                if (link && link.pathname.replace(/\/$/, '') === '/theme-activities' && search.value) {
                    search.value = '';
                    filterThemes();
                }
            });
        })();
    </script>
    <script src="/javascripts/account-coming-soon.js"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
