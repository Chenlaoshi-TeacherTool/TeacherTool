  <title>关于陈老师与本站 - 陈老师中文教学工具</title>
  <%- include('partials/seo', { pageDescription: '认识陈老师中文教学工具：一个为中文教师、家长与学习者整理课堂活动、实用生成器和教学方法的网站。' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css"><link rel="stylesheet" href="/stylesheets/content-pages.css">
