  <title>About Chen Laoshi and This Site - Chen Laoshi's Teaching Toolkit</title>
  <%- include('partials/seo', { pageDescription: 'Meet Chen Laoshi and learn how this site supports teachers across subjects with practical classroom tools, activities, and thoughtful teaching guidance.' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css"><link rel="stylesheet" href="/stylesheets/content-pages.css">
