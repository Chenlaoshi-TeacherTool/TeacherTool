<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#194f45">
  <title><%= status === 404 ? 'Page not found' : 'Website error' %> - Chen Laoshi's Teaching Toolkit</title>
  <%- include('partials/seo', { pageDescription: 'This page is not available. Return to Chen Laoshi’s published teaching resources and classroom tools.', noindex: true }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/stylesheets/content-pages.css">
</head>
<body>
  <main class="content-hero" style="min-height:66vh; display:grid; align-items:center;">
    <div class="content-shell">
      <p class="content-kicker"><%= status === 404 ? '404 · Page not found' : 'Something went wrong' %></p>
      <h1><%= status === 404 ? 'This resource could not be found.' : 'The site ran into a problem.' %></h1>
      <p><%= status === 404 ? 'The address may have changed, or the resource may not be published yet. Continue from the homepage, teaching resources, or tool directory.' : 'Please try again shortly. If the problem continues, send the page address to Chen Laoshi.' %></p>
      <div class="content-actions">
        <a class="btn" href="/">Return home</a>
        <a class="text-link" href="/resources">View teaching resources</a>
        <a class="text-link" href="/contact">Contact Chen Laoshi</a>
      </div>
    </div>
  </main>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
