<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="theme-color" content="#194f45">
  <title><%= t('community.pageTitle') %> - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'Teaching resources, competitions and websites shared by Chinese teachers. Search by category, learner, grade and textbook.' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css"><link rel="stylesheet" href="/stylesheets/content-pages.css">
  <link rel="stylesheet" href="/community/community.css?v=grant1">
</head>
<body class="community-page">
<%
  function link(change) {
    var params = { q: result.q, kind: result.kind, stage: result.stage, textbook: result.textbook, page: '' };
    Object.keys(change).forEach(function (key) { params[key] = change[key]; });
    var query = Object.keys(params).filter(function (key) { return params[key]; })
      .map(function (key) { return encodeURIComponent(key) + '=' + encodeURIComponent(params[key]); }).join('&');
    return '/community' + (query ? '?' + query : '');
  }
  var filtered = result.q || result.kind || result.stage || result.textbook;
%>
  <header class="content-hero community-hero"><div class="content-shell">
    <p class="content-kicker"><%= t('community.kicker') %></p>
    <h1><%= t('community.title') %></h1>
    <p><%= t('community.intro') %></p>
    <a class="btn community-share-cta" href="/community/share"><%= t('community.shareCta') %></a>
    <a class="btn btn-secondary community-share-cta" href="/community/websites/new"><%= lang === 'zh' ? '分享教学网站' : 'Share a website' %></a>
    <a class="btn btn-secondary community-share-cta" href="/community/websites/mine"><%= lang === 'zh' ? '我的网站投稿' : 'My submissions' %></a>
  </div></header>

  <main class="content-section community-main"><div class="content-shell">
    <form class="community-search" method="get" action="/community" role="search">
      <label class="visually-hidden" for="communityQ"><%= t('community.searchLabel') %></label>
      <input id="communityQ" name="q" type="search" maxlength="60" value="<%= result.q %>" placeholder="<%= t('community.searchPlaceholder') %>">
      <% ['kind', 'stage', 'textbook'].forEach(function (key) { if (result[key]) { %><input type="hidden" name="<%= key %>" value="<%= result[key] %>"><% } }) %>
      <button class="btn" type="submit"><%= t('community.searchButton') %></button>
    </form>

    <div class="community-filters">
      <div class="community-filter-row"><span class="community-filter-label"><%= t('community.filterType') %></span>
        <a class="chip<%= !result.kind ? ' is-on' : '' %>" href="<%- link({ kind: '' }) %>"><%= t('community.all') %></a>
        <% ['game', 'wordlist', 'website', 'contest', 'grant'].forEach(function(kind) { %>
        <a class="chip community-kind kind-<%= kind %><%= result.kind === kind ? ' is-on' : '' %>" href="<%- link({ kind: kind }) %>" <%- result.kind === kind ? 'aria-current="true"' : '' %>><%= community.kindLabel(kind, lang) %></a>
        <% }); %>
      </div>
      <div class="community-filter-row"><span class="community-filter-label"><%= t('community.filterStage') %></span>
        <a class="chip<%= !result.stage ? ' is-on' : '' %>" href="<%- link({ stage: '' }) %>"><%= t('community.all') %></a>
        <% community.STAGES.forEach(function (stage) { %>
          <a class="chip<%= result.stage === stage.key ? ' is-on' : '' %>" href="<%- link({ stage: stage.key }) %>"><%= stageLabel(stage.key) %></a>
        <% }) %>
      </div>
      <div class="community-filter-row"><span class="community-filter-label"><%= t('community.filterTextbook') %></span>
        <a class="chip<%= !result.textbook ? ' is-on' : '' %>" href="<%- link({ textbook: '' }) %>"><%= t('community.all') %></a>
        <% community.TEXTBOOKS.forEach(function (book) { %>
          <a class="chip<%= result.textbook === book.key ? ' is-on' : '' %>" href="<%- link({ textbook: book.key }) %>"><%= textbookLabel(book.key) %></a>
        <% }) %>
      </div>
    </div>

    <div class="community-list-head">
      <h2><%= filtered ? t('community.results') : t('community.latest') %></h2>
      <span><%= result.total %> <%= t('community.postsCount') %></span>
      <% if (filtered) { %><a href="/community"><%= t('community.clearFilters') %></a><% } %>
    </div>

    <% if (resourcesUnavailable) { %><p role="status" class="hint"><%= lang === 'zh' ? '教学网站暂时无法加载，请稍后重试。' : 'Teaching websites are temporarily unavailable.' %></p><% } %>
    <% if (!result.kind || result.kind === 'website') { %><p class="hint community-external-note"><%= lang === 'zh' ? '教学网站由第三方独立运营，与 CLS Teaching Tools 无隶属关系；付费推广、佣金或其他利益关系会在相应推荐中披露。' : 'Teaching websites are independently operated and are not affiliated with CLS Teaching Tools. Paid promotion, commissions or other interests are disclosed in each recommendation.' %></p><% } %>
    <% if (result.unavailable && !result.posts.length) { %>
      <p class="community-empty"><%= t('community.unavailable') %></p>
    <% } else if (!result.posts.length) { %>
      <div class="community-empty">
        <p><%= filtered ? t('community.noMatches') : t('community.noPosts') %></p>
        <a class="btn" href="/community/share"><%= t('community.shareFirst') %></a>
      </div>
    <% } else { %>
      <ul class="community-grid">
        <% result.posts.forEach(function (post) { var game = post.kind === 'game' ? community.GAME_TYPES[post.gameType] : null; %>
        <li class="community-card kind-<%= post.kind %>">
          <% if (post.resource) { var item = post.resource; %>
          <article class="resource-card">
            <span class="community-card-type"><%= community.kindLabel('website', lang) %></span>
            <div class="resource-disclosures"><% promotionBadges(item).forEach(function(badge) { %><span class="resource-disclosure<%= badge.commercial ? ' is-commercial' : '' %>"><%= badge.text %></span><% }); %></div>
            <h3><%= item.name %></h3>
            <% if (item.source === 'teacher') { %><p class="hint"><%= lang === 'zh' ? '老师投稿 · ' : 'Teacher submission · ' %><%= item.authorName %></p><% } %><p class="community-card-desc"><%= item.summary %></p>
            <p class="community-tags"><span class="community-tag"><%= item.category %></span></p>
            <p class="hint"><%= new URL(item.url).hostname %> · <%= lang === 'zh' ? '第三方网站' : 'Third-party website' %></p>
            <button type="button" class="btn btn-secondary" data-resource-open="resource-<%= item.id %>"><%= lang === 'zh' ? '查看介绍' : 'Read introduction' %> →</button>
          </article>
          <% } else { %>
          <a href="/community/<%= post.id %>">
            <span class="community-card-type">
              <span aria-hidden="true"><%= game ? game.icon : post.kind === 'contest' ? '🏆' : post.kind === 'website' ? '🌐' : post.kind === 'grant' ? '💰' : '📝' %></span>
              <%= community.kindLabel(post.kind, lang) %>
            </span>
            <h3><%= post.title %></h3>
            <% if (post.description) { %><p class="community-card-desc"><%= post.description %></p><% } %>
            <% if (post.kind === 'contest' && post.payload && post.payload.deadline) { %><p class="hint"><%= t('community.deadline') %>: <%= post.payload.deadline %> <% if (post.payload.deadline < new Date().toLocaleDateString('en-CA', { timeZone: 'America/Los_Angeles' })) { %><span class="community-tag"><%= t('community.closed') %></span><% } %></p><% } %>
            <% if (post.kind === 'grant' && post.payload) { %><p class="hint"><% if (post.payload.amount) { %><strong><%= post.payload.amount %></strong> · <% } %><%= t('community.grantDeadlineLabel') %>: <%= post.payload.deadline || t('community.grantRolling') %> <% if (community.isClosed(post)) { %><span class="community-tag"><%= t('community.grantClosed') %></span><% } %></p><% if (post.payload.funder) { %><p class="hint"><%= post.payload.funder %></p><% } %><% } %>
            <p class="community-tags">
              <% post.stages.forEach(function (key) { %><span class="community-tag"><%= stageLabel(key) %></span><% }) %>
              <% if (post.textbook) { %><span class="community-tag is-book"><%= textbookLabel(post.textbook) %></span><% } %>
            </p>
            <p class="community-card-foot">
              <span>👩‍🏫 <%= post.authorName %></span>
              <span><% if (community.EXTERNAL_KINDS.includes(post.kind)) { %><%= t('community.externalLink') %><% } else { %><%= post.itemCount %> <%= post.kind === 'game' ? t('community.itemsUnit') : t('community.wordsUnit') %><% if (post.useCount) { %> · <%= post.useCount %> <%= t('community.usesUnit') %><% } %><% } %></span>
            </p>
          </a>
          <% } %>
        </li>
        <% }) %>
      </ul>
      <% if (result.pages > 1) { %>
      <nav class="community-pages" aria-label="<%= t('community.pagesLabel') %>">
        <% if (result.page > 1) { %><a href="<%- link({ page: result.page - 1 }) %>">← <%= t('community.prev') %></a><% } %>
        <span><%= result.page %> / <%= result.pages %></span>
        <% if (result.page < result.pages) { %><a href="<%- link({ page: result.page + 1 }) %>"><%= t('community.next') %> →</a><% } %>
      </nav>
      <% } %>
    <% } %>
    <%- include('teacher-resources') %>
  </div></main>
  <script src="/javascripts/milk-tea-footer.js"></script>
  <script src="/community/teacher-resources.js"></script>
</body>
</html>
