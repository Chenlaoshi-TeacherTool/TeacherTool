<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#194f45">
  <title>Classroom Finds - Chen Laoshi's Teaching Toolkit</title>
  <%- include('partials/seo', { pageDescription: 'Classroom supplies recommended by Chen Laoshi with practical use cases, honest selection reasons, and clear affiliate disclosures.' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/stylesheets/content-pages.css">
</head>
<body>
  <header class="content-hero">
    <div class="content-shell">
      <p class="content-kicker"><%= t('recommendations.kicker') %></p>
      <h1><%= t('recommendations.title') %></h1>
      <p><%= t('recommendations.intro') %></p>
    </div>
  </header>

  <main>
    <section class="content-section">
      <div class="content-shell">
        <div class="recommendation-feature">
          <div>
            <p class="content-kicker"><%= t('recommendations.listKicker') %></p>
            <h2><%= t('recommendations.listTitle') %></h2>
            <p><%= t('recommendations.listIntro') %></p>
            <ul>
              <li><strong><%= t('recommendations.item1Strong') %></strong> <%= t('recommendations.item1Text') %></li>
              <li><strong><%= t('recommendations.item2Strong') %></strong> <%= t('recommendations.item2Text') %></li>
              <li><strong><%= t('recommendations.item3Strong') %></strong> <%= t('recommendations.item3Text') %></li>
            </ul>
          </div>
          <aside class="affiliate-note">
            <h2><%= t('recommendations.affiliateTitle') %></h2>
            <p><%= t('recommendations.affiliateP1') %></p>
            <p><%= t('recommendations.affiliateP2') %></p>
          </aside>
        </div>

        <% if (products && products.length) { %>
          <% products.forEach(function (product) { %>
        <article class="recommendation-product" aria-labelledby="product-<%= product.slug %>-title">
          <% if (product.productUrl || product.imageUrl) { %>
          <a class="recommendation-product__image" href="<%= product.productUrl || product.imageUrl %>" target="_blank" rel="sponsored nofollow noopener noreferrer" aria-label="<%= product.title %>">
            <% if (product.imageUrl) { %><img src="<%= product.imageUrl %>" alt="<%= product.imageAlt || product.title %>" loading="lazy"><% } %>
          </a>
          <% } %>

          <div class="recommendation-product__copy">
            <% if (product.category) { %><p class="product-number"><%= product.category %></p><% } %>
            <h2 id="product-<%= product.slug %>-title"><%= product.title %></h2>
            <% if (product.subtitle) { %><p class="product-subtitle"><%= product.subtitle %></p><% } %>
            <% if (product.description) { %><p><%= product.description %></p><% } %>

            <% if (product.reasons && product.reasons.length) { %>
            <h3><%= t('recommendations.product1WhyTitle') %></h3>
            <div class="product-reasons">
              <% product.reasons.forEach(function (reason) { %>
              <section><strong><%= reason.title %></strong><p><%= reason.text %></p></section>
              <% }) %>
            </div>
            <% } %>

            <% if (product.teacherTip || product.teacherTipTitle) { %>
            <div class="product-teacher-tip"><strong><%= product.teacherTipTitle || t('recommendations.product1TipStrong') %></strong><span> <%= product.teacherTip || '' %></span></div>
            <% } %>

            <% if (product.printableLabelUrl) { %>
            <div class="product-printable-label">
              <a href="<%= product.printableLabelUrl %>"><%= product.printableLabelText || 'Download printable labels' %></a>
              <% if (product.printableLabelNote) { %><p><%= product.printableLabelNote %></p><% } %>
            </div>
            <% } %>

            <% if (product.productUrl) { %>
            <a class="btn product-link" href="<%= product.productUrl %>" target="_blank" rel="sponsored nofollow noopener noreferrer"><%= product.linkText || 'View product →' %></a>
            <% } %>
            <% if (product.linkNote) { %><p class="product-link-note"><%= product.linkNote %></p><% } %>
          </div>
        </article>
          <% }) %>
        <% } else { %>
        <article class="recommendation-product" aria-labelledby="rolling-cart-title">
          <a class="recommendation-product__image" href="https://amzn.to/4qpPByl" target="_blank" rel="sponsored nofollow noopener noreferrer" aria-label="View the 15-drawer classroom rolling cart on Amazon">
            <img src="/images/15-drawer-rolling-cart.png" alt="Classroom rolling cart with fifteen colorful drawers, a top work surface, and wheels" loading="lazy">
          </a>

          <div class="recommendation-product__copy">
            <p class="product-number"><%= t('recommendations.product1Meta') %></p>
            <h2 id="rolling-cart-title"><%= t('recommendations.product1Title') %></h2>
            <p class="product-subtitle"><%= t('recommendations.product1Subtitle') %></p>
            <p><%= t('recommendations.product1Desc') %></p>

            <h3><%= t('recommendations.product1WhyTitle') %></h3>
            <div class="product-reasons">
              <section><strong><%= t('recommendations.product1Reason1Strong') %></strong><p><%= t('recommendations.product1Reason1Text') %></p></section>
              <section><strong><%= t('recommendations.product1Reason2Strong') %></strong><p><%= t('recommendations.product1Reason2Text') %></p></section>
              <section><strong><%= t('recommendations.product1Reason3Strong') %></strong><p><%= t('recommendations.product1Reason3Text') %></p></section>
            </div>

            <div class="product-teacher-tip"><strong><%= t('recommendations.product1TipStrong') %></strong><span> <%= t('recommendations.product1TipText') %></span></div>

            <a class="btn product-link" href="https://amzn.to/4qpPByl" target="_blank" rel="sponsored nofollow noopener noreferrer"><%= t('recommendations.product1LinkText') %></a>
            <p class="product-link-note"><%= t('recommendations.product1LinkNote') %></p>
          </div>
        </article>
        <% } %>
      </div>
    </section>

    <section class="content-section content-section--soft">
      <div class="content-shell">
        <p class="content-kicker"><%= t('recommendations.askKicker') %></p>
        <div class="question-grid">
          <article><h2><%= t('recommendations.q1Title') %></h2><p><%= t('recommendations.q1Text') %></p></article>
          <article><h2><%= t('recommendations.q2Title') %></h2><p><%= t('recommendations.q2Text') %></p></article>
          <article><h2><%= t('recommendations.q3Title') %></h2><p><%= t('recommendations.q3Text') %></p></article>
        </div>
      </div>
    </section>
  </main>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
