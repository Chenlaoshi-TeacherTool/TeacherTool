<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: page.intro }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <% if (page.themeKey) { %><link rel="stylesheet" href="/stylesheets/theme-detail.css"><% } %>
</head>
<body<% if (page.themeKey) { %> class="theme-detail"<% } %>>
  <header class="<%= page.themeKey ? 'header' : 'content-hero' %>">
    <div class="content-shell">
      <% if (page.parent) { %><a class="<%= page.themeKey ? 'back-btn' : 'text-link' %>" href="<%= page.parent.href %>">← <%= page.parent.label %></a><% } %>
      <h1><% if (page.themeIcon) { %><span aria-hidden="true"><%= page.themeIcon %></span> <% } %><%= page.heading %></h1>
      <% if (page.themeKey) { %><%- include('../partials/theme-favorite', { themeKey: page.themeKey }) %><% } %>
      <p><%= page.intro %></p>
    </div>
  </header>
  <main class="content-section">
    <div class="content-shell resource-grid">
      <% page.cards.forEach(function(card) { %>
      <section class="resource-card<%= page.themeKey ? ' tool-card' : '' %><%= card.comingSoon ? ' is-coming-soon' : '' %>">
        <% if (card.comingSoon) { %><p class="resource-card__soon"><%= card.comingSoon %></p><% } %>
        <h2><%= card.heading %></h2>
        <p><%= card.description %></p>
        <% if (card.href && !card.comingSoon) { %><a class="<%= page.themeKey ? 'btn' : 'resource-card__link' %>" href="<%= card.href %>"><%= card.label %> →</a><% } %>
      </section>
      <% }) %>
    </div>
  </main>
  <%- include('../materials/theme-section') %>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
