<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: page.intro }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
</head>
<body>
  <header class="content-hero">
    <div class="content-shell">
      <% if (page.parent) { %><a class="text-link" href="<%= page.parent.href %>">← <%= page.parent.label %></a><% } %>
      <h1><%= page.heading %></h1>
      <p><%= page.intro %></p>
    </div>
  </header>
  <main class="content-section">
    <div class="content-shell resource-grid">
      <% page.cards.forEach(function(card) { %>
      <section class="resource-card">
        <h2><%= card.heading %></h2>
        <p><%= card.description %></p>
        <% if (card.href) { %><a class="resource-card__link" href="<%= card.href %>"><%= card.label %> →</a><% } %>
      </section>
      <% }) %>
    </div>
  </main>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
