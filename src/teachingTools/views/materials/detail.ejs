<!DOCTYPE html>
<html lang="<%= lang %>">
<% var L = function (en, zh) { return lang === 'zh' ? zh : en; }; %>
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: item.descriptionEn || item.description }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
</head>
<body>
  <header class="content-hero"><div class="content-shell">
    <a class="text-link" href="/theme-activities/<%= item.theme %>">← <%= L('Theme activities', '主题活动') %></a>
    <h1><%= item.title %></h1>
    <% if (item.limitedFree) { %><span class="printable-badge printable-badge--inline"><%= L('Free for a limited time', '限时免费') %></span><% } %>
    <% if (canEdit) { %><p><a class="text-link" href="/materials/<%= item.id %>/edit"><%= L('Edit material and textbook links', '编辑材料与教材关联') %></a></p><% } %>
  </div></header>
  <main class="content-section"><div class="content-shell">
    <% var videoIndex = item.files.findIndex(function (file) { return !file.url && /^video\//.test(file.contentType || ''); }); %>
    <% if (videoIndex >= 0) { %>
    <video controls playsinline preload="metadata"<% if (item.preview) { %> poster="/materials/<%= item.id %>/preview"<% } %> src="/materials/<%= item.id %>/files/<%= videoIndex %>?play=1" style="display:block;width:100%;max-width:960px;max-height:70vh;margin:auto;background:#000;border-radius:12px"></video>
    <% } else if (item.preview) { %><img src="/materials/<%= item.id %>/preview" alt="<%= item.title %>" style="display:block;max-width:100%;max-height:560px;margin:auto"><% } %>
    <p style="white-space:pre-wrap"><%= L(item.descriptionEn || item.description, item.description) %></p>
    <h2><%= L('Download attachments', '下载附件') %></h2>
    <ul><% item.files.forEach(function (file, index) { %>
      <li><a class="resource-card__link" href="/materials/<%= item.id %>/files/<%= index %>"><%= file.name %></a></li>
    <% }) %></ul>
    <% if (item.lessons.length) { %>
    <h2><%= L('Applicable textbooks', '适用教材') %></h2>
    <ul><% item.lessons.forEach(function (lesson) { var series = textbooks.findSeries(lesson.series); var book = textbooks.findBook(series, lesson.book); %>
      <li><a class="resource-card__link" href="/textbook-companion/<%= lesson.series %>/<%= lesson.book %>/<%= lesson.slug %>"><%= series ? L(series.en, series.zh) : lesson.series %> · <%= book ? L(book.en, book.zh) : lesson.book %> · <%= L('Lesson ' + lesson.lessonNo, '第' + lesson.lessonNo + '课') %>《<%= lesson.title %>》</a></li>
    <% }) %></ul>
    <% } %>
  </div></main>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
