<!DOCTYPE html>
<html lang="<%= lang %>"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<% var zh = lang === 'zh'; function copy(c,e) { return zh ? c : e; } %>
<title><%= copy('词汇扭蛋机','Vocabulary Gacha') %> · CLS Teaching Tools</title>
<%- include('../partials/seo', { pageDescription: 'Play vocabulary gacha as a class or two teams. Import word lists and choose fixed or random points.' }) %>
<link rel="stylesheet" href="/stylesheets/site-theme.css"><link rel="stylesheet" href="/shared/library-picker.css"><link rel="stylesheet" href="/teaching-tools/vocabulary-gacha/gacha.css">
<script defer src="/shared/wordlist-core.js"></script><script defer src="/shared/wordlist-handoff.js"></script><script defer src="/shared/library-picker.js"></script><script defer src="/shared/library-v2.js"></script><script defer src="/shared/library-store.js"></script><script defer src="/teaching-tools/vocabulary-gacha/gacha-core.js"></script><script defer src="/teaching-tools/vocabulary-gacha/gacha.js"></script></head>
<body class="gacha-page"><main id="gacha">
<nav><a href="/teaching-tools"><%= copy('← 教学工具','← Teaching Tools') %></a><button id="fullscreen"><%= copy('全屏','Fullscreen') %></button></nav>
<header><p class="eyebrow">CLS · VOCABULARY ARCADE</p><h1><%= copy('词汇扭蛋机','Vocabulary Gacha') %> <span>✦</span></h1><p><%= copy('转一转，打开今天的词汇惊喜。','Turn the handle. Unwrap a word. Let’s play.') %></p></header>
<section id="setup" class="panel">
<div class="setup-grid"><div><h2><%= copy('01 准备词汇','01 Your vocabulary') %></h2><label for="words"><%= copy('每行一个词；拼音和英文用 Tab 或 | 分隔。','One word per line; separate pinyin and English with Tab or |.') %></label><textarea id="words" rows="8" placeholder="苹果 | píng guǒ | apple&#10;香蕉 | xiāng jiāo | banana"></textarea><p id="count"></p><button id="generate"><%= copy('自动生成拼音和英文','Generate pinyin and English') %></button><p id="generate-status" role="status"></p>
<div id="gachaLibraryPicker"></div><p id="import-status" role="status"></p><details id="library"><summary><%= copy('＋ 从本机个人资料导入','＋ Import personal lists from this browser') %></summary><p><%= copy('选择词表，预览后合并到上方编辑区。','Select lists, preview, then merge into the editor above.') %></p><button id="refresh"><%= copy('加载／刷新词表','Load / refresh lists') %></button><div id="lists"></div><p id="library-status" role="status"></p><pre id="preview"></pre><button id="import" disabled><%= copy('合并导入','Import and merge') %></button></details></div>
<div><h2><%= copy('02 选择玩法','02 Make it your game') %></h2><label for="mode"><%= copy('游戏模式','Game mode') %></label><select id="mode"><option value="class"><%= copy('全班一起玩','Whole class') %></option><option value="teams"><%= copy('两组比赛','Two teams') %></option></select>
<div id="team-names" hidden><label><%= copy('A 组名称','Team A name') %><input id="name-a" maxlength="30" value="<%= copy('A 组','Team A') %>"></label><label><%= copy('B 组名称','Team B name') %><input id="name-b" maxlength="30" value="<%= copy('B 组','Team B') %>"></label></div>
<label class="check"><input type="checkbox" id="random"><%= copy('随机积分（5 / 10 / 15 / 20 分）','Surprise points (5 / 10 / 15 / 20)') %></label><label id="fixed-label"><%= copy('每题固定积分','Fixed points per word') %><input id="fixed" type="number" min="1" max="100" value="10"></label>
<label for="ending"><%= copy('结束方式','End game when') %></label><select id="ending"><option value="cards"><%= copy('全部词卡答完','All word cards are answered') %></option><option value="manual"><%= copy('老师手动结束','Teacher ends the game') %></option><option value="timer"><%= copy('倒计时结束','Timer runs out') %></option></select><label id="duration-label" hidden><%= copy('游戏时长（分钟，1–60）','Duration (minutes, 1–60)') %><input id="duration" type="number" min="1" max="60" value="5"></label><p id="ending-hint"><%= copy('共用词池，每轮不重复；手动和计时模式抽完会重新洗牌。','Shared pool, no repeats within a cycle. Manual and timed games reshuffle when the pool runs out.') %></p>
<label class="check"><input type="checkbox" id="show-py"><%= copy('默认显示拼音','Show pinyin on reveal') %></label><label class="check"><input type="checkbox" id="show-en"><%= copy('默认显示英文','Show English on reveal') %></label>
<p><%= copy('共用词池，不重复抽取。双组轮流作答，由老师判分。','One shared pool, no repeats. Teams alternate; the teacher awards points.') %></p><button id="start" class="primary"><%= copy('开始扭蛋 →','Let’s play →') %></button><p id="error" role="alert"></p></div></div></section>
<section id="play" hidden><div class="toolbar"><button id="settings"><%= copy('返回设置','Back to settings') %></button><p id="remaining" aria-live="polite"></p><p id="timer" hidden role="timer"></p><button id="end-game"><%= copy('结束游戏','End game') %></button><button id="undo" disabled><%= copy('撤销上一轮','Undo last round') %></button></div><p id="turn" class="turn" role="status"></p><div id="machines"></div>
<dialog id="reveal" class="panel" aria-labelledby="term" aria-describedby="points"><p id="points" class="eyebrow"></p><h2 id="term" tabindex="-1"></h2><div class="support"><button id="pinyin"></button><button id="english"></button></div><div id="awards" class="actions"></div><button id="miss"><%= copy('无人答对，下一轮','No correct answer · next round') %></button><button id="end-answer"><%= copy('结束游戏','End game') %></button><p class="dialog-hint"><%= copy('选择得分队伍，继续下一轮','Choose who earns the points to continue') %></p></dialog>
<section id="finish" class="panel" hidden><h2 id="result"></h2><button id="again" class="primary"><%= copy('重新洗牌再玩','Shuffle and play again') %></button></section><dialog id="celebration" class="panel" aria-labelledby="winner-title"><div id="confetti" aria-hidden="true"></div><img class="trophy" src="/teaching-tools/vocabulary-gacha/assets/trophy.svg" alt=""><p class="eyebrow"><%= copy('游戏结束','GAME COMPLETE') %></p><h2 id="winner-title"></h2><p id="final-scores"></p><button id="close-celebration" class="primary"><%= copy('查看比分','View scores') %></button></dialog></section>
</main><script src="/javascripts/account-coming-soon.js"></script><script src="/javascripts/milk-tea-footer.js"></script></body></html>
