<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#194f45">
  <title>Random Group Generator - Teacher Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'Quickly create random student groups for clear, balanced classroom activities.' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/teaching-tools/random-group-generator/random-group-generator.css?v=group-builder-1">
</head>
<body class="group-page">
  <header class="header group-hero">
    <a href="/teaching-tools" class="back-btn">← Back to Teaching Tools</a>
    <div class="group-hero__inner">
      <div class="group-hero__icon" aria-hidden="true">🎲</div>
      <div>
        <p class="group-eyebrow">Classroom management tool</p>
        <h1>Random Group Generator</h1>
        <p>Paste your class list, choose how you want to divide it, and make fair groups in seconds.</p>
      </div>
      <div class="group-hero__chips" aria-label="Tool features">
        <span>Fair shuffle</span>
        <span>Two grouping modes</span>
        <span>Easy to copy</span>
      </div>
    </div>
  </header>

  <main class="group-workspace">
    <section class="group-builder" aria-labelledby="groupBuilderTitle">
      <header class="group-builder__header">
        <span class="group-step-icon" aria-hidden="true">1</span>
        <div>
          <p class="group-eyebrow">Add your class</p>
          <h2 id="groupBuilderTitle">Who is here today?</h2>
          <p>Enter one student per line. Blank lines are ignored.</p>
        </div>
        <span id="studentCount" class="group-count" aria-live="polite">0 students</span>
      </header>

      <div class="group-builder__body">
        <section class="group-name-panel" aria-labelledby="nameListTitle">
          <div class="group-section-title">
            <div>
              <p class="group-eyebrow">Student list</p>
              <h3 id="nameListTitle">Paste or type names</h3>
            </div>
            <span aria-hidden="true">✎</span>
          </div>
          <label class="sr-only" for="names">Student names, one per line</label>
          <textarea id="names" rows="12" spellcheck="false" placeholder="Ava&#10;Mateo&#10;Sofia&#10;Noah&#10;Liam"></textarea>
          <div class="group-input-footer">
            <p>Tip: paste a column directly from your roster.</p>
            <div>
              <button id="loadGroupSample" class="group-text-button" type="button">Use sample names</button>
              <button id="clearGroupNames" class="group-text-button group-text-button--muted" type="button">Clear</button>
            </div>
          </div>
        </section>

        <aside class="group-settings" aria-labelledby="groupSettingsTitle">
          <div class="group-section-title">
            <div>
              <p class="group-eyebrow">Step 2</p>
              <h3 id="groupSettingsTitle">Choose a grouping method</h3>
            </div>
            <span aria-hidden="true">⚙️</span>
          </div>

          <fieldset class="group-mode-options">
            <legend class="sr-only">Grouping method</legend>
            <label class="group-mode-card is-selected" data-mode-card="size">
              <span class="group-mode-card__top">
                <input type="radio" name="groupMode" value="size" checked>
                <strong>Students per group</strong>
              </span>
              <span class="group-mode-card__hint">Choose the maximum size of each team.</span>
              <span class="group-number-field">
                <span>Group size</span>
                <input id="groupSize" type="number" min="2" max="50" value="3" inputmode="numeric" aria-label="Students per group">
              </span>
            </label>

            <label class="group-mode-card" data-mode-card="count">
              <span class="group-mode-card__top">
                <input type="radio" name="groupMode" value="count">
                <strong>Number of groups</strong>
              </span>
              <span class="group-mode-card__hint">Choose how many teams you need.</span>
              <span class="group-number-field">
                <span>Group count</span>
                <input id="groupCount" type="number" min="2" max="50" value="4" inputmode="numeric" aria-label="Number of groups" disabled>
              </span>
            </label>
          </fieldset>

          <div class="group-plan" aria-live="polite">
            <span aria-hidden="true">✦</span>
            <p id="groupingPreview">Add student names to preview your groups.</p>
          </div>
          <button id="generateGroups" class="group-primary-button" type="button">🎲 Make random groups</button>
          <p id="groupStatus" class="group-status" role="status"></p>
        </aside>
      </div>
    </section>

    <section class="group-results" id="results" aria-labelledby="groupResultsTitle">
      <header class="group-results__header">
        <div class="group-results__heading">
          <span class="group-step-icon group-step-icon--leaf" aria-hidden="true">3</span>
          <div>
            <p class="group-eyebrow">Ready for class</p>
            <h2 id="groupResultsTitle">Your groups</h2>
            <p id="resultSummary">Groups will appear here after you add names.</p>
          </div>
        </div>
        <div class="group-results__actions">
          <button id="reshuffleGroups" class="group-secondary-button" type="button" disabled>↻ Shuffle again</button>
          <button id="copyGroups" class="group-secondary-button" type="button" disabled>⧉ Copy groups</button>
        </div>
      </header>
      <div id="groupOutput" class="group-output" aria-live="polite">
        <div class="group-empty-state">
          <span aria-hidden="true">🎲</span>
          <strong>No groups yet</strong>
          <p>Your shuffled teams will be easy to scan and copy from here.</p>
        </div>
      </div>
    </section>
  </main>

  <%- include('../partials/tool-guide', { toolGuide: toolGuide }) %>
  <script src="/teaching-tools/random-group-generator/random-group-generator.js?v=group-builder-1"></script>
  <script src="/javascripts/account-coming-soon.js"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
