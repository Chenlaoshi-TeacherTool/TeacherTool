<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#194f45">
  <title>Random Group Generator - Teacher Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'Quickly create random student groups for clear, balanced classroom activities.' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/teaching-tools/random-group-generator/random-group-generator.css?v=group-builder-1">
</head>
<body class="group-page">
  <header class="header group-hero">
    <a href="/teaching-tools" class="back-btn"><%= t('randomGroupGenerator.backBtn') %></a>
    <div class="group-hero__inner">
      <div class="group-hero__icon" aria-hidden="true">🎲</div>
      <div>
        <p class="group-eyebrow"><%= t('randomGroupGenerator.eyebrow') %></p>
        <h1><%= t('randomGroupGenerator.title') %></h1>
        <p><%= t('randomGroupGenerator.subtitle') %></p>
      </div>
      <div class="group-hero__chips" aria-label="Tool features">
        <span><%= t('randomGroupGenerator.chip1') %></span>
        <span><%= t('randomGroupGenerator.chip2') %></span>
        <span><%= t('randomGroupGenerator.chip3') %></span>
      </div>
    </div>
  </header>

  <main class="group-workspace">
    <section class="group-builder" aria-labelledby="groupBuilderTitle">
      <header class="group-builder__header">
        <span class="group-step-icon" aria-hidden="true">1</span>
        <div>
          <p class="group-eyebrow"><%= t('randomGroupGenerator.addClassEyebrow') %></p>
          <h2 id="groupBuilderTitle"><%= t('randomGroupGenerator.whoIsHereHeading') %></h2>
          <p><%= t('randomGroupGenerator.enterOneStudentHelp') %></p>
        </div>
        <span id="studentCount" class="group-count" aria-live="polite"><%= t('randomGroupGenerator.studentCountInitial') %></span>
      </header>

      <div class="group-builder__body">
        <section class="group-name-panel" aria-labelledby="nameListTitle">
          <div class="group-section-title">
            <div>
              <p class="group-eyebrow"><%= t('randomGroupGenerator.studentListEyebrow') %></p>
              <h3 id="nameListTitle"><%= t('randomGroupGenerator.pasteNamesHeading') %></h3>
            </div>
            <span aria-hidden="true">✎</span>
          </div>
          <label class="sr-only" for="names"><%= t('randomGroupGenerator.namesSrLabel') %></label>
          <textarea id="names" rows="12" spellcheck="false" placeholder="Ava&#10;Mateo&#10;Sofia&#10;Noah&#10;Liam"></textarea>
          <div class="group-input-footer">
            <p><%= t('randomGroupGenerator.tipText') %></p>
            <div>
              <button id="loadGroupSample" class="group-text-button" type="button"><%= t('randomGroupGenerator.useSampleNames') %></button>
              <button id="clearGroupNames" class="group-text-button group-text-button--muted" type="button"><%= t('randomGroupGenerator.clear') %></button>
            </div>
          </div>
        </section>

        <aside class="group-settings" aria-labelledby="groupSettingsTitle">
          <div class="group-section-title">
            <div>
              <p class="group-eyebrow"><%= t('randomGroupGenerator.settingsEyebrow') %></p>
              <h3 id="groupSettingsTitle"><%= t('randomGroupGenerator.chooseMethodHeading') %></h3>
            </div>
            <span aria-hidden="true">⚙️</span>
          </div>

          <fieldset class="group-mode-options">
            <legend class="sr-only"><%= t('randomGroupGenerator.groupingMethodLegend') %></legend>
            <label class="group-mode-card is-selected" data-mode-card="size">
              <span class="group-mode-card__top">
                <input type="radio" name="groupMode" value="size" checked>
                <strong><%= t('randomGroupGenerator.studentsPerGroupStrong') %></strong>
              </span>
              <span class="group-mode-card__hint"><%= t('randomGroupGenerator.studentsPerGroupHint') %></span>
              <span class="group-number-field">
                <span><%= t('randomGroupGenerator.groupSizeLabel') %></span>
                <input id="groupSize" type="number" min="2" max="50" value="3" inputmode="numeric" aria-label="Students per group">
              </span>
            </label>

            <label class="group-mode-card" data-mode-card="count">
              <span class="group-mode-card__top">
                <input type="radio" name="groupMode" value="count">
                <strong><%= t('randomGroupGenerator.numberOfGroupsStrong') %></strong>
              </span>
              <span class="group-mode-card__hint"><%= t('randomGroupGenerator.numberOfGroupsHint') %></span>
              <span class="group-number-field">
                <span><%= t('randomGroupGenerator.groupCountLabel') %></span>
                <input id="groupCount" type="number" min="2" max="50" value="4" inputmode="numeric" aria-label="Number of groups" disabled>
              </span>
            </label>
          </fieldset>

          <div class="group-plan" aria-live="polite">
            <span aria-hidden="true">✦</span>
            <p id="groupingPreview"><%= t('randomGroupGenerator.groupingPreviewInitial') %></p>
          </div>
          <button id="generateGroups" class="group-primary-button" type="button">🎲 <%= t('randomGroupGenerator.makeRandomGroups') %></button>
          <p id="groupStatus" class="group-status" role="status"></p>
        </aside>
      </div>
    </section>

    <section class="group-results" id="results" aria-labelledby="groupResultsTitle">
      <header class="group-results__header">
        <div class="group-results__heading">
          <span class="group-step-icon group-step-icon--leaf" aria-hidden="true">3</span>
          <div>
            <p class="group-eyebrow"><%= t('randomGroupGenerator.readyForClassEyebrow') %></p>
            <h2 id="groupResultsTitle"><%= t('randomGroupGenerator.yourGroupsHeading') %></h2>
            <p id="resultSummary"><%= t('randomGroupGenerator.resultSummaryInitial') %></p>
          </div>
        </div>
        <div class="group-results__actions">
          <button id="reshuffleGroups" class="group-secondary-button" type="button" disabled>↻ <%= t('randomGroupGenerator.shuffleAgain') %></button>
          <button id="copyGroups" class="group-secondary-button" type="button" disabled>⧉ <%= t('randomGroupGenerator.copyGroups') %></button>
        </div>
      </header>
      <div id="groupOutput" class="group-output" aria-live="polite">
        <div class="group-empty-state">
          <span aria-hidden="true">🎲</span>
          <strong><%= t('randomGroupGenerator.noGroupsYet') %></strong>
          <p><%= t('randomGroupGenerator.emptyStateText') %></p>
        </div>
      </div>
    </section>
  </main>

  <%- include('../partials/tool-guide', { toolGuide: toolGuide }) %>
  <script src="/teaching-tools/random-group-generator/random-group-generator.js?v=group-builder-1"></script>
  <script src="/javascripts/account-coming-soon.js"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
