<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/adsense') %>
    <title>Teaching Tools - Teacher Toolkit</title>
    <%- include('../partials/seo', { pageDescription: 'Discover practical classroom tools for teachers across subjects, including random groups, QR worksheets, spinners, question banks, and vocabulary resources.' }) %>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f8f9fa;
            color: #333;
            line-height: 1.6;
        }
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 40px 20px;
            text-align: center;
        }
        .header h1 {
            margin-bottom: 10px;
        }
        .tool-search {
            width: min(650px, calc(100% - 40px));
            margin: 30px auto -14px;
        }
        .tool-search label {
            display: block;
            margin: 0 0 8px;
            color: #194f45;
            font-weight: 800;
        }
        .tool-search-input {
            position: relative;
        }
        .tool-search-input span {
            position: absolute;
            top: 50%;
            left: 15px;
            transform: translateY(-50%);
            color: #356e57;
            pointer-events: none;
        }
        .tool-search input {
            width: 100%;
            padding: 13px 16px 13px 42px;
            font-size: 1rem;
        }
        .tool-search-status {
            min-height: 1.6em;
            margin: 7px 0 0;
            color: #5d7168;
            font-size: .9rem;
        }
        .tool-use-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
        .tool-use-filters button { font: inherit; padding: 9px 14px; border: 1px solid #356e57; border-radius: 22px; background: white; color: #194f45; cursor: pointer; }
        .tool-use-filters button[aria-pressed="true"] { background: #194f45; color: white; }
        .tool-use-filters button:focus-visible { outline: 3px solid #bf7f35; outline-offset: 3px; }
        .tool-search input { box-sizing: border-box; }
        .tool-empty-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
        .tool-empty-actions[hidden] { display: none; }
        .tool-card[hidden] {
            display: none;
        }
        .tool-sections {
            padding: 34px 20px 48px;
        }
        .tool-section {
            max-width: 1200px;
            margin: 0 auto 46px;
            scroll-margin-top: 24px;
        }
        .tool-section[hidden] {
            display: none;
        }
        .tool-jump { display: flex; flex-wrap: wrap; gap: 8px; max-width: 1200px; margin: 0 auto 30px; }
        .tool-jump a { padding: 8px 14px; border: 1px solid #cbdac2; border-radius: 22px; background: #fffdf7; color: #194f45; font-weight: 700; text-decoration: none; }
        .tool-jump a:hover { background: #edf5df; }
        .tool-jump a:focus-visible, .tool-section-toggle:focus-visible { outline: 3px solid #bf7f35; outline-offset: 3px; }
        .tool-jump a[hidden] { display: none; }
        .tool-jump span { margin-left: 4px; color: #5d7168; font-weight: 400; }
        /* Long groups fold after eight cards; searching or filtering shows every match. */
        .tool-sections:not(.is-filtering) .tool-section.is-collapsed .tool-card--extra { display: none; }
        .tool-section-toggle { display: block; margin: 20px auto 0; padding: 10px 20px; border: 1px solid #356e57; border-radius: 22px; background: white; color: #194f45; font: inherit; font-weight: 700; cursor: pointer; }
        .tool-sections.is-filtering .tool-section-toggle { display: none; }
        .tool-section-heading {
            max-width: 760px;
            margin-bottom: 18px;
        }
        .tool-section-heading h2 {
            margin: 0 0 6px;
            color: #2f3f77;
        }
        .tool-section-heading p {
            margin: 0;
            color: #5d7168;
        }
        .back-btn {
            position: absolute;
            top: 20px;
            left: 20px;
            background-color: rgba(255, 255, 255, 0.2);
            border: 1px solid white;
            color: white;
            padding: 10px 15px;
            text-decoration: none;
            border-radius: 5px;
        }
        .tools-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
            padding: 0;
        }
        .tool-card {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            text-align: center;
            transition: transform 0.3s;
        }
        .tool-card:not(.coming-soon):hover {
            transform: translateY(-5px);
        }
        .tool-card h3 {
            color: #667eea;
            margin-bottom: 15px;
        }
        .tool-limited-free { display: inline-block; padding: 4px 10px; border-radius: 999px; background: #fff3cd; color: #855500; font-size: .75rem; font-weight: 800; vertical-align: middle; }
        .tool-card p {
            margin-bottom: 20px;
        }
        .tool-scope { display: inline-block; margin: 0 0 12px !important; padding: 4px 9px; border-radius: 999px; background: #edf5df; color: #356e57; font-size: .75rem; font-weight: 800; }
        .btn {
            background-color: #667eea;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }
        .btn:hover {
            background-color: #5a67d8;
        }
        .coming-soon {
            opacity: 0.6;
        }
        .coming-soon .btn {
            background-color: #a8acb9;
            cursor: not-allowed;
        }
        .qr-generator {
            max-width: 600px;
            margin: 20px auto;
            padding: 20px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            display: none;
        }
        .qr-generator input {
            width: 100%;
            padding: 10px;
            margin-bottom: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }
        .qr-output {
            margin-top: 20px;
            text-align: center;
        }
        @media (max-width: 768px) {
            .tools-grid {
                grid-template-columns: 1fr;
            }
            .tool-sections {
                padding-inline: 16px;
            }
        }
    </style>
    <link rel="stylesheet" href="/stylesheets/site-theme.css">
    <link rel="stylesheet" href="/stylesheets/tool-snapshots.css?v=1">
</head>
<body>
    <a href="/" class="back-btn">← <%= t('teachingToolsIndex.backToHomepage') %></a>
    <section class="header">
        <h1><%= t('teachingToolsIndex.title') %></h1>
        <p><%= t('teachingToolsIndex.intro') %></p>
    </section>

    <section class="tool-search" aria-labelledby="tool-search-label">
        <label id="tool-search-label" for="toolSearch"><%= t('teachingToolsIndex.findToolLabel') %></label>
        <div class="tool-search-input">
            <span aria-hidden="true">⌕</span>
            <input id="toolSearch" type="search" placeholder="<%= t('teachingToolsIndex.searchPlaceholder') %>" autocomplete="off" aria-describedby="toolSearchStatus">
        </div>
        <div class="tool-use-filters" role="group" aria-label="<%= lang === 'zh' ? '按用途筛选' : 'Filter by use' %>">
          <% [['all','All','全部'],['print','Printables','打印材料'],['project','Projector games','投影游戏'],['independent','Independent practice','学生自主练习'],['manage','Classroom management','课堂管理']].forEach(function(use) { %>
          <button type="button" data-use="<%= use[0] %>" aria-pressed="<%= use[0] === 'all' %>"><%= use[lang === 'zh' ? 2 : 1] %></button>
          <% }); %>
        </div>
        <p id="toolSearchStatus" class="tool-search-status" role="status"><%= t('teachingToolsIndex.searchStatusDefault') %></p>
        <div id="toolEmptyActions" class="tool-empty-actions" hidden>
            <button id="clearToolSearch" class="btn" type="button"><%= lang === 'zh' ? '清除搜索' : 'Clear search' %></button>
            <button id="showAllTools" class="btn" type="button"><%= lang === 'zh' ? '查看全部工具' : 'View all tools' %></button>
        </div>
    </section>

    <%# id: older links and tool pages' back buttons point at #low-prep-activities. %>
    <main class="tool-sections" id="low-prep-activities">
        <nav class="tool-jump" aria-label="<%= t('teachingToolsIndex.jumpLabel') %>">
            <% toolSections.forEach(function(section) { %>
            <a href="#<%= section.key %>"><%= t('teachingToolsIndex.groups.' + section.key + '.heading') %><span><%= section.tools.length %></span></a>
            <% }); %>
        </nav>
        <% toolSections.forEach(function(section) { var folds = section.tools.length > 8; %>
        <section class="tool-section<%= folds ? ' is-collapsed' : '' %>" id="<%= section.key %>" aria-labelledby="<%= section.key %>-heading">
            <div class="tool-section-heading">
                <h2 id="<%= section.key %>-heading"><%= t('teachingToolsIndex.groups.' + section.key + '.heading') %></h2>
                <p><%= t('teachingToolsIndex.groups.' + section.key + '.desc') %></p>
            </div>
            <div class="tools-grid">
                <% section.tools.forEach(function(tool, index) { %>
                <% var searchText = [tool.titleKey, tool.scopeKey, tool.descKey].map(function(key) { return key ? t(key) + ' ' + tOther(key) : ''; }).join(' '); %>
                <div data-uses="<%= tool.uses.join(' ') %>" data-search="<%= searchText %>" class="tool-card <%= tool.comingSoon ? 'coming-soon' : 'snapshot-card' %><%= index >= 8 ? ' tool-card--extra' : '' %>">
                    <% if (tool.href) { %><%- include('../partials/tool-snapshot', { previewHref: tool.href }) %><% } %>
                    <h3><% if (tool.icon) { %><%= tool.icon %> <% } %><%= t(tool.titleKey) %><% if (tool.limitedFree) { %> <span class="tool-limited-free"><%= t('teachingToolsIndex.limitedFree') %></span><% } %></h3>
                    <p class="tool-scope"><%= t(tool.scopeKey) %></p>
                    <p><%= t(tool.descKey) %></p>
                    <% if (tool.href) { %>
                    <a href="<%= tool.href %>" class="btn"><%= t(tool.actionKey) %></a>
                    <% } else { %>
                    <button class="btn" type="button" disabled><%= t('teachingToolsIndex.comingSoon') %></button>
                    <% } %>
                </div>
                <% }); %>
            </div>
            <% if (folds) { %>
            <button class="tool-section-toggle" type="button" aria-expanded="false" data-more="<%= t('teachingToolsIndex.showAll').replace('{count}', section.tools.length) %>" data-less="<%= t('teachingToolsIndex.showFewer') %>"><%= t('teachingToolsIndex.showAll').replace('{count}', section.tools.length) %></button>
            <% } %>
        </section>
        <% }); %>
    </main>

    <script src="/javascripts/account-coming-soon.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode/1.5.3/qrcode.min.js"></script>
    <script>
        // Removed QR generator functionality as it's now on a separate page
    </script>
    <script>
        (function () {
            var search = document.getElementById('toolSearch');
            var status = document.getElementById('toolSearchStatus');
            var cards = Array.prototype.slice.call(document.querySelectorAll('.tool-card'));
            var sections = Array.prototype.slice.call(document.querySelectorAll('.tool-section'));

            var emptyActions = document.getElementById('toolEmptyActions');
            var clearSearch = document.getElementById('clearToolSearch');
            var selectedUse = 'all';
            var chinese = <%- JSON.stringify(lang === 'zh') %>;
            var useButtons = document.querySelectorAll('[data-use]');

            function updateToolResults() {
                var query = search.value.trim().toLocaleLowerCase();
                var matches = 0;

                cards.forEach(function (card) {
                    var inScope = selectedUse === 'all' || (card.dataset.uses || '').split(' ').indexOf(selectedUse) !== -1;
                    var isMatch = inScope && (!query || (card.dataset.search || card.textContent).toLocaleLowerCase().indexOf(query) !== -1);
                    card.hidden = !isMatch;
                    if (isMatch) matches += 1;
                });

                sections.forEach(function (section) {
                    var sectionCards = Array.prototype.slice.call(section.querySelectorAll('.tool-card'));
                    section.hidden = sectionCards.every(function (card) { return card.hidden; });
                    document.querySelector('.tool-jump a[href="#' + section.id + '"]').hidden = section.hidden;
                });
                document.querySelector('.tool-sections').classList.toggle('is-filtering', Boolean(query) || selectedUse !== 'all');

                emptyActions.hidden = matches !== 0;
                clearSearch.hidden = !query;
                status.textContent = chinese ? '找到 ' + matches + ' 个工具和活动' + (query ? '：' + search.value.trim() : '') + '。' : 'Showing ' + matches + ' tools and activities' + (query ? ' for “' + search.value.trim() + '”' : '') + '.';
            }

            useButtons.forEach(function(button) {
                button.addEventListener('click', function() {
                    selectedUse = button.dataset.use;
                    useButtons.forEach(function(item) { item.setAttribute('aria-pressed', String(item === button)); });
                    updateToolResults();
                });
            });
            clearSearch.addEventListener('click', function() {
                search.value = '';
                updateToolResults();
                search.focus();
            });
            document.getElementById('showAllTools').addEventListener('click', function() {
                selectedUse = 'all';
                search.value = '';
                useButtons.forEach(function(item) { item.setAttribute('aria-pressed', String(item.dataset.use === 'all')); });
                updateToolResults();
                search.focus();
            });
            Array.prototype.forEach.call(document.querySelectorAll('.tool-section-toggle'), function(toggle) {
                toggle.addEventListener('click', function() {
                    var collapsed = toggle.parentNode.classList.toggle('is-collapsed');
                    toggle.setAttribute('aria-expanded', String(!collapsed));
                    toggle.textContent = collapsed ? toggle.dataset.more : toggle.dataset.less;
                });
            });
            search.addEventListener('input', updateToolResults);
            updateToolResults();
        })();
    </script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
