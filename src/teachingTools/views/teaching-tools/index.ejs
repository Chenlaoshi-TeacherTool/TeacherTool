<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/adsense') %>
    <title>Teaching Tools - Teacher Toolkit</title>
    <%- include('../partials/seo', { pageDescription: 'Discover practical classroom tools for teachers across subjects, including random groups, QR worksheets, spinners, question banks, and vocabulary resources.' }) %>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f8f9fa;
            color: #333;
            line-height: 1.6;
        }
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 40px 20px;
            text-align: center;
        }
        .header h1 {
            margin-bottom: 10px;
        }
        .tool-search {
            width: min(650px, calc(100% - 40px));
            margin: 30px auto -14px;
        }
        .tool-search label {
            display: block;
            margin: 0 0 8px;
            color: #194f45;
            font-weight: 800;
        }
        .tool-search-input {
            position: relative;
        }
        .tool-search-input span {
            position: absolute;
            top: 50%;
            left: 15px;
            transform: translateY(-50%);
            color: #356e57;
            pointer-events: none;
        }
        .tool-search input {
            width: 100%;
            padding: 13px 16px 13px 42px;
            font-size: 1rem;
        }
        .tool-search-status {
            min-height: 1.6em;
            margin: 7px 0 0;
            color: #5d7168;
            font-size: .9rem;
        }
        .tool-search input { box-sizing: border-box; }
        .tool-empty-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
        .tool-empty-actions[hidden] { display: none; }
        .quick-start { box-sizing: border-box; display: flex; align-items: center; gap: 24px; max-width: 1200px; margin: 40px auto 0; padding: 22px 28px; border: 2px solid #cbdac2; border-radius: 16px; background: #fffdf7; }
        .quick-start[hidden] { display: none; }
        .quick-start-text { flex: 1; }
        .quick-start-kicker { margin: 0; color: #bf7f35; font-size: .8rem; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; }
        .quick-start h2 { margin: 2px 0 10px; color: #194f45; }
        .quick-start-steps { display: flex; flex-wrap: wrap; gap: 8px 22px; margin: 0; padding: 0; list-style: none; color: #34463f; }
        .quick-start-steps span { display: inline-grid; place-items: center; width: 24px; height: 24px; margin-right: 7px; border-radius: 50%; background: #356e57; color: #fff; font-size: .8rem; font-weight: 800; }
        .quick-start-btn { flex-shrink: 0; padding: 12px 22px; font-weight: 700; }
        @media (max-width: 768px) {
            .quick-start { flex-direction: column; align-items: stretch; margin: 32px 16px 0; padding: 18px; }
            .quick-start-steps { flex-direction: column; }
            .quick-start-btn { text-align: center; }
        }
        .tool-card[hidden] {
            display: none;
        }
        .tool-sections {
            padding: 34px 20px 48px;
        }
        .tool-section {
            max-width: 1200px;
            margin: 0 auto 46px;
            scroll-margin-top: 24px;
        }
        .tool-section[hidden] {
            display: none;
        }
        .tool-jump { display: flex; flex-wrap: wrap; gap: 8px; max-width: 1200px; margin: 0 auto 30px; }
        .tool-jump a { padding: 8px 14px; border: 1px solid #cbdac2; border-radius: 22px; background: #fffdf7; color: #194f45; font-weight: 700; text-decoration: none; }
        .tool-jump a:hover { background: #edf5df; }
        .tool-jump a:focus-visible { outline: 3px solid #bf7f35; outline-offset: 3px; }
        .tool-jump a[hidden] { display: none; }
        .tool-jump span { margin-left: 4px; color: #5d7168; font-weight: 400; }
        .tool-group + .tool-group { margin-top: 28px; }
        .tool-group, .tool-anchor { scroll-margin-top: 24px; }
        .tool-anchor { height: 1px; }
        .tool-group-heading { margin: 0 0 12px; color: #194f45; }
        .tool-social-links { padding-left: 20px; margin-bottom: 12px; }
        .tool-social-links a { color: #194f45; }
        .tool-card .tool-categories { display: none; color: #356e57; font-weight: 700; }
        .is-filtering .tool-card .tool-categories { display: block; }
        .tool-section-heading {
            max-width: 760px;
            margin-bottom: 18px;
        }
        .tool-section-heading h2 {
            margin: 0 0 6px;
            color: #2f3f77;
        }
        .tool-section-heading p {
            margin: 0;
            color: #5d7168;
        }
        .back-btn {
            position: absolute;
            top: 20px;
            left: 20px;
            background-color: rgba(255, 255, 255, 0.2);
            border: 1px solid white;
            color: white;
            padding: 10px 15px;
            text-decoration: none;
            border-radius: 5px;
        }
        .tools-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
            padding: 0;
        }
        .tool-card {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            text-align: center;
            transition: transform 0.3s;
        }
        .tool-card:not(.coming-soon):hover {
            transform: translateY(-5px);
        }
        .tool-card h3 {
            color: #667eea;
            margin-bottom: 15px;
        }
        .tool-limited-free { display: inline-block; padding: 4px 10px; border-radius: 999px; background: #fff3cd; color: #855500; font-size: .75rem; font-weight: 800; vertical-align: middle; }
        .tool-card p {
            margin-bottom: 20px;
        }
        .tool-subject { display: inline-block; padding: 4px 10px; border-radius: 999px; background: #fde8e4; color: #a63f34; font-size: .75rem; font-weight: 800; vertical-align: middle; }
        .tool-scope { display: inline-block; margin: 0 0 12px !important; padding: 4px 9px; border-radius: 999px; background: #edf5df; color: #356e57; font-size: .75rem; font-weight: 800; }
        .btn {
            background-color: #667eea;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }
        .btn:hover {
            background-color: #5a67d8;
        }
        .coming-soon {
            opacity: 0.6;
        }
        .coming-soon .btn {
            background-color: #a8acb9;
            cursor: not-allowed;
        }
        .qr-generator {
            max-width: 600px;
            margin: 20px auto;
            padding: 20px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            display: none;
        }
        .qr-generator input {
            width: 100%;
            padding: 10px;
            margin-bottom: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }
        .qr-output {
            margin-top: 20px;
            text-align: center;
        }
        @media (max-width: 768px) {
            .tools-grid {
                grid-template-columns: 1fr;
            }
            .tool-sections {
                padding-inline: 16px;
            }
        }
    </style>
    <link rel="stylesheet" href="/stylesheets/site-theme.css">
    <link rel="stylesheet" href="/stylesheets/tool-snapshots.css?v=1">
    <link rel="stylesheet" href="/shared/tool-favorites.css?v=2">
</head>
<body>
    <a href="/" class="back-btn">← <%= t('teachingToolsIndex.backToHomepage') %></a>
    <section class="header">
        <h1><%= t('teachingToolsIndex.title') %></h1>
        <p><%= t('teachingToolsIndex.intro') %></p>
    </section>

    <section class="tool-search" aria-labelledby="tool-search-label">
        <label id="tool-search-label" for="toolSearch"><%= t('teachingToolsIndex.findToolLabel') %></label>
        <div class="tool-search-input">
            <span aria-hidden="true">⌕</span>
            <input id="toolSearch" type="search" placeholder="<%= t('teachingToolsIndex.searchPlaceholder') %>" autocomplete="off" aria-describedby="toolSearchStatus">
        </div>
        <p id="toolSearchStatus" class="tool-search-status" role="status"><%= t('teachingToolsIndex.searchStatusDefault') %></p>
        <div id="toolEmptyActions" class="tool-empty-actions" hidden>
            <button id="clearToolSearch" class="btn" type="button"><%= lang === 'zh' ? '清除搜索' : 'Clear search' %></button>
        </div>
    </section>

    <section class="quick-start" id="quickStart" aria-labelledby="quick-start-heading">
        <div class="quick-start-text">
            <p class="quick-start-kicker"><%= t('teachingToolsIndex.quickStart.kicker') %></p>
            <h2 id="quick-start-heading"><%= t('teachingToolsIndex.quickStart.heading') %></h2>
            <ol class="quick-start-steps">
                <li><span>1</span><%= t('teachingToolsIndex.quickStart.step1') %></li>
                <li><span>2</span><%= t('teachingToolsIndex.quickStart.step2') %></li>
                <li><span>3</span><%= t('teachingToolsIndex.quickStart.step3') %></li>
            </ol>
        </div>
        <a class="btn quick-start-btn" href="/teaching-tools/vocab-games"><%= t('teachingToolsIndex.quickStart.action') %> →</a>
    </section>

    <% var categoryNames = new Map();
       toolSections.forEach(function(section) {
           if (section.key === 'coming-soon') return;
           section.tools.forEach(function(tool) {
               var names = categoryNames.get(tool) || [];
               names.push(t('teachingToolsIndex.groups.' + section.key + '.heading'));
               categoryNames.set(tool, names);
           });
       }); %>
    <%# id: older links and tool pages' back buttons point at #low-prep-activities. %>
    <main class="tool-sections" id="low-prep-activities">
        <nav class="tool-jump" aria-label="<%= t('teachingToolsIndex.jumpLabel') %>">
            <% toolSections.filter(function(section) { return section.key !== 'coming-soon'; }).forEach(function(section) { %>
            <a href="#<%= section.key %>"><%= t('teachingToolsIndex.groups.' + section.key + '.heading') %><span><%= section.tools.length %></span></a>
            <% }); %>
        </nav>
        <% toolSections.forEach(function(section) { %>
        <section class="tool-section" id="<%= section.key %>" aria-labelledby="<%= section.key %>-heading">
            <% if (section.key === 'online-practice') { %><div class="tool-anchor" id="reading"></div><% } %>
            <div class="tool-section-heading">
                <h2 id="<%= section.key %>-heading"><%= t('teachingToolsIndex.groups.' + section.key + '.heading') %></h2>
                <p><%= t('teachingToolsIndex.groups.' + section.key + '.desc') %></p>
            </div>
            <% section.groups.forEach(function(group) { %>
            <div class="tool-group"<% if (group.key !== 'main') { %> id="<%= group.key %>"<% } %>>
            <% if (group.key === 'chinese-materials') { %><div class="tool-anchor" id="hanzi"></div><% } %>
            <% if (group.key !== 'main') { %><h3 class="tool-group-heading"><%= t('teachingToolsIndex.groups.' + group.key + '.heading') %></h3><% } %>
            <div class="tools-grid">
                <% group.tools.forEach(function(tool) {
                    var links = tool.titleKey === 'teachingToolsIndex.socialMediaHubTitle' ? socialTools : [];
                    var searchKeys = [tool.titleKey, tool.scopeKey, tool.descKey].concat(links.map(function(link) { return link.titleKey; }));
                    var searchText = searchKeys.map(function(key) { return t(key) + ' ' + tOther(key); }).join(' ');
                    var categories = categoryNames.get(tool);
                %>
                <div data-tool="<%= tool.titleKey %>" data-search="<%= searchText %>"<% if (tool.href) { %> data-fav-ref="<%= tool.href %>"<% } %> class="tool-card <%= tool.comingSoon ? 'coming-soon' : 'snapshot-card' %>">
                    <% if (tool.href) { %><%- include('../partials/tool-snapshot', { previewHref: tool.href }) %><% } %>
                    <h3><% if (tool.icon) { %><%= tool.icon %> <% } %><%= t(tool.titleKey) %><% if (tool.subject === 'chinese') { %> <span class="tool-subject"><%= t('teachingToolsIndex.chineseOnly') %></span><% } %><% if (tool.limitedFree) { %> <span class="tool-limited-free"><%= t('teachingToolsIndex.limitedFree') %></span><% } %><% var fresh = tool.href && freshness(tool); if (fresh) { %> <span class="fresh-badge fresh-badge--<%= fresh %>"><%= t(fresh === 'new' ? 'teachingToolsIndex.freshNew' : 'teachingToolsIndex.freshUpdated') %></span><% } %></h3>
                    <p class="tool-scope"><%= t(tool.scopeKey) %></p>
                    <p><%= t(tool.descKey) %></p>
                    <% if (categories) { %><p class="tool-categories"><%= categories.join(lang === 'zh' ? '、' : ' · ') %></p><% } %>
                    <% if (links.length) { %>
                    <ul class="tool-social-links">
                        <% links.forEach(function(link) { %><li><a href="<%= link.href %>"><%= t(link.titleKey) %></a></li><% }); %>
                    </ul>
                    <% } %>
                    <% if (tool.href) { %>
                    <a href="<%= tool.href %>" class="btn"><%= t(tool.actionKey) %></a>
                    <% } else { %>
                    <button class="btn" type="button" disabled><%= t('teachingToolsIndex.comingSoon') %></button>
                    <% } %>
                </div>
                <% }); %>
            </div>
            </div>
            <% }); %>
        </section>
        <% }); %>
    </main>

    <script src="/javascripts/account-coming-soon.js"></script>
    <script src="/shared/tool-favorites.js?v=2"></script>
    <script>window.ChenFavorites.attachStars(document); window.ChenFavorites.load();</script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode/1.5.3/qrcode.min.js"></script>
    <script>
        // Removed QR generator functionality as it's now on a separate page
    </script>
    <script>
        (function () {
            var search = document.getElementById('toolSearch');
            var status = document.getElementById('toolSearchStatus');
            var cards = Array.prototype.slice.call(document.querySelectorAll('.tool-card'));
            var sections = Array.prototype.slice.call(document.querySelectorAll('.tool-section'));

            var emptyActions = document.getElementById('toolEmptyActions');
            var clearSearch = document.getElementById('clearToolSearch');
            var chinese = <%- JSON.stringify(lang === 'zh') %>;

            function updateToolResults() {
                var query = search.value.trim().toLocaleLowerCase();
                var seen = new Set();

                cards.forEach(function (card) {
                    var isMatch = !query || (!seen.has(card.dataset.tool) && card.dataset.search.toLocaleLowerCase().includes(query));
                    card.hidden = !isMatch;
                    if (isMatch && !card.classList.contains('coming-soon')) seen.add(card.dataset.tool);
                });

                document.querySelectorAll('.tool-group').forEach(function(group) {
                    group.hidden = !group.querySelector('.tool-card:not([hidden])');
                });
                sections.forEach(function (section) {
                    section.hidden = !section.querySelector('.tool-group:not([hidden])');
                    var jump = document.querySelector('.tool-jump a[href="#' + section.id + '"]');
                    if (jump) jump.hidden = section.hidden;
                });
                var matches = query ? document.querySelectorAll('.tool-card:not([hidden])').length : seen.size;
                document.querySelector('.tool-sections').classList.toggle('is-filtering', Boolean(query));
                document.getElementById('quickStart').hidden = Boolean(query);

                emptyActions.hidden = matches !== 0;
                clearSearch.hidden = !query;
                status.textContent = chinese ? '找到 ' + matches + ' 个工具和活动' + (query ? '：' + search.value.trim() : '') + '。' : 'Showing ' + matches + ' tools and activities' + (query ? ' for “' + search.value.trim() + '”' : '') + '.';
            }

            clearSearch.addEventListener('click', function() {
                search.value = '';
                updateToolResults();
                search.focus();
            });
            document.addEventListener('click', function(event) {
                var link = event.target.closest('.site-tool-categories a, .tool-jump a');
                if (link && link.pathname === window.location.pathname && search.value) {
                    search.value = '';
                    updateToolResults();
                }
            });
            search.addEventListener('input', updateToolResults);
            updateToolResults();
        })();
    </script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
