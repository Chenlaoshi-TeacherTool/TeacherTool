<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/adsense') %>
    <title>Teaching Tools - Teacher Toolkit</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f8f9fa;
            color: #333;
            line-height: 1.6;
        }
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 40px 20px;
            text-align: center;
        }
        .header h1 {
            margin-bottom: 10px;
        }
        .tool-search {
            width: min(650px, calc(100% - 40px));
            margin: 30px auto -14px;
        }
        .tool-search label {
            display: block;
            margin: 0 0 8px;
            color: #194f45;
            font-weight: 800;
        }
        .tool-search-input {
            position: relative;
        }
        .tool-search-input span {
            position: absolute;
            top: 50%;
            left: 15px;
            transform: translateY(-50%);
            color: #356e57;
            pointer-events: none;
        }
        .tool-search input {
            width: 100%;
            padding: 13px 16px 13px 42px;
            font-size: 1rem;
        }
        .tool-search-status {
            min-height: 1.6em;
            margin: 7px 0 0;
            color: #5d7168;
            font-size: .9rem;
        }
        .tool-card[hidden] {
            display: none;
        }
        .back-btn {
            position: absolute;
            top: 20px;
            left: 20px;
            background-color: rgba(255, 255, 255, 0.2);
            border: 1px solid white;
            color: white;
            padding: 10px 15px;
            text-decoration: none;
            border-radius: 5px;
        }
        .tools-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
            padding: 40px 20px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .tool-card {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            text-align: center;
            transition: transform 0.3s;
        }
        .tool-card:hover {
            transform: translateY(-5px);
        }
        .tool-card h3 {
            color: #667eea;
            margin-bottom: 15px;
        }
        .tool-card p {
            margin-bottom: 20px;
        }
        .btn {
            background-color: #667eea;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }
        .btn:hover {
            background-color: #5a67d8;
        }
        .coming-soon {
            opacity: 0.6;
        }
        .qr-generator {
            max-width: 600px;
            margin: 20px auto;
            padding: 20px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            display: none;
        }
        .qr-generator input {
            width: 100%;
            padding: 10px;
            margin-bottom: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }
        .qr-output {
            margin-top: 20px;
            text-align: center;
        }
        @media (max-width: 768px) {
            .tools-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
    <link rel="stylesheet" href="/stylesheets/site-theme.css">
</head>
<body>
    <a href="/" class="back-btn">← Back to Homepage</a>
    <section class="header">
        <h1>Teaching Tools</h1>
        <p>Simple tools to save teachers time in the classroom.</p>
    </section>

    <section class="tool-search" aria-labelledby="tool-search-label">
        <label id="tool-search-label" for="toolSearch">Find a tool</label>
        <div class="tool-search-input">
            <span aria-hidden="true">⌕</span>
            <input id="toolSearch" type="search" placeholder="Search by tool name or keyword" autocomplete="off" aria-describedby="toolSearchStatus">
        </div>
        <p id="toolSearchStatus" class="tool-search-status" role="status">Showing all 8 tools.</p>
    </section>

    <section class="tools-grid">
        <div class="tool-card">
            <h3>📌 QR Code Generator</h3>
            <p>Generate QR codes from any text or website link for classroom use.</p>
            <a href="/teaching-tools/qr-code-generator" class="btn">Open Tool</a>
        </div>
        <div class="tool-card">
            <h3>🎲 Random Group Generator</h3>
            <p>Quickly create random student groups for your class.</p>
            <a href="/teaching-tools/random-group-generator" class="btn">Open Tool</a>
        </div>
        <div class="tool-card">
            <h3>🌻 Sunflower Spinner</h3>
            <p>Add words, sentences, or names to a sunflower wheel, then spin for a bright classroom pick.</p>
            <a href="/teaching-tools/sunflower-spinner/sunflower-spinner.html" class="btn">Open Tool</a>
        </div>
        <div class="tool-card">
            <h3>🗂️ Library</h3>
            <p>Create reusable Chinese, pinyin, and English word lists for future cards, games, and worksheets.</p>
            <a href="/teaching-tools/word-list-library/word-list-library.html" class="btn">Open Tool</a>
        </div>
        <div class="tool-card">
            <h3>📖 Vocabulary Mini Booklet</h3>
            <p>Turn up to 100 vocabulary terms into a folded, self-paced student booklet.</p>
            <a href="/teaching-tools/vocabulary-booklet/vocabulary-booklet.html" class="btn">Open Tool</a>
        </div>
        <div class="tool-card coming-soon">
            <h3>📚 Vocabulary Practice Tool</h3>
            <p>Coming Soon</p>
            <button class="btn" disabled>Open Tool</button>
        </div>
        <div class="tool-card coming-soon">
            <h3>✏️ Sentence Builder Tool</h3>
            <p>Coming Soon</p>
            <button class="btn" disabled>Open Tool</button>
        </div>
        <div class="tool-card coming-soon">
            <h3>📄 Worksheet Generator</h3>
            <p>Coming Soon</p>
            <button class="btn" disabled>Open Tool</button>
        </div>
    </section>

    <script src="/javascripts/account-coming-soon.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcode/1.5.3/qrcode.min.js"></script>
    <script>
        // Removed QR generator functionality as it's now on a separate page
    </script>
    <script>
        (function () {
            var search = document.getElementById('toolSearch');
            var status = document.getElementById('toolSearchStatus');
            var cards = Array.prototype.slice.call(document.querySelectorAll('.tools-grid .tool-card'));

            function updateToolResults() {
                var query = search.value.trim().toLocaleLowerCase();
                var matches = 0;

                cards.forEach(function (card) {
                    var isMatch = !query || card.textContent.toLocaleLowerCase().indexOf(query) !== -1;
                    card.hidden = !isMatch;
                    if (isMatch) matches += 1;
                });

                if (!query) {
                    status.textContent = 'Showing all ' + cards.length + ' tools.';
                } else if (matches === 1) {
                    status.textContent = 'Showing 1 tool for “' + search.value.trim() + '”.';
                } else {
                    status.textContent = 'Showing ' + matches + ' tools for “' + search.value.trim() + '”.';
                }
            }

            search.addEventListener('input', updateToolResults);
        })();
    </script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
