<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/adsense') %>
    <title>Teaching Tools - Teacher Toolkit</title>
    <%- include('../partials/seo', { pageDescription: 'Discover practical classroom tools for teachers across subjects, including random groups, QR worksheets, spinners, question banks, and vocabulary resources.' }) %>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f8f9fa;
            color: #333;
            line-height: 1.6;
        }
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 40px 20px;
            text-align: center;
        }
        .header h1 {
            margin-bottom: 10px;
        }
        .tool-search {
            width: min(650px, calc(100% - 40px));
            margin: 30px auto -14px;
        }
        .tool-search label {
            display: block;
            margin: 0 0 8px;
            color: #194f45;
            font-weight: 800;
        }
        .tool-search-input {
            position: relative;
        }
        .tool-search-input span {
            position: absolute;
            top: 50%;
            left: 15px;
            transform: translateY(-50%);
            color: #356e57;
            pointer-events: none;
        }
        .tool-search input {
            width: 100%;
            padding: 13px 16px 13px 42px;
            font-size: 1rem;
        }
        .tool-search-status {
            min-height: 1.6em;
            margin: 7px 0 0;
            color: #5d7168;
            font-size: .9rem;
        }
        .tool-card[hidden] {
            display: none;
        }
        .tool-sections {
            padding: 34px 20px 48px;
        }
        .tool-section {
            max-width: 1200px;
            margin: 0 auto 46px;
            scroll-margin-top: 24px;
        }
        .tool-section[hidden] {
            display: none;
        }
        .tool-section-heading {
            max-width: 760px;
            margin-bottom: 18px;
        }
        .tool-section-heading h2 {
            margin: 0 0 6px;
            color: #2f3f77;
        }
        .tool-section-heading p {
            margin: 0;
            color: #5d7168;
        }
        .back-btn {
            position: absolute;
            top: 20px;
            left: 20px;
            background-color: rgba(255, 255, 255, 0.2);
            border: 1px solid white;
            color: white;
            padding: 10px 15px;
            text-decoration: none;
            border-radius: 5px;
        }
        .tools-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 20px;
            padding: 0;
        }
        .tool-card {
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            text-align: center;
            transition: transform 0.3s;
        }
        .tool-card:not(.coming-soon):hover {
            transform: translateY(-5px);
        }
        .tool-card h3 {
            color: #667eea;
            margin-bottom: 15px;
        }
        .tool-card p {
            margin-bottom: 20px;
        }
        .tool-scope { display: inline-block; margin: 0 0 12px !important; padding: 4px 9px; border-radius: 999px; background: #edf5df; color: #356e57; font-size: .75rem; font-weight: 800; }
        .btn {
            background-color: #667eea;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            text-decoration: none;
            display: inline-block;
        }
        .btn:hover {
            background-color: #5a67d8;
        }
        .coming-soon {
            opacity: 0.6;
        }
        .coming-soon .btn {
            background-color: #a8acb9;
            cursor: not-allowed;
        }
        .qr-generator {
            max-width: 600px;
            margin: 20px auto;
            padding: 20px;
            background: white;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            display: none;
        }
        .qr-generator input {
            width: 100%;
            padding: 10px;
            margin-bottom: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
        }
        .qr-output {
            margin-top: 20px;
            text-align: center;
        }
        @media (max-width: 768px) {
            .tools-grid {
                grid-template-columns: 1fr;
            }
            .tool-sections {
                padding-inline: 16px;
            }
        }
    </style>
    <link rel="stylesheet" href="/stylesheets/site-theme.css">
</head>
