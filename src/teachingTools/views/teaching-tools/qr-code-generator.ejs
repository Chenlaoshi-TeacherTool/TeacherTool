<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QR Worksheet Generator - Teacher Toolkit</title>
    <%- include('../partials/seo', { pageDescription: 'Turn classroom links, prompts, and text into easy-to-print QR code worksheets.' }) %>

    <style>
        body { margin: 0; padding: 0; }
        .header { padding: 58px 20px 52px; text-align: center; }
        .header h1 { margin: 0 0 10px; }
        .header p { max-width: 700px; margin: 0 auto; }
        .back-btn { position: absolute; top: 20px; left: 20px; padding: 10px 15px; text-decoration: none; }

        .qr-workspace { width: min(1080px, calc(100% - 32px)); margin: 34px auto 54px; }
        .qr-builder { position: relative; overflow: hidden; border: 1px solid #dcd6c5; border-radius: 24px; background: #fffdf7; box-shadow: 0 18px 40px rgba(24, 66, 55, .13); }
        .qr-builder::before { position: absolute; top: 0; left: 0; width: 100%; height: 7px; content: ''; background: linear-gradient(90deg, #f8c63f, #f3dc81 46%, #6f9e72); }
        .qr-builder__header { display: flex; align-items: center; gap: 16px; padding: 25px 28px 21px; border-bottom: 1px solid #e8e1cf; background: linear-gradient(110deg, #fffdf7, #f5f9ec); }
        .qr-builder__icon { display: grid; flex: 0 0 auto; place-items: center; width: 54px; height: 54px; border: 1px solid #efd171; border-radius: 16px; background: #fff1b8; font-size: 1.65rem; box-shadow: 0 6px 14px rgba(111, 82, 17, .1); }
        .qr-builder__heading { min-width: 0; }
        .qr-builder__eyebrow { margin: 0 0 2px; color: #a64638; font-size: .73rem; font-weight: 900; letter-spacing: .12em; text-transform: uppercase; }
        .qr-builder__heading h2 { margin: 0; color: #194f45; font-family: 'DM Serif Display', 'Noto Sans SC', serif; font-size: clamp(1.55rem, 3vw, 2rem); font-weight: 400; line-height: 1.15; }
        .qr-builder__heading p { margin: 5px 0 0; color: #5d7168; font-size: .94rem; }
        .qr-count { flex: 0 0 auto; margin-left: auto; padding: 7px 11px; border: 1px solid #d4e1c4; border-radius: 999px; background: #edf5df; color: #356e57; font-size: .78rem; font-weight: 900; white-space: nowrap; }
        .qr-count.has-error { border-color: #e8b6ae; background: #fff0ec; color: #a14538; }

        .qr-builder__body { display: grid; grid-template-columns: minmax(0, 1fr) 285px; gap: 22px; padding: 26px 28px 28px; }
        .qr-input-panel label { display: block; margin: 0 0 5px; color: #193d38; font-weight: 900; }
        .qr-field-hint { margin: 0 0 11px; color: #64766f; font-size: .86rem; }
        .qr-builder #batch-input { display: block; width: 100%; min-height: 230px; padding: 16px 17px; resize: vertical; border-color: #cbd8c2 !important; border-radius: 15px !important; background: #fffef9; font: 600 .93rem/1.65 'Nunito', 'Noto Sans SC', sans-serif; }
        .qr-builder #batch-input::placeholder { color: #99a59d; font-weight: 600; }
        .qr-input-footer { display: flex; align-items: center; justify-content: space-between; gap: 14px; margin-top: 10px; }
        .qr-input-note { margin: 0; color: #6b7a73; font-size: .78rem; }
        .qr-text-action { padding: 6px 8px; border: 0; background: transparent; color: #356e57; cursor: pointer; font: inherit; font-size: .8rem; font-weight: 900; text-decoration: underline; text-underline-offset: 3px; }
        .qr-text-action:hover { color: #194f45; }
        .qr-text-action:focus-visible { outline: 3px solid rgba(248, 198, 63, .42); outline-offset: 2px; border-radius: 7px; }

        .qr-format-guide { align-self: stretch; padding: 20px; border: 1px solid #d7e4c8; border-radius: 18px; background: #f3f8e9; }
        .qr-format-guide__label { display: inline-flex; align-items: center; gap: 6px; margin: 0 0 10px; color: #356e57; font-size: .72rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
        .qr-format-guide h3 { margin: 0; color: #194f45; font-family: 'DM Serif Display', 'Noto Sans SC', serif; font-size: 1.35rem; font-weight: 400; }
        .qr-format-guide > p { margin: 7px 0 14px; color: #5d7168; font-size: .85rem; line-height: 1.55; }
        .qr-format-example { display: block; overflow-wrap: anywhere; padding: 11px 12px; border: 1px dashed #b7cbaa; border-radius: 12px; background: #fffdf7; color: #254f44; font: 700 .78rem/1.55 ui-monospace, SFMono-Regular, Consolas, monospace; }
        .qr-format-guide ol { margin: 16px 0 0; padding-left: 20px; color: #536b62; font-size: .8rem; line-height: 1.65; }
        .qr-format-guide li + li { margin-top: 5px; }

        .qr-builder__footer { display: flex; align-items: center; gap: 12px; padding: 19px 28px 22px; border-top: 1px solid #e8e1cf; background: #fffaf0; }
        .qr-action { min-height: 46px; padding: 10px 18px; border: 1px solid transparent; border-radius: 13px; cursor: pointer; font: inherit; font-size: .9rem; font-weight: 900; transition: transform .16s ease, box-shadow .16s ease, background-color .16s ease; }
        .qr-action:hover:not(:disabled) { transform: translateY(-2px); }
        .qr-action--primary { background: #c9503f; box-shadow: 0 5px 0 #9d392f; color: white; }
        .qr-action--primary:hover { background: #d75d49; box-shadow: 0 7px 0 #9d392f; }
        .qr-action--secondary { border-color: #cbdac2; background: #fffdf7; color: #194f45; }
        .qr-action--secondary:hover:not(:disabled) { border-color: #86aa7d; background: #edf5df; }
        .qr-action:disabled { cursor: not-allowed; opacity: .45; }
        .qr-action:focus-visible { outline: 3px solid rgba(248, 198, 63, .48); outline-offset: 3px; }
        .qr-status { min-height: 22px; margin: 0 0 0 auto; color: #5d7168; font-size: .82rem; font-weight: 700; text-align: right; }
        .qr-status.is-success { color: #2e6b50; }
        .qr-status.is-error { color: #a14538; }

        .worksheet { margin-top: 32px; }
        .worksheet[hidden] { display: none; }
        .worksheet-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin: 0 2px 16px; }
        .worksheet-heading h2 { margin: 0; color: #194f45; font-family: 'DM Serif Display', 'Noto Sans SC', serif; font-size: 1.8rem; font-weight: 400; }
        .worksheet-heading p { margin: 0; color: #64766f; font-size: .83rem; }
        .worksheet-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; }

        .qr-item {
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 18px;
            background: white;
            box-shadow: 0 2px 5px rgba(0,0,0,0.06);
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .qr-item .item-title {
            display: block;
            font-weight: bold;
            color: #2d3748;
            margin-bottom: 14px;
            text-decoration: none;
            text-align: center;
        }

        .qr-item .item-title:hover { text-decoration: underline; }

        .qr-item .qrcode-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            max-width: 200px;
            margin: 10px 0 0;
            padding: 12px;
            background: #fff;
            border-radius: 8px;
        }

        @media (max-width: 760px) {
            .qr-builder__body { grid-template-columns: 1fr; }
            .qr-format-guide { padding: 17px; }
            .qr-builder__footer { align-items: stretch; flex-wrap: wrap; }
            .qr-status { flex-basis: 100%; order: -1; margin: 0; text-align: left; }
        }

        @media (max-width: 520px) {
            .qr-workspace { width: min(100% - 20px, 1080px); margin-top: 20px; }
            .qr-builder { border-radius: 18px; }
            .qr-builder__header { align-items: flex-start; flex-wrap: wrap; padding: 21px 18px 17px; }
            .qr-builder__icon { width: 46px; height: 46px; border-radius: 14px; font-size: 1.35rem; }
            .qr-count { width: 100%; margin: 0; text-align: center; }
            .qr-builder__body { padding: 20px 18px; }
            .qr-builder #batch-input { min-height: 210px; padding: 14px; }
            .qr-input-footer { align-items: flex-start; flex-direction: column; gap: 4px; }
            .qr-builder__footer { padding: 17px 18px 20px; }
            .qr-action { width: 100%; }
            .worksheet-heading { align-items: flex-start; flex-direction: column; gap: 4px; }
        }

        @media print {
            body { background: white; }
            .header, .back-btn, .qr-builder, .worksheet-heading, .tool-learning-guide { display: none !important; }
            .qr-workspace { width: 100%; margin: 0; }
            .worksheet { display: block !important; margin: 0; }
            .worksheet-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
            .qr-item { page-break-inside: avoid; }
        }
    </style>
    <link rel="stylesheet" href="/stylesheets/site-theme.css">
</head>

<body>

<a href="/teaching-tools" class="back-btn">← Back to Teaching Tools</a>

<section class="header">
    <h1>QR Worksheet Generator</h1>
    <p>Paste a list of "Title - URL" pairs to generate a printable QR code worksheet in bulk.</p>
</section>

<main class="qr-workspace">
    <section class="qr-builder" aria-labelledby="qr-builder-title">
        <header class="qr-builder__header">
            <span class="qr-builder__icon" aria-hidden="true">🔗</span>
            <div class="qr-builder__heading">
                <p class="qr-builder__eyebrow">One Step · Add your titles and links</p>
                <h2 id="qr-builder-title">Build a classroom QR worksheet</h2>
                <p>Paste several resources at once, then generate a clean printable set.</p>
            </div>
            <span class="qr-count" id="link-count" aria-live="polite">0 links ready</span>
        </header>

        <div class="qr-builder__body">
            <div class="qr-input-panel">
                <label for="batch-input">Resource titles and URLs</label>
                <p class="qr-field-hint" id="batch-input-help">Add one resource per line using <strong>Title - URL</strong>.</p>
                <textarea id="batch-input" aria-describedby="batch-input-help" spellcheck="false" placeholder="Weather video - https://example.com/weather&#10;Lab directions - https://example.com/lab&#10;Family survey - https://example.com/survey"></textarea>
                <div class="qr-input-footer">
                    <p class="qr-input-note">Links beginning with http:// or https:// work best.</p>
                    <button class="qr-text-action" id="use-example" type="button">Use an example</button>
                </div>
            </div>

            <aside class="qr-format-guide" aria-label="Input format help">
                <p class="qr-format-guide__label"><span aria-hidden="true">✦</span> Quick format</p>
                <h3>Keep each line simple</h3>
                <p>The title appears above the QR code. The full link stays clickable in the Word export.</p>
                <code class="qr-format-example">Station 1 - https://example.com/task</code>
                <ol>
                    <li>Write a short student-facing title.</li>
                    <li>Add a space, hyphen, and another space.</li>
                    <li>Paste the complete destination URL.</li>
                </ol>
            </aside>
        </div>

        <div class="qr-builder__footer">
            <button class="qr-action qr-action--primary" id="generate-worksheet" type="button">✨ Generate worksheet</button>
            <button class="qr-action qr-action--secondary" id="export-word" type="button" disabled>⬇ Export to Word</button>
            <button class="qr-text-action" id="clear-builder" type="button">Clear</button>
            <p class="qr-status" id="print-help" role="status" aria-live="polite">Add at least one correctly formatted link to begin.</p>
        </div>
    </section>

    <section class="worksheet" id="worksheet" aria-labelledby="worksheet-title" hidden>
        <div class="worksheet-heading">
            <h2 id="worksheet-title">Worksheet preview</h2>
            <p>QR codes and titles will be included in your Word download.</p>
        </div>
        <div class="worksheet-grid" id="worksheet-grid"></div>
    </section>
</main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

<script>
const batchInput = document.getElementById('batch-input');
const linkCount = document.getElementById('link-count');
const statusMessage = document.getElementById('print-help');
const generateButton = document.getElementById('generate-worksheet');
const exportButton = document.getElementById('export-word');
const worksheet = document.getElementById('worksheet');

function parseBatchLine(line) {
    const match = line.match(/^(.+?)\s+-\s+(https?:\/\/\S+)\s*$/i);
    if (!match) return null;

    try {
        const parsedUrl = new URL(match[2]);
        if (!['http:', 'https:'].includes(parsedUrl.protocol)) return null;
        return { title: match[1].trim(), url: parsedUrl.href };
    } catch (error) {
        return null;
    }
}

function getBatchStats(value) {
    const lines = value.split('\n').map(line => line.trim()).filter(Boolean);
    const items = lines.map(parseBatchLine).filter(Boolean);
    return { lines, items, invalidCount: lines.length - items.length };
}

function parseBatchText(value) {
    return getBatchStats(value).items;
}

function setBuilderStatus(message, tone = '') {
    statusMessage.textContent = message;
    statusMessage.className = 'qr-status' + (tone ? ` is-${tone}` : '');
}

function updateInputSummary() {
    const stats = getBatchStats(batchInput.value);
    linkCount.classList.toggle('has-error', stats.invalidCount > 0);

    if (!stats.lines.length) {
        linkCount.textContent = '0 links ready';
        setBuilderStatus('Add at least one correctly formatted link to begin.');
    } else if (stats.invalidCount) {
        linkCount.textContent = `${stats.items.length} ready · ${stats.invalidCount} to fix`;
        setBuilderStatus(`${stats.invalidCount} ${stats.invalidCount === 1 ? 'line needs' : 'lines need'} the format Title - https://...`, 'error');
    } else {
        linkCount.textContent = `${stats.items.length} ${stats.items.length === 1 ? 'link' : 'links'} ready`;
        setBuilderStatus(`Ready to generate ${stats.items.length} QR ${stats.items.length === 1 ? 'code' : 'codes'}.`);
    }

    generateButton.disabled = !stats.items.length || stats.invalidCount > 0;
}

function clearWorksheet() {
    document.getElementById('worksheet-grid').innerHTML = '';
    worksheet.hidden = true;
    exportButton.disabled = true;
}

function generateWorksheet() {
    const stats = getBatchStats(batchInput.value);
    const items = stats.items;

    if (!items.length || stats.invalidCount) {
        setBuilderStatus('Check each line and use the format Title - https://...', 'error');
        batchInput.focus();
        return;
    }

    clearWorksheet();

    const grid = document.getElementById('worksheet-grid');

    items.forEach(item => {
        const card = document.createElement('div');
        card.className = 'qr-item';

        const titleLink = document.createElement('a');
        titleLink.className = 'item-title';
        titleLink.href = item.url;
        titleLink.target = '_blank';
        titleLink.innerText = item.title;

        const wrapper = document.createElement('div');
        const qr = document.createElement('div');

        wrapper.className = 'qrcode-wrapper';
        wrapper.appendChild(qr);

        card.appendChild(titleLink);
        card.appendChild(wrapper);
        grid.appendChild(card);

        new QRCode(qr, { text: item.url, width: 170, height: 170 });
    });

    worksheet.hidden = false;
    exportButton.disabled = false;
    setBuilderStatus(`${items.length} QR ${items.length === 1 ? 'code is' : 'codes are'} ready to export.`, 'success');
    worksheet.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function exportToWord() {
    const grid = document.getElementById('worksheet-grid');
    if (!grid.innerHTML.trim()) {
        setBuilderStatus('Generate the QR worksheet before exporting.', 'error');
        return;
    }

    const items = Array.from(grid.querySelectorAll('.qr-item'));

    let rows = '';
    let row = [];

    items.forEach((item, i) => {
        const title = item.querySelector('.item-title').innerText;
        const url = item.querySelector('.item-title').href;
        const img = item.querySelector('canvas')?.toDataURL('image/png') || '';

        row.push(`
            <td style="width:25%;text-align:center;padding:10px;">
                <a href="${url}" style="font-weight:bold;display:block;margin-bottom:8px;">
                    ${title}
                </a>
                ${img ? `<img src="${img}" width="120"/>` : ''}
            </td>
        `);

        if (row.length === 4 || i === items.length - 1) {
            rows += `<tr>${row.join('')}</tr>`;
            row = [];
        }
    });

    const html = `
    <html>
    <head><meta charset="UTF-8"></head>
    <body>
        <table>${rows}</table>
    </body>
    </html>`;

    const blob = new Blob(['\ufeff', html], { type: 'application/msword' });
    const a = document.createElement('a');
    const objectUrl = URL.createObjectURL(blob);
    a.href = objectUrl;
    a.download = 'qr-worksheet.doc';
    a.hidden = true;
    document.body.appendChild(a);
    a.click();
    setTimeout(() => {
        a.remove();
        URL.revokeObjectURL(objectUrl);
    }, 1000);
    setBuilderStatus('Your Word worksheet download is ready.', 'success');
}

batchInput.addEventListener('input', function () {
    clearWorksheet();
    updateInputSummary();
});

document.getElementById('use-example').addEventListener('click', function () {
    batchInput.value = [
        'Teaching tools - https://clsteachingtools.com/teaching-tools',
        'Teaching resources - https://clsteachingtools.com/resources',
        'Contact Chen Laoshi - https://clsteachingtools.com/contact'
    ].join('\n');
    clearWorksheet();
    updateInputSummary();
    batchInput.focus();
});

document.getElementById('clear-builder').addEventListener('click', function () {
    batchInput.value = '';
    clearWorksheet();
    updateInputSummary();
    batchInput.focus();
});

generateButton.addEventListener('click', generateWorksheet);
exportButton.addEventListener('click', exportToWord);
updateInputSummary();
</script>
<%- include('../partials/tool-guide', { toolGuide: toolGuide }) %>
<script src="/javascripts/account-coming-soon.js"></script>
<script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
