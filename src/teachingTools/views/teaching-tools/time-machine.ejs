<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#3CB371">
  <title>时间机器 · Time Machine - Teacher Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'A Chinese date and time practice tool: spin to a random year, month, day, weekday and clock time, then ask and answer questions like 现在几点 and 今天星期几.' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/teaching-tools/time-machine/time-machine.css?v=1">
</head>
<body class="tm-page">

<audio id="sndFlip" src="/teaching-tools/time-machine/sounds/flip.wav" preload="auto"></audio>
<audio id="sndMachine" src="/teaching-tools/time-machine/sounds/machine.wav" preload="auto" loop></audio>
<audio id="sndDing" src="/teaching-tools/time-machine/sounds/ding.wav" preload="auto"></audio>

<main class="tm-wrap">
  <a class="tm-back" href="/teaching-tools">← <%= lang === 'zh' ? '返回教学工具' : 'Back to Teaching Tools' %></a>

  <header>
    <h1>⏳ 时间机器 <span>Time Machine</span></h1>
    <p class="tm-subtitle">按下 Start，穿越到一个随机的时间！</p>
  </header>

  <section class="tm-machine" aria-live="polite">
    <div class="tm-card tm-date-card" data-part="year">
      <div class="tm-card-label">年份</div>
      <div class="tm-flip"><div class="tm-flip-face" id="yearVal">2026</div></div>
    </div>
    <div class="tm-card tm-date-card" data-part="month">
      <div class="tm-card-label">月份</div>
      <div class="tm-flip"><div class="tm-flip-face" id="monthVal">10月</div></div>
    </div>
    <div class="tm-card tm-date-card" data-part="day">
      <div class="tm-card-label">日期</div>
      <div class="tm-flip"><div class="tm-flip-face" id="dayVal">4日</div></div>
    </div>
    <div class="tm-card tm-date-card" data-part="week">
      <div class="tm-card-label">星期</div>
      <div class="tm-flip"><div class="tm-flip-face" id="weekVal">星期日</div></div>
    </div>
    <div class="tm-card tm-clock-card" data-part="time">
      <div class="tm-card-label">时间</div>
      <svg class="tm-clock" viewBox="0 0 200 200" aria-label="钟面">
        <circle cx="100" cy="100" r="94" fill="#fff" stroke="#E5E5E5" stroke-width="3"/>
        <circle cx="100" cy="100" r="88" fill="#F8FAF9"/>
        <g id="ticks"></g>
        <g id="numbers" font-size="15" font-weight="700" fill="#1F2937" text-anchor="middle" dominant-baseline="central"></g>
        <g class="tm-hand" id="hourHand">
          <line x1="100" y1="112" x2="100" y2="54" stroke="#1F2937" stroke-width="7" stroke-linecap="round"/>
        </g>
        <g class="tm-hand" id="minuteHand">
          <line x1="100" y1="116" x2="100" y2="28" stroke="#3CB371" stroke-width="4.5" stroke-linecap="round"/>
        </g>
        <circle cx="100" cy="100" r="6" fill="#1F2937"/>
        <circle cx="100" cy="100" r="2.5" fill="#3CB371"/>
      </svg>
    </div>
  </section>

  <section class="tm-card tm-panel">
    <div class="tm-row">
      <label class="tm-field">变化模式
        <select id="modeSelect">
          <option value="all">全部</option>
          <option value="year">年份</option>
          <option value="month">月份</option>
          <option value="day">日期</option>
          <option value="week">星期</option>
          <option value="time">时间</option>
        </select>
      </label>
      <label class="tm-field">问题
        <select id="questionSelect">
          <option value="random">随机问题</option>
        </select>
      </label>
      <button class="tm-btn-ghost" id="muteBtn" type="button">🔊 音效：开</button>
    </div>

    <div class="tm-row">
      <button class="tm-btn tm-big" id="startBtn" type="button">Start</button>
      <button class="tm-btn" id="questionBtn" type="button">Show Question</button>
      <button class="tm-btn" id="answerBtn" type="button">Show Answer</button>
    </div>

    <textarea id="customQuestion" placeholder="自定义问题（选填）：例如“你的生日是几月几号？” —— 填写后 Show Question 会显示这个问题"></textarea>
    <p class="tm-hint">提示：按空格键也可以启动时间机器。</p>
  </section>

  <section class="tm-card tm-qa">
    <div class="tm-qa-placeholder" id="qaPlaceholder">按 Show Question 显示问题</div>
    <div class="tm-qa-question" id="qaQuestion" hidden></div>
    <div class="tm-qa-answer" id="qaAnswer" hidden></div>
  </section>
</main>

<script src="/teaching-tools/time-machine/time-machine.js?v=1"></script>
<script src="/javascripts/account-coming-soon.js"></script>
<script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
