<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#216c5a">
  <title>Classroom Noise Monitor - Teacher Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'A large classroom projection noise monitor that listens locally in the browser and reacts when the room gets too loud.' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/teaching-tools/classroom-noise-monitor/classroom-noise-monitor.css?v=noise-monitor-2">
</head>
<body class="noise-page">
  <main class="noise-shell">
    <a class="noise-back" href="/teaching-tools"><%= t('noiseMonitor.backBtn') %></a>

    <section class="noise-stage" aria-labelledby="noiseTitle">
      <div class="noise-copy">
        <p class="noise-eyebrow"><%= t('noiseMonitor.eyebrow') %></p>
        <h1 id="noiseTitle"><%= t('noiseMonitor.title') %></h1>
        <p><%= t('noiseMonitor.subtitle') %></p>
      </div>

      <div id="noiseIndicator" class="traffic-light" data-state="green" aria-live="polite">
        <div class="traffic-light__lamp traffic-light__lamp--green" data-light="green" aria-hidden="true"></div>
        <div class="traffic-light__lamp traffic-light__lamp--yellow" data-light="yellow" aria-hidden="true"></div>
        <div class="traffic-light__lamp traffic-light__lamp--red" data-light="red" aria-hidden="true"></div>
        <p id="noiseState" class="noise-state"><%= t('noiseMonitor.quietState') %></p>
        <strong id="volumeReadout">0</strong>
      </div>

      <div class="noise-controls" aria-label="Noise monitor controls">
        <button id="toggleMonitor" class="noise-button" type="button"><%= t('noiseMonitor.startButton') %></button>
        <label class="threshold-control" for="threshold">
          <span><%= t('noiseMonitor.thresholdLabel') %></span>
          <strong id="thresholdReadout">55</strong>
          <input id="threshold" type="range" min="1" max="100" value="55">
        </label>
        <p id="monitorStatus" class="monitor-status" role="status"><%= t('noiseMonitor.readyStatus') %></p>
      </div>
    </section>

    <audio id="shhAudio" preload="auto"></audio>
  </main>

  <script src="/teaching-tools/classroom-noise-monitor/classroom-noise-monitor.js?v=noise-monitor-2"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
