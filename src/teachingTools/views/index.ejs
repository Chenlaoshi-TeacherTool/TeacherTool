<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="google-site-verification" content="hK7TpxV7vuEkO3PJkUcMAsZw4VzaJJk7XY9cJeCKsM0">
    <meta name="p:domain_verify" content="057c200cb06638cab9f48b2815b646ee"/>
    <%- include('partials/adsense') %>
    <meta name="theme-color" content="#194f45">
    <title>Chen Laoshi's Teaching Toolkit · 陈老师教学工具</title>
    <%- include('partials/seo', { pageDescription: 'Practical classroom tools, adaptable teaching activities, and thoughtful resources for educators across subjects. 陈老师教学工具：中文教学、汉字练习、词汇活动与可打印课堂资源。' }) %>
    <link rel="stylesheet" href="/stylesheets/site-theme.css">
    <link rel="stylesheet" href="/stylesheets/tool-snapshots.css?v=1">
    <link rel="stylesheet" href="/shared/tool-favorites.css?v=2">
    <style>
        .home-hero {
            position: relative;
            overflow: hidden;
            isolation: isolate;
            padding: 40px 20px 40px;
            background: linear-gradient(135deg, var(--chalk-deep) 0%, var(--chalk) 56%, #39745a 100%);
            color: var(--cream);
        }
        .home-hero::before,
        .home-hero::after {
            position: absolute;
            z-index: -1;
            content: '';
            border-radius: 50%;
            border: 2px solid rgba(255, 249, 233, 0.18);
        }
        .home-hero::before { width: 520px; height: 520px; top: -355px; right: -80px; }
        .home-hero::after { width: 240px; height: 240px; bottom: -175px; left: 7%; }
        .hero-content {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(220px, .6fr);
            align-items: center;
            gap: 44px;
            max-width: 1060px;
            margin: 0 auto;
        }
        .hero-copy { max-width: 610px; }
        .hero-title-row { display: flex; align-items: center; gap: 0; }
        .hero-avatar-mini { display: none; }
        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 14px;
            padding: 7px 14px;
            border: 1px solid rgba(255, 249, 233, .44);
            border-radius: 999px;
            background: rgba(255, 255, 255, .08);
            color: #ffe49a;
            font-weight: 800;
            letter-spacing: .03em;
        }
        .hero-copy h1 {
            max-width: 580px;
            margin: 0;
            color: var(--paper);
            font-family: 'DM Serif Display', 'Noto Sans SC', serif;
            font-size: clamp(2.4rem, 5vw, 4.2rem);
            font-weight: 400;
            letter-spacing: -.035em;
            line-height: .98;
        }
        .hero-copy h1 span { display: block; color: var(--sun); font-family: 'Inter Variable', Arial, sans-serif; font-size: .45em; font-weight: 400; letter-spacing: .04em; line-height: 1.3; }
        .hero-copy p { max-width: 550px; margin: 18px 0 0; color: rgba(255, 253, 247, .86); font-size: 1.05rem; }
        /* Keep these routes ready for later, without promoting sections that are still growing. */
        .hero-buttons { display: none; }
        .hero-buttons .btn { padding: 12px 19px; }
        .hero-buttons .btn-secondary {
            border-color: rgba(255, 249, 233, .62) !important;
            background: rgba(255, 253, 247, .10) !important;
            box-shadow: none;
        }
        .hero-buttons .btn-secondary:hover { background: rgba(255, 253, 247, .20) !important; box-shadow: none; }
        .hero-avatar-wrap {
            position: relative;
            justify-self: center;
            width: min(230px, 60vw);
            padding: 12px;
        }
        .hero-avatar-wrap::before {
            position: absolute;
            inset: 14% -2% 5%;
            z-index: -1;
            content: '';
            border-radius: 50%;
            background: var(--sun);
            filter: blur(1px);
            transform: rotate(8deg);
        }
        .hero-avatar-wrap::after {
            position: absolute;
            top: 13%;
            right: -4%;
            width: 57px;
            height: 57px;
            content: '✦';
            color: var(--sun);
            font-size: 3rem;
            line-height: 57px;
            text-align: center;
            transform: rotate(13deg);
        }
        .teacher-avatar { position: relative; overflow: hidden; border: 6px solid #fff6db; border-radius: 50%; background: var(--chalk); box-shadow: 0 0 0 7px var(--sun), 0 19px 35px rgba(8, 45, 38, .35); }
        .teacher-avatar img { display: block; width: 100%; height: auto; }
        .home-paths-section { padding: 68px 20px 74px; }
        .home-paths-shell { max-width: 1160px; margin: 0 auto; }
        .home-paths-header { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(280px, .7fr); gap: 48px; align-items: end; }
        .home-paths-header .eyebrow { margin-bottom: 15px; border-color: var(--leaf-line); background: var(--leaf-wash); color: var(--leaf); }
        .home-paths-header h2 { max-width: 720px; margin: 0; color: var(--chalk); font-family: 'DM Serif Display', 'Noto Sans SC', serif; font-size: clamp(2.35rem, 4.4vw, 3.65rem); font-weight: 400; letter-spacing: -.02em; line-height: 1.06; }
        .home-paths-header > p { margin: 0 0 5px; color: var(--muted); font-size: 1.03rem; line-height: 1.75; }
        .home-tools-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; margin-top: 34px; }
        .home-tool-card { position: relative; display: flex; flex-direction: column; gap: 8px; padding: 22px; border: 1px solid var(--line); border-radius: 18px; background: var(--paper); box-shadow: 0 8px 20px rgba(24, 66, 55, .08); text-decoration: none; color: inherit; transition: transform .15s ease, box-shadow .15s ease; }
        .home-tool-card:hover { transform: translateY(-4px); box-shadow: 0 14px 26px rgba(24, 66, 55, .14); }
        .home-tool-card__icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 13px; background: var(--leaf-wash); font-size: 1.4rem; }
        .home-tool-card h3 { margin: 0; color: var(--chalk); font-family: 'DM Serif Display', 'Noto Sans SC', serif; font-size: 1.1rem; font-weight: 400; line-height: 1.25; }
        .home-tool-card p { margin: 0; color: var(--muted); font-size: .9rem; line-height: 1.55; }
        .home-tools-more { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 26px; }
        .home-tools-more .btn-secondary { background: var(--paper); color: var(--chalk); border: 1px solid #cbdac2; box-shadow: none; }
        .home-tool-card__link { display: flex; flex: 1; flex-direction: column; color: inherit; text-decoration: none; }
        .home-tool-card__link:focus-visible { outline: 3px solid #bb952e; outline-offset: 5px; border-radius: 12px; }
        .home-tool-card .fresh-badge { align-self: flex-start; margin: -6px 0 10px; }
        .home-fav-hint { margin: 18px 0 0; color: var(--muted); font-size: .95rem; }
        .home-newest { margin-top: 56px; }
        .home-newest .eyebrow { margin-bottom: 12px; border-color: var(--leaf-line); background: var(--leaf-wash); color: var(--leaf); }
        .home-newest h2 { margin: 0; color: var(--chalk); font-family: 'DM Serif Display', 'Noto Sans SC', serif; font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 400; }
        .home-newest-intro { margin: 8px 0 0; color: var(--muted); }
        .home-newest-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; margin-top: 22px; }
        .home-newest-card { border: 1px solid var(--line); border-radius: 18px; background: var(--paper); box-shadow: 0 6px 16px rgba(24, 66, 55, .07); transition: transform .15s ease, box-shadow .15s ease; }
        .home-newest-card:hover { transform: translateY(-3px); box-shadow: 0 12px 24px rgba(24, 66, 55, .12); }
        .home-newest-card > a { display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 18px 20px 20px; color: inherit; text-decoration: none; border-radius: 18px; }
        .home-newest-card > a:focus-visible { outline: 3px solid #bb952e; outline-offset: 3px; }
        .home-newest-icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 13px; background: var(--leaf-wash); font-size: 1.4rem; }
        .home-newest-meta { color: var(--muted); font-size: .8rem; }
        .home-newest-card h3 { margin: 0; padding-right: 30px; color: var(--chalk); font-family: 'DM Serif Display', 'Noto Sans SC', serif; font-size: 1.1rem; font-weight: 400; line-height: 1.3; }
        .home-newest-card p { display: -webkit-box; margin: 0; overflow: hidden; color: var(--muted); font-size: .88rem; line-height: 1.55; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
        @media (max-width: 1000px) { .home-newest-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        @media (max-width: 520px) { .home-newest-grid { grid-template-columns: 1fr; } }
        @media (prefers-reduced-motion: reduce) { .home-newest-card { transition: none; } .home-newest-card:hover { transform: none; } }
        .home-chinese { background: var(--leaf-wash); }
        .eyebrow.eyebrow--sun { border-color: #f1d58c; background: #fff2c5; color: #8a5b15; }
        .home-finds-heading { font-size: clamp(2rem, 4vw, 3rem); }
        .home-paths-about { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 30px; padding: 17px 22px; border: 1px dashed #cbdac2; border-radius: 16px; color: var(--muted); }
        .home-paths-about strong { color: var(--chalk); }
        .home-paths-about a { flex: 0 0 auto; color: #a63f34; font-weight: 900; text-decoration: none; }
        .home-paths-about a:hover { color: #7d2d26; }
        .featured { position: relative; overflow: hidden; padding: 64px 20px 70px; background: var(--leaf-wash); text-align: center; }
        /* Reserved for future teacher testimonials. */
        .featured { display: none; }
        .featured::before { position: absolute; top: -16px; left: 6%; content: '✷'; color: var(--sun); font-size: 5rem; opacity: .75; }
        .featured h2 { position: relative; margin: 0 0 28px; color: var(--chalk); font-family: 'DM Serif Display', 'Noto Sans SC', serif; font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 400; }
        .featured-items { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; max-width: 1050px; margin: 0 auto; }
        .featured-item { padding: 26px; text-align: left; }
        .featured-item:nth-child(1) { border-top: 6px solid var(--sun) !important; }
        .featured-item:nth-child(2) { border-top: 6px solid var(--coral) !important; }
        .featured-item:nth-child(3) { border-top: 6px solid var(--leaf-light) !important; }
        .featured-item h3 { margin: 0 0 8px; color: var(--chalk); font-family: 'DM Serif Display', 'Noto Sans SC', serif; font-size: 1.35rem; }
        .featured-item p { margin: 0; color: var(--muted); }
        .grade-nav { padding: 48px 20px 58px; border: 0; background: var(--cream); text-align: center; }
        .grade-nav h3 { margin: 0 0 18px; color: var(--chalk); font-family: 'DM Serif Display', 'Noto Sans SC', serif; font-size: 1.65rem; font-weight: 400; }
        .grade-buttons { gap: 10px; }
        .grade-btn { border: 1px solid #cbdac2; border-radius: 999px; background: var(--paper); color: var(--leaf); font-family: inherit; font-weight: 800; transition: transform .15s ease, background-color .15s ease; }
        .grade-btn:hover { transform: translateY(-2px); background: var(--leaf); color: white; }
        .feedback-section {
            max-width: 1120px;
            margin: 0 auto;
            padding: 54px 20px 60px;
        }
        .feedback-copy { max-width: 560px; padding: 24px 0; }
        .feedback-copy .eyebrow { margin-bottom: 15px; border-color: var(--leaf-line); background: var(--leaf-wash); color: var(--leaf); }
        .feedback-copy h2 { margin: 0; color: var(--chalk); font-family: 'DM Serif Display', 'Noto Sans SC', serif; font-size: clamp(2rem, 3.6vw, 2.8rem); font-weight: 400; line-height: 1.08; }
        .feedback-copy p { max-width: 390px; margin: 16px 0 0; color: var(--muted); line-height: 1.65; }
        .feedback-note { display: inline-flex; align-items: center; gap: 9px; margin-top: 20px; padding: 10px 14px; border: 1px solid var(--leaf-line); border-radius: 999px; background: var(--paper); color: var(--leaf); font-size: .82rem; font-weight: 800; text-decoration: none; transition: transform .15s ease, border-color .15s ease, background-color .15s ease; }
        .feedback-note:hover { transform: translateY(-2px); border-color: var(--leaf-light); background: var(--leaf-wash); }
        .feedback-note span { font-size: 1rem; }
        footer { padding: 25px 20px; }
        footer p { margin: 0; }
        footer a { color: #fff2c5; font-weight: 800; }
        footer a:hover { color: var(--paper); }
        @media (min-width: 821px) {
            .home-hero { padding: 36px 20px; }
            .hero-content { gap: 32px; }
            .hero-avatar-wrap { width: min(200px, 60vw); padding: 8px; }
        }
        @media (max-width: 820px) { .hero-content { grid-template-columns: 1fr; gap: 24px; text-align: center; } .hero-copy { margin: 0 auto; } .hero-buttons { justify-content: center; } .hero-avatar-wrap { display: none; } .hero-title-row { justify-content: center; gap: 12px; } .hero-avatar-mini { display: block; flex-shrink: 0; width: 46px; height: 46px; overflow: hidden; border: 2px solid #fff6db; border-radius: 50%; box-shadow: 0 0 0 3px var(--sun); } .hero-avatar-mini img { display: block; width: 100%; height: 100%; object-fit: cover; } .home-paths-header, .featured-items, .feedback-section { grid-template-columns: 1fr; max-width: 540px; margin-right: auto; margin-left: auto; } .home-tools-grid { grid-template-columns: repeat(2, 1fr); max-width: 540px; margin-right: auto; margin-left: auto; } .feedback-section { padding-top: 46px; padding-bottom: 52px; } .feedback-copy { padding-top: 0; } }
        @media (max-width: 520px) { .home-hero { padding: 22px 16px 44px; } .home-paths-section { padding: 50px 16px 54px; } .home-paths-header { gap: 18px; } .home-tools-grid { grid-template-columns: 1fr; margin-top: 26px; } .home-paths-about { align-items: flex-start; flex-direction: column; gap: 8px; } .featured { padding: 49px 16px; } }
    </style>
</head>
<body>
    <!-- Impact-Site-Verification: 65267fd0-0a53-4615-8961-483203ad4f9c -->
    <main id="main">
    <section class="home-hero">
        <div class="hero-content">
            <div class="hero-copy">
                <div class="hero-title-row">
                    <span class="hero-avatar-mini" aria-hidden="true"><img src="/images/chen-laoshi-logo-96.webp" width="96" height="91" alt=""></span>
                    <h1><%= t('home.heroTitleLine1') %><br><%= t('home.heroTitleLine2') %><span><%= t('home.heroTitleTagline') %></span></h1>
                </div>
                <p><%= t('home.heroIntro') %></p>
                <div class="hero-buttons">
                    <a href="/theme-activities" class="btn"><%= t('home.heroExploreActivities') %></a>
                    <a href="/teaching-tools" class="btn btn-secondary"><%= t('home.heroOpenTools') %></a>
                </div>
            </div>
            <div class="hero-avatar-wrap">
                <div class="teacher-avatar">
                    <img src="/images/chen-laoshi-logo-480.webp" width="480" height="453" alt="Chen Laoshi holding a book, surrounded by sunflowers and classroom supplies">
                </div>
            </div>
        </div>
    </section>

    <section class="home-paths-section" aria-labelledby="home-paths-heading">
        <div class="home-paths-shell">
            <%# Signed-in teachers with favorites see "My favorite tools" here instead (script at the end of the page). %>
            <header class="home-paths-header" id="homeToolsHeader"
                data-fav-eyebrow="<%= t('home.myToolsEyebrow') %>" data-fav-heading="<%= t('home.myToolsHeading') %>" data-fav-intro="<%= t('home.myToolsIntro') %>">
                <div>
                    <div class="eyebrow" id="homeToolsEyebrow"><%= t('home.pathsEyebrow') %></div>
                    <h2 id="home-paths-heading"><%= t('home.pathsHeading') %></h2>
                </div>
                <p id="homeToolsIntro"><%= t('home.pathsIntro') %></p>
            </header>
            <p class="home-fav-hint" id="homeFavHint" hidden>☆ <%= t('home.favHint') %></p>

            <div class="home-tools-grid" id="tools" data-popular-badge="<%= t('home.popularBadge') %>" data-open-label="<%= t('teachingToolsIndex.openTool') %>">
                <% popularTools.forEach(function(tool) { %>
                <div class="home-tool-card snapshot-card" data-fav-ref="<%= tool.href %>" data-popular>
                    <a class="home-tool-card__link" href="<%= tool.href %>">
                        <%- include('partials/tool-snapshot', { previewHref: tool.href }) %>
                        <h3><%= t(tool.titleKey) %></h3>
                        <p><%= t(tool.descKey) %></p>
                        <span class="btn" aria-hidden="true"><%= t('teachingToolsIndex.openTool') %> →</span>
                    </a>
                </div>
                <% }); %>
            </div>

            <div class="home-tools-more">
                <a href="/teaching-tools" class="btn"><%= t('home.browseAll') %></a>
                <a href="/teaching-tools/teacher-library/teacher-library.html#favorites" class="btn btn-secondary" id="homeManageFavorites" hidden><%= t('home.manageFavorites') %></a>
            </div>

            <section class="home-newest" aria-labelledby="home-newest-heading">
                <div class="eyebrow"><%= t('home.newestEyebrow') %></div>
                <h2 id="home-newest-heading"><%= t('home.newestHeading') %></h2>
                <p class="home-newest-intro"><%= t('home.newestIntro') %></p>
                <div class="home-newest-grid">
                    <% newestTools.forEach(function(tool) { %>
                    <div class="home-newest-card" data-fav-ref="<%= tool.href %>">
                        <a href="<%= tool.href %>">
                            <span class="home-newest-icon" aria-hidden="true"><%= tool.icon || '✨' %></span>
                            <span class="home-newest-meta"><span class="fresh-badge fresh-badge--<%= tool.fresh %>"><%= t(tool.fresh === 'updated' ? 'home.freshUpdated' : 'home.freshNew') %></span> <time datetime="<%= tool.freshDate %>"><%= tool.freshDate.slice(5).replace('-', '/') %></time></span>
                            <h3><%= t(tool.titleKey) %></h3>
                            <p><%= tool.fresh === 'updated' && tool.updated ? (lang === 'zh' ? tool.updated.zh : tool.updated.en) : t(tool.descKey) %></p>
                        </a>
                    </div>
                    <% }); %>
                </div>
            </section>

            <div class="home-paths-about">
                <span><strong><%= t('home.newHereStrong') %></strong> <%= t('home.newHereText') %></span>
                <a href="/about"><%= t('home.meetChenLaoshi') %></a>
            </div>
        </div>
    </section>

    <section class="content-section home-chinese" aria-labelledby="chinese-teaching-title">
      <div class="content-shell">
        <h2 id="chinese-teaching-title"><%= lang === 'zh' ? '中文教学专区' : 'Chinese Teaching' %></h2>
        <p><%= lang === 'zh' ? '为中文课堂准备的识字、书写、词汇、句型和教材配套资源。' : 'Character recognition, writing, vocabulary, sentence patterns, and textbook resources for Chinese classrooms.' %></p>
        <a class="btn" href="/chinese-teaching"><%= lang === 'zh' ? '按教学任务查找资源' : 'Browse by teaching task' %> →</a>
      </div>
    </section>

    <section class="content-section" aria-labelledby="home-recommendations-heading">
        <div class="content-shell recommendation-feature">
            <div>
                <div class="eyebrow eyebrow--sun"><%= t('home.findsEyebrow') %></div>
                <h2 id="home-recommendations-heading" class="home-finds-heading"><%= t('home.findsHeading') %></h2>
                <p><%= t('home.findsIntro') %></p>
                <a class="btn" href="/classroom-finds"><%= t('home.findsCta') %></a>
            </div>
            <aside class="affiliate-note">
                <h2><%= t('home.affiliateHeading') %></h2>
                <p><%= t('home.affiliateNote') %></p>
                <a href="https://amzn.to/4qpPByl" target="_blank" rel="sponsored nofollow noopener noreferrer"><%= t('home.affiliateCta') %></a>
            </aside>
        </div>
    </section>


    <section class="featured">
        <h2><%= t('home.deskHeading') %></h2>
        <div class="featured-items">
            <article class="featured-item">
                <h3><%= t('home.desk1Title') %></h3>
                <p><%= t('home.desk1Desc') %></p>
            </article>
            <article class="featured-item">
                <h3><%= t('home.desk2Title') %></h3>
                <p><%= t('home.desk2Desc') %></p>
            </article>
            <article class="featured-item">
                <h3><%= t('home.desk3Title') %></h3>
                <p><%= t('home.desk3Desc') %></p>
            </article>
        </div>
    </section>

    <section class="feedback-section" id="feedback" aria-labelledby="feedback-heading">
        <div class="feedback-copy">
            <div class="eyebrow"><%= t('home.feedbackEyebrow') %></div>
            <h2 id="feedback-heading"><%= t('home.feedbackHeading') %></h2>
            <p><%= t('home.feedbackIntro') %></p>
            <a class="feedback-note" href="/feedback"><%= t('home.feedbackCta') %> <span aria-hidden="true">→</span></a>
        </div>
    </section>
    </main>

    <footer>
        <p><%- t('footer.home') %></p>
    </footer>
    <script type="application/json" id="homeToolCards"><%- toolCardsJson %></script>
    <script src="/javascripts/account-coming-soon.js"></script>
    <script src="/shared/tool-favorites.js?v=2"></script>
    <script src="/javascripts/home-favorites.js?v=1"></script>
    <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
