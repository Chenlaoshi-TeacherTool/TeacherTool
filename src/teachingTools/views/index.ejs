<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="google-site-verification" content="hK7TpxV7vuEkO3PJkUcMAsZw4VzaJJk7XY9cJeCKsM0">
    <%- include('partials/adsense') %>
    <meta name="theme-color" content="#194f45">
    <title>Chen Laoshi's Teaching Toolkit</title>
    <%- include('partials/seo', { pageDescription: 'Practical classroom tools, adaptable teaching activities, and thoughtful resources for educators across subjects.' }) %>
    <link rel="stylesheet" href="/stylesheets/site-theme.css">
    <style>
        .home-hero {
            position: relative;
            overflow: hidden;
            isolation: isolate;
            padding: 40px 20px 40px;
            background: linear-gradient(135deg, #103e37 0%, #194f45 56%, #39745a 100%);
            color: #fff9e9;
        }
        .home-hero::before,
        .home-hero::after {
            position: absolute;
            z-index: -1;
            content: '';
            border-radius: 50%;
            border: 2px solid rgba(255, 249, 233, 0.18);
        }
        .home-hero::before { width: 520px; height: 520px; top: -355px; right: -80px; }
        .home-hero::after { width: 240px; height: 240px; bottom: -175px; left: 7%; }
        .hero-content {
            display: grid;
            grid-template-columns: minmax(0, 1fr) minmax(220px, .6fr);
            align-items: center;
            gap: 44px;
            max-width: 1060px;
            margin: 0 auto;
        }
        .hero-copy { max-width: 610px; }
        .hero-title-row { display: flex; align-items: center; gap: 0; }
        .hero-avatar-mini { display: none; }
        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 14px;
            padding: 7px 14px;
            border: 1px solid rgba(255, 249, 233, .44);
            border-radius: 999px;
            background: rgba(255, 255, 255, .08);
            color: #ffe49a;
            font-weight: 800;
            letter-spacing: .03em;
        }
        .hero-copy h1 {
            max-width: 580px;
            margin: 0;
            color: #fffdf7;
            font-family: 'DM Serif Display', 'Noto Sans SC', serif;
            font-size: clamp(2.4rem, 5vw, 4.2rem);
            font-weight: 400;
            letter-spacing: -.035em;
            line-height: .98;
        }
        .hero-copy h1 span { display: block; color: #f8c63f; font-family: 'Inter Variable', Arial, sans-serif; font-size: .45em; font-weight: 400; letter-spacing: .04em; line-height: 1.3; }
        .hero-copy p { max-width: 550px; margin: 18px 0 0; color: rgba(255, 253, 247, .86); font-size: 1.05rem; }
        /* Keep these routes ready for later, without promoting sections that are still growing. */
        .hero-buttons { display: none; }
        .hero-buttons .btn { padding: 12px 19px; }
        .hero-buttons .btn-secondary {
            border-color: rgba(255, 249, 233, .62) !important;
            background: rgba(255, 253, 247, .10) !important;
            box-shadow: none;
        }
        .hero-buttons .btn-secondary:hover { background: rgba(255, 253, 247, .20) !important; box-shadow: none; }
        .hero-avatar-wrap {
            position: relative;
            justify-self: center;
            width: min(230px, 60vw);
            padding: 12px;
        }
        .hero-avatar-wrap::before {
            position: absolute;
            inset: 14% -2% 5%;
            z-index: -1;
            content: '';
            border-radius: 50%;
            background: #f8c63f;
            filter: blur(1px);
            transform: rotate(8deg);
        }
        .hero-avatar-wrap::after {
            position: absolute;
            top: 13%;
            right: -4%;
            width: 57px;
            height: 57px;
            content: '✦';
            color: #f8c63f;
            font-size: 3rem;
            line-height: 57px;
            text-align: center;
            transform: rotate(13deg);
        }
        .teacher-avatar { position: relative; overflow: hidden; border: 6px solid #fff6db; border-radius: 50%; background: #194f45; box-shadow: 0 0 0 7px #f8c63f, 0 19px 35px rgba(8, 45, 38, .35); }
        .teacher-avatar img { display: block; width: 100%; height: auto; }
        .teacher-avatar::after { position: absolute; right: 11%; bottom: 5%; content: 'Chen Laoshi'; color: #194f45; font-family: 'Inter Variable', Arial, sans-serif; font-size: .72rem; font-weight: 900; letter-spacing: .04em; }
        .home-paths-section { padding: 68px 20px 74px; }
        .home-paths-shell { max-width: 1160px; margin: 0 auto; }
        .home-paths-header { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(280px, .7fr); gap: 48px; align-items: end; }
        .home-paths-header .eyebrow { margin-bottom: 15px; border-color: #d7e3c7; background: #edf5df; color: #356e57; }
        .home-paths-header h2 { max-width: 720px; margin: 0; color: #194f45; font-family: 'DM Serif Display', 'Noto Sans SC', serif; font-size: clamp(2.35rem, 4.4vw, 3.65rem); font-weight: 400; letter-spacing: -.02em; line-height: 1.06; }
        .home-paths-header > p { margin: 0 0 5px; color: #5d7168; font-size: 1.03rem; line-height: 1.75; }
        .home-tools-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; margin-top: 34px; }
        .home-tool-card { position: relative; display: flex; flex-direction: column; gap: 8px; padding: 22px; border: 1px solid #e5ddc9; border-radius: 18px; background: #fffdf7; box-shadow: 0 8px 20px rgba(24, 66, 55, .08); text-decoration: none; color: inherit; transition: transform .15s ease, box-shadow .15s ease; }
        .home-tool-card:hover { transform: translateY(-4px); box-shadow: 0 14px 26px rgba(24, 66, 55, .14); }
        .home-tool-card__icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 13px; background: #edf5df; font-size: 1.4rem; }
        .home-tool-card h3 { margin: 0; color: #194f45; font-family: 'DM Serif Display', 'Noto Sans SC', serif; font-size: 1.1rem; font-weight: 400; line-height: 1.25; }
        .home-tool-card p { margin: 0; color: #5d7168; font-size: .9rem; line-height: 1.55; }
        .home-tools-more { display: flex; justify-content: center; margin-top: 26px; }
        .home-paths-about { display: flex; align-items: center; justify-content: space-between; gap: 24px; margin-top: 30px; padding: 17px 22px; border: 1px dashed #cbdac2; border-radius: 16px; color: #5d7168; }
        .home-paths-about strong { color: #194f45; }
        .home-paths-about a { flex: 0 0 auto; color: #a63f34; font-weight: 900; text-decoration: none; }
        .home-paths-about a:hover { color: #7d2d26; }
        .featured { position: relative; overflow: hidden; padding: 64px 20px 70px; background: #edf5df; text-align: center; }
        /* Reserved for future teacher testimonials. */
        .featured { display: none; }
        .featured::before { position: absolute; top: -16px; left: 6%; content: '✷'; color: #f8c63f; font-size: 5rem; opacity: .75; }
        .featured h2 { position: relative; margin: 0 0 28px; color: #194f45; font-family: 'DM Serif Display', 'Noto Sans SC', serif; font-size: clamp(2rem, 4vw, 2.8rem); font-weight: 400; }
        .featured-items { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; max-width: 1050px; margin: 0 auto; }
        .featured-item { padding: 26px; text-align: left; }
        .featured-item:nth-child(1) { border-top: 6px solid #f8c63f !important; }
        .featured-item:nth-child(2) { border-top: 6px solid #c9503f !important; }
        .featured-item:nth-child(3) { border-top: 6px solid #6f9e72 !important; }
        .featured-item h3 { margin: 0 0 8px; color: #194f45; font-family: 'DM Serif Display', 'Noto Sans SC', serif; font-size: 1.35rem; }
        .featured-item p { margin: 0; color: #5d7168; }
        .shop-preview { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .85fr); max-width: 1080px; margin: 0 auto; overflow: hidden; border: 1px solid #e5ddc9; border-radius: 24px; background: #fffdf7; box-shadow: 0 12px 28px rgba(24, 66, 55, .11); }
        .shop-preview-copy { padding: 42px; }
        .shop-preview .eyebrow { margin-bottom: 14px; border-color: #f1d58c; background: #fff2c5; color: #8a5b15; }
        .shop-preview h2 { margin: 0; color: #194f45; font-family: 'DM Serif Display', 'Noto Sans SC', serif; font-size: clamp(2rem, 3.6vw, 2.8rem); font-weight: 400; line-height: 1.08; }
        .shop-preview p { max-width: 520px; margin: 15px 0 22px; color: #5d7168; line-height: 1.65; }
        .shop-preview img { width: 100%; height: 100%; min-height: 320px; object-fit: cover; object-position: center; }
        .shop-preview .shop-note { margin: 15px 0 0; color: #7c651f; font-size: .85rem; font-weight: 800; }
        .grade-nav { padding: 48px 20px 58px; border: 0; background: #fff9e9; text-align: center; }
        .grade-nav h3 { margin: 0 0 18px; color: #194f45; font-family: 'DM Serif Display', 'Noto Sans SC', serif; font-size: 1.65rem; font-weight: 400; }
        .grade-buttons { gap: 10px; }
        .grade-btn { border: 1px solid #cbdac2; border-radius: 999px; background: #fffdf7; color: #356e57; font-family: inherit; font-weight: 800; transition: transform .15s ease, background-color .15s ease; }
        .grade-btn:hover { transform: translateY(-2px); background: #356e57; color: white; }
        .feedback-section {
            max-width: 1120px;
            margin: 0 auto;
            padding: 54px 20px 60px;
        }
        .feedback-copy { max-width: 560px; padding: 24px 0; }
        .feedback-copy .eyebrow { margin-bottom: 15px; border-color: #d7e3c7; background: #edf5df; color: #356e57; }
        .feedback-copy h2 { margin: 0; color: #194f45; font-family: 'DM Serif Display', 'Noto Sans SC', serif; font-size: clamp(2rem, 3.6vw, 2.8rem); font-weight: 400; line-height: 1.08; }
        .feedback-copy p { max-width: 390px; margin: 16px 0 0; color: #5d7168; line-height: 1.65; }
        .feedback-note { display: inline-flex; align-items: center; gap: 9px; margin-top: 20px; padding: 10px 14px; border: 1px solid #d7e3c7; border-radius: 999px; background: #fffdf7; color: #356e57; font-size: .82rem; font-weight: 800; text-decoration: none; transition: transform .15s ease, border-color .15s ease, background-color .15s ease; }
        .feedback-note:hover { transform: translateY(-2px); border-color: #6f9e72; background: #edf5df; }
        .feedback-note span { font-size: 1rem; }
        footer { padding: 25px 20px; }
        footer p { margin: 0; }
        footer a { color: #fff2c5; font-weight: 800; }
        footer a:hover { color: #fffdf7; }
        @media (min-width: 821px) {
            .home-hero { padding: 36px 20px; }
            .hero-content { gap: 32px; }
            .hero-avatar-wrap { width: min(200px, 60vw); padding: 8px; }
        }
        @media (max-width: 820px) { .hero-content { grid-template-columns: 1fr; gap: 24px; text-align: center; } .hero-copy { margin: 0 auto; } .hero-buttons { justify-content: center; } .hero-avatar-wrap { display: none; } .hero-title-row { justify-content: center; gap: 12px; } .hero-avatar-mini { display: block; flex-shrink: 0; width: 46px; height: 46px; overflow: hidden; border: 2px solid #fff6db; border-radius: 50%; box-shadow: 0 0 0 3px #f8c63f; } .hero-avatar-mini img { display: block; width: 100%; height: 100%; object-fit: cover; } .home-paths-header, .featured-items, .feedback-section, .shop-preview { grid-template-columns: 1fr; max-width: 540px; margin-right: auto; margin-left: auto; } .home-tools-grid { grid-template-columns: repeat(2, 1fr); max-width: 540px; margin-right: auto; margin-left: auto; } .shop-preview-copy { padding: 32px; } .shop-preview img { min-height: 245px; max-height: 320px; } .feedback-section { padding-top: 46px; padding-bottom: 52px; } .feedback-copy { padding-top: 0; } }
        @media (max-width: 520px) { .home-hero { padding: 22px 16px 44px; } .home-paths-section { padding: 50px 16px 54px; } .home-paths-header { gap: 18px; } .home-tools-grid { grid-template-columns: 1fr; margin-top: 26px; } .home-paths-about { align-items: flex-start; flex-direction: column; gap: 8px; } .featured { padding: 49px 16px; } .shop-preview { margin: 0 16px; } .shop-preview-copy { padding: 28px; } }
    </style>
</head>
<body>
    <!-- Impact-Site-Verification: 65267fd0-0a53-4615-8961-483203ad4f9c -->
    <section class="home-hero">
        <div class="hero-content">
            <div class="hero-copy">
                <div class="hero-title-row">
                    <span class="hero-avatar-mini" aria-hidden="true"><img src="/images/chen-laoshi-logo.svg" alt=""></span>
                    <h1><%= t('home.heroTitleLine1') %><br><%= t('home.heroTitleLine2') %><span><%= t('home.heroTitleTagline') %></span></h1>
                </div>
                <p><%= t('home.heroIntro') %></p>
                <div class="hero-buttons">
                    <a href="/theme-activities" class="btn"><%= t('home.heroExploreActivities') %></a>
                    <a href="/teaching-tools" class="btn btn-secondary"><%= t('home.heroOpenTools') %></a>
                </div>
            </div>
            <div class="hero-avatar-wrap">
                <div class="teacher-avatar">
                    <img src="/images/chen-laoshi-logo.svg" alt="Chen Laoshi holding a book, surrounded by sunflowers and classroom supplies">
                </div>
            </div>
        </div>
    </section>

    <main class="home-paths-section" aria-labelledby="home-paths-heading">
        <div class="home-paths-shell">
            <header class="home-paths-header">
                <div>
                    <div class="eyebrow"><%= t('home.pathsEyebrow') %></div>
                    <h2 id="home-paths-heading"><%= t('home.pathsHeading') %></h2>
                </div>
                <p><%= t('home.pathsIntro') %></p>
            </header>

            <div class="home-tools-grid" id="tools">
                <a class="home-tool-card" href="/teaching-tools/random-group-generator">
                    <span class="home-tool-card__icon" aria-hidden="true">🎲</span>
                    <h3><%= t('home.tool1Title') %></h3>
                    <p><%= t('home.tool1Desc') %></p>
                </a>
                <a class="home-tool-card" href="/teaching-tools/qr-code-generator">
                    <span class="home-tool-card__icon" aria-hidden="true">🔗</span>
                    <h3><%= t('home.tool2Title') %></h3>
                    <p><%= t('home.tool2Desc') %></p>
                </a>
                <a class="home-tool-card" href="/teaching-tools/class-pet-points">
                    <span class="home-tool-card__icon" aria-hidden="true">🐾</span>
                    <h3><%= t('home.tool3Title') %></h3>
                    <p><%= t('home.tool3Desc') %></p>
                </a>
                <a class="home-tool-card" href="/teaching-tools/sunflower-spinner/sunflower-spinner.html">
                    <span class="home-tool-card__icon" aria-hidden="true">🌻</span>
                    <h3><%= t('home.tool4Title') %></h3>
                    <p><%= t('home.tool4Desc') %></p>
                </a>
                <a class="home-tool-card" href="/teaching-tools/jeopardy">
                    <span class="home-tool-card__icon" aria-hidden="true">🏆</span>
                    <h3><%= t('home.tool5Title') %></h3>
                    <p><%= t('home.tool5Desc') %></p>
                </a>
                <a class="home-tool-card" href="/teaching-tools/bingo-generator">
                    <span class="home-tool-card__icon" aria-hidden="true">🎯</span>
                    <h3><%= t('home.tool6Title') %></h3>
                    <p><%= t('home.tool6Desc') %></p>
                </a>
                <a class="home-tool-card" href="/teaching-tools/maze-generator">
                    <span class="home-tool-card__icon" aria-hidden="true">🧭</span>
                    <h3><%= t('home.tool7Title') %></h3>
                    <p><%= t('home.tool7Desc') %></p>
                </a>
                <a class="home-tool-card" href="/teaching-tools/word-cloud">
                    <span class="home-tool-card__icon" aria-hidden="true">☁️</span>
                    <h3><%= t('home.tool8Title') %></h3>
                    <p><%= t('home.tool8Desc') %></p>
                </a>
            </div>

            <div class="home-tools-more">
                <a href="/teaching-tools" class="btn"><%= t('home.browseAll') %></a>
            </div>

            <div class="home-paths-about">
                <span><strong><%= t('home.newHereStrong') %></strong> <%= t('home.newHereText') %></span>
                <a href="/about"><%= t('home.meetChenLaoshi') %></a>
            </div>
        </div>
    </main>

    <section class="content-section" aria-labelledby="home-recommendations-heading">
        <div class="content-shell recommendation-feature">
            <div>
                <div class="eyebrow" style="border-color:#f1d58c; background:#fff2c5; color:#8a5b15;"><%= t('home.findsEyebrow') %></div>
                <h2 id="home-recommendations-heading" style="font-size:clamp(2rem,4vw,3rem);"><%= t('home.findsHeading') %></h2>
                <p><%= t('home.findsIntro') %></p>
                <a class="btn" href="/recommendations"><%= t('home.findsCta') %></a>
            </div>
            <aside class="affiliate-note">
                <h2><%= t('home.affiliateHeading') %></h2>
                <p><%= t('home.affiliateNote') %></p>
                <a href="https://amzn.to/4qpPByl" target="_blank" rel="sponsored nofollow noopener noreferrer"><%= t('home.affiliateCta') %></a>
            </aside>
        </div>
    </section>

    <section class="shop-preview" aria-labelledby="shop-preview-heading">
        <div class="shop-preview-copy">
            <div class="eyebrow"><%= t('home.shopEyebrow') %></div>
            <h2 id="shop-preview-heading"><%= t('home.shopHeading') %></h2>
            <p><%= t('home.shopIntro') %></p>
            <a href="/classroom-shop" class="btn"><%= t('home.shopCta') %></a>
            <p class="shop-note"><%= t('home.shopNote') %></p>
        </div>
        <img src="/images/magnetic-people-classroom.png" alt="Colorful magnetic people holding classroom artwork on a magnetic board">
    </section>

    <section class="featured">
        <h2><%= t('home.deskHeading') %></h2>
        <div class="featured-items">
            <article class="featured-item">
                <h3><%= t('home.desk1Title') %></h3>
                <p><%= t('home.desk1Desc') %></p>
            </article>
            <article class="featured-item">
                <h3><%= t('home.desk2Title') %></h3>
                <p><%= t('home.desk2Desc') %></p>
            </article>
            <article class="featured-item">
                <h3><%= t('home.desk3Title') %></h3>
                <p><%= t('home.desk3Desc') %></p>
            </article>
        </div>
    </section>

    <section class="feedback-section" id="feedback" aria-labelledby="feedback-heading">
        <div class="feedback-copy">
            <div class="eyebrow"><%= t('home.feedbackEyebrow') %></div>
            <h2 id="feedback-heading"><%= t('home.feedbackHeading') %></h2>
            <p><%= t('home.feedbackIntro') %></p>
            <a class="feedback-note" href="/feedback"><%= t('home.feedbackCta') %> <span aria-hidden="true">→</span></a>
        </div>
    </section>

    <footer>
        <p><%- t('footer.home') %></p>
    </footer>
    <script src="/javascripts/account-coming-soon.js"></script>
    <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
