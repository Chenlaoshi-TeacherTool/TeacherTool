<%- include('layout-head') %>
<h1>会员管理</h1>
<% var tab = typeof membershipTab !== 'undefined' ? membershipTab : 'teachers';
var listing = typeof directory !== 'undefined' ? directory : null;
var selectedKey = typeof selectedTeacher !== 'undefined' ? selectedTeacher : '';
function listLink(page, teacher) { var q = new URLSearchParams({ tab: 'teachers', email: listing ? listing.email : '', status: listing ? listing.status : 'all', page: String(page) }); if(teacher) q.set('teacher',teacher); return '/admin/memberships?' + q.toString(); }
%>
<nav class="membership-tabs" aria-label="会员管理分区">
<a href="/admin/memberships" <%- tab === 'teachers' ? 'aria-current="page"' : '' %>>老师账户</a>
<a href="/admin/memberships?tab=codes" <%- tab === 'codes' ? 'aria-current="page"' : '' %>>激活码管理</a>
<a href="/admin/memberships?tab=batches" <%- tab === 'batches' ? 'aria-current="page"' : '' %>>生成批次记录</a>
</nav>
<p>Each activation code extends a teacher's cloud saving once. New accounts get a 3-day trial automatically on first sign-in.</p>

<% if (created) { %>
  <div style="border:2px solid #16a34a;border-radius:6px;padding:14px;margin:16px 0;">
    <p><strong><%= created.codes.length %> code(s), <%= created.days %> days<%= created.label ? ' · ' + created.label : '' %>.</strong>
      Copy them now: only their hashes are stored, so this page cannot show them again.</p>
    <textarea id="newCodes" rows="<%= Math.min(created.codes.length, 12) %>" readonly style="font-family:monospace;"><%= created.codes.join('\n') %></textarea>
    <div class="actions"><button type="button" onclick="navigator.clipboard.writeText(document.getElementById('newCodes').value); this.textContent='Copied';">Copy codes</button></div>
  </div>
<% } %>

<% if (typeof revoked !== 'undefined' && revoked) { %>
  <div style="border:2px solid <%= revoked.outcome === 'revoked' ? '#16a34a' : '#dc2626' %>;border-radius:6px;padding:14px;margin:16px 0;">
    <% if (revoked.outcome === 'revoked' && revoked.wasUsed) { %>
      <p><strong>Code deactivated.</strong> It had been used, so <%= revoked.days %> days were taken back from that teacher's cloud saving<%= revoked.writeUntil ? ' (now until ' + new Date(revoked.writeUntil).toISOString().slice(0, 10) + ')' : '' %>.</p>
    <% } else if (revoked.outcome === 'revoked') { %>
      <p><strong>Code deactivated.</strong> Nobody had used it, and it can no longer be redeemed.</p>
    <% } else if (revoked.outcome === 'already') { %>
      <p>This code was already deactivated. Nothing changed.</p>
    <% } else { %>
      <p>No code matches what you entered. Check it and try again.</p>
    <% } %>
  </div>
<% } %>

<section <%= tab !== 'teachers' ? 'hidden' : '' %>>
<% var lookup = listing || (typeof search !== 'undefined' && search ? search : { email: '', teachers: null }); %>
<h2 style="font-size:1.1rem;">老师账户</h2>
<p>显示已建立账户的老师，包括试用及已到期账户。默认按注册时间从新到旧排列，时间以 UTC 显示。</p>
<form method="GET" action="/admin/memberships">
  <label for="teacherEmail">邮箱或姓名</label>
  <input id="teacherEmail" name="email" type="search" maxlength="320" value="<%= lookup.email %>" autocomplete="off">
  <label for="membershipStatus">权限状态</label><select id="membershipStatus" name="status"><% [['all','全部'],['trial','试用中'],['active','权限有效'],['expired','已到期 / 无有效权限']].forEach(function(option) { %><option value="<%= option[0] %>" <%= listing && listing.status === option[0] ? 'selected' : '' %>><%= option[1] %></option><% }); %></select>
  <div class="actions"><button type="submit">搜索</button><a href="/admin/memberships">清除筛选</a></div>
</form>
<% if (listing) { %><p>共 <%= listing.total %> 位老师 · 第 <%= listing.page %> / <%= listing.pages %> 页 · 每页 25 位</p><% } %>
<% if (lookup.teachers) { %>
  <% if (!lookup.teachers.length) { %>
    <p>没有符合条件的账户。No account matches “<%= lookup.email %>”。老师需要先在网站登录，才会出现在这里。</p>
  <% } else { %>
    <% var day = function (value) { return value ? new Date(value).toISOString().slice(0, 10) : '—'; }; %>
    <div class="table-scroll"><table>
      <thead><tr><th>邮箱</th><th>姓名</th><th>注册时间</th><th>最近登录</th><th>云端保存到期日</th><th>权限状态</th><th>操作</th></tr></thead>
      <tbody>
        <% lookup.teachers.forEach(function (teacher) { var active = teacher.writeUntil && new Date(teacher.writeUntil) > new Date(); %>
          <tr>
            <td><%= teacher.email || '未提供邮箱' %><% if(teacher.email) { %><br><button type="button" class="secondary" data-copy-email="<%= teacher.email %>">复制邮箱</button><% } %></td>
            <td><%= teacher.name || '' %></td>
            <td><%= day(teacher.createdAt) %></td>
            <td><%= day(teacher.lastSeenAt) %></td>
            <td><strong style="color:<%= active ? '#15803d' : '#b91c1c' %>"><%= day(teacher.writeUntil) %><%= teacher.writeUntil ? (active ? ' (active)' : ' (ended)') : '' %></strong></td>
            <td><%= { trial: '试用中', active: '权限有效', expired: '已到期 / 无有效权限' }[teacher.status] || (active ? '权限有效' : '已到期') %></td>
            <td><a href="<%= listLink(listing ? listing.page : 1, teacher.ownerKey) %>#teacher-details">查看详情</a><br><a href="/admin/memberships/<%= teacher.ownerKey %>/adjust">调整会员</a></td>
          </tr>
          <% if (!listing || selectedKey === teacher.ownerKey) { %>
          <tr id="teacher-details">
            <td colspan="7" style="background:#f8fafc;">
              <% var events = teacher.events || []; %>
              <% if (!events.length) { %>
                <span style="color:#64748b;">No membership changes recorded.</span>
              <% } else { %>
                <details open>
                  <summary>Membership history (<%= events.length %>)</summary>
                  <div class="table-scroll"><table style="margin-top:8px;">
                    <thead><tr><th>When (UTC)</th><th>Change</th><th>Days</th><th>Until before</th><th>Until after</th><th>By</th></tr></thead>
                    <tbody>
                      <% events.forEach(function (event) { %>
                        <tr>
                          <td><%= new Date(event.createdAt).toISOString().slice(0, 16).replace('T', ' ') %></td>
                          <td><%= event.kind === 'trial' ? 'Free trial' : event.kind === 'code' ? 'Activation code' : event.kind === 'refund' ? 'Refund (code deactivated)' : ({ extend:'手动激活 / 延长', set:'设置到期日期', stop:'立即停用' }[event.kind] || event.kind) %><%= event.batchLabel ? ' · ' + event.batchLabel : '' %><% if(event.reason) { %><br>原因：<%= event.reason %><% } %></td>
                          <td><%= event.days > 0 ? '+' + event.days : event.days %></td>
                          <td><%= event.untilBefore ? day(event.untilBefore) : '—' %></td>
                          <td><%= event.untilAfter ? day(event.untilAfter) : '—' %></td>
                          <td><%= event.actor || (event.kind === 'refund' ? 'admin' : 'teacher / site') %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table></div>
                </details>
              <% } %>
            </td>
          </tr>
          <% } %>
        <% }) %>
      </tbody>
    </table></div>
  <% } %>
<% } %>

<% if(listing) { %><nav class="actions" aria-label="老师列表分页"><% if(listing.page > 1) { %><a href="<%= listLink(listing.page - 1) %>">← 上一页</a><% } %><% if(listing.page < listing.pages) { %><a href="<%= listLink(listing.page + 1) %>">下一页 →</a><% } %></nav><% } %>
<p id="email-copy-status" role="status" aria-live="polite"></p>
</section>
<section <%= tab !== 'codes' ? 'hidden' : '' %>>
<h2 style="font-size:1.1rem;margin-top:28px;">Create codes</h2>
<form method="POST" action="/admin/memberships/codes">
  <label for="days">Plan</label>
  <select id="days" name="days" required>
    <% planDays.forEach(function (days) { %><option value="<%= days %>"><%= days %> days</option><% }) %>
  </select>
  <label for="count">Number of codes (1–100)</label>
  <input id="count" name="count" type="number" min="1" max="100" value="1" required>
  <label for="label">Note (optional, e.g. buyer email or order number)</label>
  <input id="label" name="label" type="text" maxlength="100">
  <div class="actions"><button type="submit">Create codes</button></div>
</form>

<h2 style="font-size:1.1rem;margin-top:28px;">Deactivate a code (refund)</h2>
<p>Enter the code you sent the teacher. If they already used it, its days are taken back from their cloud saving; if not, it simply stops working.</p>
<form method="POST" action="/admin/memberships/revoke" onsubmit="return confirm('Deactivate this code? This cannot be undone.');">
  <label for="revokeCode">Activation code</label>
  <input id="revokeCode" name="code" type="text" maxlength="30" placeholder="CLS-XXXX-XXXX-XXXX" autocomplete="off" required style="font-family:monospace;">
  <div class="actions"><button class="danger" type="submit">Deactivate code</button></div>
</form>

</section>
<section <%= tab !== 'batches' ? 'hidden' : '' %>>
<h2 style="font-size:1.1rem;margin-top:28px;">Recent batches</h2>
<% if (!batches.length) { %>
  <p>No codes yet.</p>
<% } else { %>
  <div class="table-scroll"><table>
    <thead><tr><th>Created (UTC)</th><th>Note</th><th>Days</th><th>Used / total</th><th>Deactivated</th></tr></thead>
    <tbody>
      <% batches.forEach(function (batch) { %>
        <tr><td><%= new Date(batch.created_at).toISOString().slice(0, 16).replace('T', ' ') %></td><td><%= batch.batch_label || '' %></td><td><%= batch.days %></td><td><%= batch.redeemed %> / <%= batch.total %></td><td><%= batch.revoked || 0 %></td></tr>
      <% }) %>
    </tbody>
  </table></div>
<% } %>
</section>
<script src="/javascripts/admin-memberships.js" defer></script>
<%- include('layout-foot') %>
