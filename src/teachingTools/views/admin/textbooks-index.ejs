<%- include('layout-head') %>
<h1>Textbooks</h1>
<p>
  <a class="button" href="/admin/textbooks/import">+ Import from Excel</a>
  <a class="button secondary" href="/admin/textbooks/export">Export all to Excel</a>
</p>
<p style="font-size:0.9rem;color:#444;">Lessons for the textbook companion pages. Export, edit in Excel, and import again to change many lessons at once, or open a book to edit one lesson.</p>

<% groups.forEach(function (group) { %>
<h2><%= group.series.zh %> <span style="font-weight:400;color:#666;font-size:0.9rem;"><%= group.series.en %> · <code><%= group.series.key %></code></span></h2>
<% if (!group.books.length) { %>
  <p style="color:#666;">No lessons yet. <a href="/admin/textbooks/lessons/new?series=<%= group.series.key %>">Add one</a> or import from Excel.</p>
<% } else { %>
<table>
  <thead><tr><th>Book</th><th>book_slug</th><th># Lessons</th><th># Words</th><th></th></tr></thead>
  <tbody>
    <% group.books.forEach(function (book) { %>
    <tr>
      <td><%= book.book_name %></td>
      <td><code><%= book.book_slug %></code></td>
      <td><%= book.lesson_count %></td>
      <td><%= book.word_count %></td>
      <td><a href="<%= bookPath(book.series, book.book_slug) %>">Open</a></td>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } %>
<% }) %>
<%- include('layout-foot') %>
