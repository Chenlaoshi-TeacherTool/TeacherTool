<%- include('layout-head') %>
<h1>Textbooks</h1>
<p>
  <a class="button" href="/admin/textbooks/new">+ 新增教材 / New textbook</a>
  <a class="button" href="/admin/textbooks/import">+ Import from Excel</a>
  <a class="button secondary" href="/admin/textbooks/export">Export all to Excel</a>
</p>
<p style="font-size:0.9rem;color:#444;">打开整本教材，统一管理课程目录、词汇、句子与附件；支持按课号批量粘贴词汇和句子。</p>

<% groups.forEach(function (group) { %>
<h2><%= group.series.zh %> <span style="font-weight:400;color:#666;font-size:0.9rem;"><%= group.series.en %> · <code><%= group.series.key %></code><%= group.series.membersOnly ? ' · members only' : '' %></span></h2>
<p><a class="button" href="/admin/textbooks/<%= group.series.key %>/books/new">+ 新增册数 / New book</a></p>
<% if (group.series.books) { %>
  <p style="font-size:0.9rem;color:#444;">Public pages: <a href="/textbook-companion/<%= group.series.key %>" target="_blank" rel="noopener">/textbook-companion/<%= group.series.key %></a>. Lessons must use these book slugs:
    <% group.series.books.forEach(function (book) { %><a href="<%= bookPath(group.series.key, book.slug) %>"><%= book.zh %></a> <code><%= book.slug %></code> <a href="/admin/textbooks/lessons/new?series=<%= group.series.key %>&book=<%= book.slug %>&book_name=<%= encodeURIComponent(book.zh) %>">+ 新增课次 / lesson</a> &nbsp; <% }) %></p>
<% } %>
<% if (!group.books.length) { %>
  <p style="color:#666;">暂无课程。请打开上方册数添加课程，或<a href="/admin/textbooks/import">从 Excel 导入</a>。</p>
<% } else { %>
<table>
  <thead><tr><th>Book</th><th>book_slug</th><th># Lessons</th><th># Words</th><th></th></tr></thead>
  <tbody>
    <% group.books.forEach(function (book) { %>
    <tr>
      <td><%= book.book_name %></td>
      <td><code><%= book.book_slug %></code></td>
      <td><%= book.lesson_count %></td>
      <td><%= book.word_count %></td>
      <td><a href="<%= bookPath(book.series, book.book_slug) %>">Open</a></td>
    </tr>
    <% }) %>
  </tbody>
</table>
<% } %>
<% }) %>
<%- include('layout-foot') %>
