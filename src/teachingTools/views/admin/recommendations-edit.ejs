<%- include('layout-head') %>
<h1><%= product ? 'Edit: ' + product.title : 'New Recommendation' %></h1>

<form method="POST" action="<%= (product && product.slug) ? '/admin/recommendations/' + encodeURIComponent(product.slug) : '/admin/recommendations/new' %>">
  <label>Slug (used internally, no spaces)</label>
  <input type="text" name="slug" value="<%= product ? product.slug : '' %>" <%= !isNew ? 'readonly' : 'required' %>>
  <label>Default title / 默认产品名称（未填写分语言名称时使用）</label>
  <input type="text" name="title" value="<%= product ? product.title : '' %>" required>
  <% var finds = product ? (product.classroomContent || {}) : {}; var categories = finds.categories || ['every-classroom']; %>
  <h2>Display categories / 展示分类</h2>
  <% [['every-classroom', 'For Every Classroom / 各学科通用'], ['chinese-class', 'For Chinese Class / 中文课堂精选']].forEach(function (entry) { %>
  <label><input type="checkbox" name="finds_categories" value="<%= entry[0] %>" <%= categories.includes(entry[0]) ? 'checked' : '' %>> <%= entry[1] %></label>
  <% }) %>
  <p>至少选择一个分类。同一件产品可以同时出现在两类中。每种语言未填写时使用另一种语言或原有产品内容。</p>
  <% ['zh', 'en'].forEach(function (language) { var content = finds[language] || {}; %>
  <fieldset>
    <legend><%= language === 'zh' ? '中文内容' : 'English content' %></legend>
    <% [['title', 'Product name / 产品名称', 1], ['summary', 'Card summary / 卡片简短介绍', 2], ['usage', 'How to use / 完整使用方法（可分段）', 6], ['general', 'Use across subjects / 各学科通用用法', 3], ['chinese', 'Use in Chinese class / 中文课堂用法', 3], ['video', 'YouTube link / 视频链接（可不填）', 1]].forEach(function (field) { %>
    <label for="finds_<%= field[0] %>_<%= language %>"><%= field[1] %></label>
    <% if (field[2] === 1) { %>
    <input id="finds_<%= field[0] %>_<%= language %>" type="<%= field[0] === 'video' ? 'url' : 'text' %>" name="finds_<%= field[0] %>_<%= language %>" value="<%= content[field[0]] || '' %>">
    <% } else { %>
    <textarea id="finds_<%= field[0] %>_<%= language %>" name="finds_<%= field[0] %>_<%= language %>" rows="<%= field[2] %>"><%= content[field[0]] || '' %></textarea>
    <% } %>
    <% }) %>
  </fieldset>
  <% }) %>
  <h2>Shared product details / 共用产品资料</h2>
  <label>Subtitle</label>
  <input type="text" name="subtitle" value="<%= product ? (product.subtitle || '') : '' %>">
  <label>Category / meta line</label>
  <input type="text" name="category" value="<%= product ? (product.category || '') : '' %>" placeholder="Find 02 · Classroom Organization">
  <label>Description</label>
  <textarea name="description" rows="4"><%= product ? (product.description || '') : '' %></textarea>
  <label>Image URL</label>
  <input type="text" name="image_url" value="<%= product ? (product.image_url || '') : '' %>" placeholder="/images/example.png">
  <label>Image alt text</label>
  <input type="text" name="image_alt" value="<%= product ? (product.image_alt || '') : '' %>">
  <label>Product URL</label>
  <input type="text" name="product_url" value="<%= product ? (product.product_url || '') : '' %>">
  <label>Button text</label>
  <input type="text" name="link_text" value="<%= product ? (product.link_text || '') : '' %>" placeholder="View this on Amazon →">
  <label>Link note / disclosure</label>
  <textarea name="link_note" rows="2"><%= product ? (product.link_note || '') : '' %></textarea>

  <h2>Why recommend it</h2>
  <% [1, 2, 3].forEach(function (index) { %>
    <label>Reason <%= index %> title</label>
    <input type="text" name="reason<%= index %>_title" value="<%= product ? product['reason' + index + '_title'] : '' %>">
    <label>Reason <%= index %> text</label>
    <textarea name="reason<%= index %>_text" rows="2"><%= product ? product['reason' + index + '_text'] : '' %></textarea>
  <% }) %>

  <h2>Classroom tip</h2>
  <label>Tip title</label>
  <input type="text" name="teacher_tip_title" value="<%= product ? (product.teacher_tip_title || '') : '' %>" placeholder="Classroom use tip:">
  <label>Tip text</label>
  <textarea name="teacher_tip" rows="3"><%= product ? (product.teacher_tip || '') : '' %></textarea>

  <h2>Printable label</h2>
  <label>Printable label URL</label>
  <input type="text" name="printable_label_url" value="<%= product ? (product.printable_label_url || '') : '' %>" placeholder="/pdf/cart-labels.pdf">
  <label>Printable label link text</label>
  <input type="text" name="printable_label_text" value="<%= product ? (product.printable_label_text || '') : '' %>" placeholder="Download matching drawer labels">
  <label>Printable label note</label>
  <textarea name="printable_label_note" rows="2"><%= product ? (product.printable_label_note || '') : '' %></textarea>

  <label>Sort order</label>
  <input type="text" name="sort_order" value="<%= product ? product.sort_order : '0' %>">
  <label><input type="checkbox" name="is_published" <%= !product || product.is_published ? 'checked' : '' %>> Published</label>

  <div class="actions">
    <button type="submit"><%= !isNew ? 'Save changes' : 'Create recommendation' %></button>
  </div>
</form>

<section id="companion-files">
  <h2>Companion downloads / 配套材料下载</h2>
  <p>上传与这件产品配套的标签、学习单或活动材料，老师可在产品使用说明弹窗和详情页免费下载。每次上传一个文件，可重复上传多个。</p>
  <% if (isNew) { %>
  <p>请先创建产品，再上传配套文件。 / Create the product first, then upload companion files.</p>
  <% } else { %>
  <% (product.companionFiles || []).forEach(function(file) { %>
  <div class="file-row">
    <strong><%= file.title %></strong> · <%= file.fileName %> (<%= (file.size / 1024 / 1024).toFixed(1) %> MB)
    <form method="POST" action="/admin/recommendations/<%= encodeURIComponent(product.slug) %>/files/<%= encodeURIComponent(file.blobName) %>/delete">
      <button type="submit" class="danger">Remove attachment / 移除附件</button>
    </form>
  </div>
  <% }) %>
  <form method="POST" enctype="multipart/form-data" action="/admin/recommendations/<%= encodeURIComponent(product.slug) %>/files">
    <label for="companion-title">Download title / 下载名称（可选）</label>
    <input id="companion-title" type="text" name="title" maxlength="200" placeholder="推车抽屉标签 / Cart drawer labels">
    <label for="companion-upload">File / 配套文件</label>
    <input id="companion-upload" type="file" name="file" accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.png,.jpg,.jpeg,.mp3,.mp4,.zip" required>
    <p>PDF、Word、PowerPoint、Excel、图片、音视频或 ZIP；每个文件最多 30 MB。选好后点击上传，无需重新保存产品文字。</p>
    <button type="submit">Upload companion file / 上传配套文件</button>
  </form>
  <% } %>
</section>

<% if (!isNew) { %>
<form method="POST" action="/admin/recommendations/<%= encodeURIComponent(product.slug) %>/delete" onsubmit="return confirm('Delete this recommendation?');" style="margin-top:24px;">
  <button type="submit" class="danger">Delete this recommendation</button>
</form>
<% } %>

<%- include('layout-foot') %>
