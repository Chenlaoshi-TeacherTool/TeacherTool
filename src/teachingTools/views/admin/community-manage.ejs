<%- include('layout-head') %>
<link rel="stylesheet" href="/stylesheets/community-admin.css">
<% function link(change) { var params = new URLSearchParams({kind:kind,status:status,q:q,relation:relation}); Object.keys(change).forEach(function(key) {params.set(key,change[key]);}); return '/admin/community?'+params.toString(); } %>
<div class="sharing-heading"><div><h1>分享区管理</h1><p>集中管理投稿、公开内容与网站推广。</p></div><a class="button" href="/admin/community/websites/new">＋ 新增教学网站</a></div>
<nav class="sharing-tabs" aria-label="内容类型"><a href="<%= link({kind:'',page:''}) %>" <%- !kind ? 'aria-current="page"' : '' %>>全部内容</a><% Object.keys(kinds).forEach(function(key) { %><a class="kind-<%= key %>" href="<%= link({kind:key,page:''}) %>" <%- kind===key ? 'aria-current="page"' : '' %>><%= kinds[key] %></a><% }); %></nav>
<nav class="sharing-status-tabs" aria-label="内容状态"><a href="<%= link({status:'',page:''}) %>" <%- !status ? 'aria-current="page"' : '' %>>全部状态</a><% [['pending','待审核'],['published','已发布'],['unpublished','未发布'],['reports','有举报']].forEach(function(item) { %><a href="<%= link({status:item[0],page:''}) %>" <%- status===item[0] ? 'aria-current="page"' : '' %>><%= item[1] %> <strong><%= counts[item[0]] %></strong></a><% }); %><a href="<%= link({status:'returned',page:''}) %>" <%- status==='returned' ? 'aria-current="page"' : '' %>>已退回补充</a><a href="<%= link({status:'hidden',page:''}) %>" <%- status==='hidden' ? 'aria-current="page"' : '' %>>已下架</a></nav>
<form class="sharing-search" method="get" action="/admin/community"><input type="hidden" name="kind" value="<%= kind %>"><input type="hidden" name="status" value="<%= status %>"><label>搜索<input type="search" name="q" value="<%= q %>" placeholder="名称、介绍或投稿人"></label><label>网站商业关系<select name="relation"><option value="">全部</option><% [['none','无商业合作'],['paid','付费推广'],['affiliate','含佣金链接'],['other','其他合作'],['unknown','待核实']].forEach(function(item) { %><option value="<%= item[0] %>" <%= relation===item[0] ? 'selected' : '' %>><%= item[1] %></option><% }); %></select></label><button>筛选</button><a href="/admin/community">清除筛选</a></form>
<% if (done) { %><p class="sharing-notice" role="status"><%= done %></p><% } %>
<p class="sharing-help">“前台状态”说明用户现在能否看到内容；“待处理事项”说明草稿或新版是否还需要审核。下架保留后台记录。</p>
<form method="post" action="/admin/community/bulk/preview" id="sharing-bulk-form">
<div class="sharing-bulk-bar"><strong id="sharing-selection-count" aria-live="polite">已选 0 项</strong><label>批量操作<select name="action" required><option value="">请选择操作</option><option value="publish">发布前检查 / 批量发布</option><option value="unpublish">批量下架</option><option value="category">修改网站用途分类</option></select></label><label>网站用途分类<input type="text" name="category" maxlength="120" placeholder="例如：课堂互动（仅修改网站分类时填写）"></label><button type="submit">检查所选内容 →</button></div>
<div class="table-scroll"><table class="sharing-table"><thead><tr><th><input type="checkbox" id="sharing-select-all" aria-label="选择当前页全部内容"></th><th>名称 / 内容类型</th><th>前台状态</th><th>待处理事项</th><th>来源 / 投稿人</th><th>网站商业关系</th><th>操作</th></tr></thead><tbody>
<% rows.forEach(function(row) { %><tr><td><input type="checkbox" name="selected" value="<%= row.key %>" aria-label="选择 <%= row.name %>"></td><td><strong><a href="<%= row.href %>"><%= row.name %></a></strong><p><span class="sharing-kind kind-<%= row.kind %>"><%= kinds[row.kind] %></span><% if (row.type==='website') { %> · <%= row.category %><% } %></p></td><td><span class="sharing-state state-<%= row.status %>"><%= statusLabels[row.status] %></span></td><td><%= row.task || '—' %><% if (row.reports) { %><p class="sharing-warning">举报 <%= row.reports %> 条</p><% } %></td><td><%= row.author %><% if (row.type==='post' && row.kind==='website') { %><p>旧网站投稿</p><% } %></td><td><%= row.relationship %></td><td><a href="<%= row.href %>"><%= row.pending ? '审核 →' : row.type==='website' ? '编辑 →' : '查看 / 管理 →' %></a></td></tr><% }); %>
<% if (!rows.length) { %><tr><td colspan="7" class="sharing-empty">没有符合条件的内容。可以调整筛选，或新增教学网站。</td></tr><% } %>
</tbody></table></div></form>
<div class="sharing-pagination"><span>共 <%= total %> 项 · 第 <%= page %> / <%= pages %> 页</span><% if(page>1) { %><a href="<%= link({page:page-1}) %>">上一页</a><% } %><% if(page<pages) { %><a href="<%= link({page:page+1}) %>">下一页</a><% } %></div>
<script src="/javascripts/admin-community.js"></script>
<%- include('layout-foot') %>
