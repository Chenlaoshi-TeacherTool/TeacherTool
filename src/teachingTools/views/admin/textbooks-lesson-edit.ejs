<%- include('layout-head') %>
<h1><%= lesson ? 'Edit: ' + lesson.title : 'New lesson' %></h1>
<p><a href="<%= defaults.book_slug ? bookPath(defaults.series, defaults.book_slug) : '/admin/textbooks' %>">&larr; Back to book</a></p>

<form method="POST" action="<%= lesson ? '/admin/textbooks/lessons/' + lesson.id : '/admin/textbooks/lessons/new' %>">
  <div class="q-grid">
    <div>
      <label>Series</label>
      <select name="series">
        <% seriesList.forEach(function (series) { %>
        <option value="<%= series.key %>" <%= series.key === defaults.series ? 'selected' : '' %>><%= series.zh %> (<%= series.key %>)</option>
        <% }) %>
      </select>
    </div>
    <div>
      <label>Slug (unique, no spaces, e.g. bubian-1a-01)</label>
      <input type="text" name="slug" value="<%= lesson ? lesson.slug : '' %>" required>
    </div>
    <div>
      <label>Book slug (e.g. 1a, book-3)</label>
      <input type="text" name="book_slug" value="<%= defaults.book_slug || '' %>" required>
    </div>
    <div>
      <label>Book name (e.g. 一年级上册)</label>
      <input type="text" name="book_name" value="<%= defaults.book_name || '' %>" required>
    </div>
    <div>
      <label>Order in book</label>
      <input type="text" name="sort_order" value="<%= lesson ? lesson.sort_order : '' %>">
    </div>
    <div>
      <label>Lesson number (optional)</label>
      <input type="text" name="lesson_no" value="<%= lesson && lesson.lesson_no != null ? lesson.lesson_no : '' %>">
    </div>
  </div>
  <label>Title</label>
  <input type="text" name="title" value="<%= lesson ? lesson.title : '' %>" required>
  <label>Sentence patterns (one per line)</label>
  <textarea name="sentence_patterns" rows="4"><%= lesson ? (lesson.sentence_patterns || '') : '' %></textarea>
  <label>Activities (one per line; add a link with "activity | link", e.g. 家庭树 | /teaching-tools/bingo-generator)</label>
  <textarea name="activities" rows="4"><%= lesson ? (lesson.activities || '') : '' %></textarea>
  <label>Games (one per line: "game name | link", e.g. 数字转盘 | /teaching-tools/lucky-wheel or a /play/... student link)</label>
  <textarea name="games" rows="4"><%= lesson ? (lesson.games || '') : '' %></textarea>
  <label><input type="checkbox" name="is_published" <%= !lesson || lesson.is_published ? 'checked' : '' %>> Published</label>
  <div class="actions">
    <button type="submit"><%= lesson ? 'Save changes' : 'Create lesson' %></button>
  </div>
</form>

<% if (lesson) { %>
<h2 id="words" style="margin-top:24px;">Words (<%= items.length %>)</h2>
<p><a class="button" href="<%= bookPath(lesson.series, lesson.book_slug) %>/words#lesson-<%= lesson.id %>">补全英文、批量编辑本册词汇 / Book vocabulary editor</a></p>
<% if (locals.wordsSaved) { %><p role="status">已添加 <%= wordsSaved.added %> 个词语，跳过 <%= wordsSaved.skipped %> 个重复词语。 / Added <%= wordsSaved.added %>; skipped <%= wordsSaved.skipped %> duplicates.</p><% } %>
<%- include('textbook-word-input', { lessonId: lesson.id }) %>
<div class="items-grid" style="grid-template-columns: 1fr 1fr 2fr 90px auto auto;">
  <div class="grid-header">Chinese</div>
  <div class="grid-header">Pinyin</div>
  <div class="grid-header">English</div>
  <div class="grid-header">Kind</div>
  <div class="grid-header"></div>
  <div class="grid-header"></div>

  <% items.forEach(function (item) { %>
  <form class="row-form" method="POST" action="/admin/textbooks/lessons/<%= lesson.id %>/items/<%= item.id %>">
    <div><input type="text" name="zh" value="<%= item.zh %>" required></div>
    <div><input type="text" name="py" value="<%= item.py %>" required></div>
    <div><input type="text" name="en" value="<%= item.en %>"></div>
    <div><input type="text" name="kind" value="<%= item.kind || '' %>" placeholder="识字/写字/词语"></div>
    <div><button type="submit">Save</button></div>
  </form>
  <form method="POST" action="/admin/textbooks/lessons/<%= lesson.id %>/items/<%= item.id %>/delete" onsubmit="return confirm('Delete this word?');">
    <button type="submit" class="danger">Delete</button>
  </form>
  <% }) %>

  <form class="row-form" method="POST" action="/admin/textbooks/lessons/<%= lesson.id %>/items">
    <div><input type="text" name="zh" placeholder="Chinese" required></div>
    <div><input type="text" name="py" placeholder="Pinyin" required></div>
    <div><input type="text" name="en" placeholder="English"></div>
    <div><input type="text" name="kind" placeholder="识字/写字/词语"></div>
    <div><button type="submit">Add word</button></div>
  </form>
  <div></div>
</div>

<form method="POST" action="/admin/textbooks/lessons/<%= lesson.id %>/delete" onsubmit="return confirm('Delete this lesson and all its words?');" style="margin-top:24px;">
  <button type="submit" class="danger">Delete this lesson</button>
</form>
<% } %>
<% if (lesson) { var files = typeof locals.files === 'undefined' ? [] : locals.files; var fileError = locals.fileError || ''; %>
<h2 id="files" style="margin-top:28px;">Files for teachers (<%= files ? files.length : '?' %>)</h2>
<p style="font-size:0.9rem;color:#444;">PDF, Word, PowerPoint, Excel, images, MP3, MP4 video or ZIP, up to 30 MB each. Videos play on the lesson page. In members-only series (<%= seriesList.filter(function (s) { return s.membersOnly; }).map(function (s) { return s.zh; }).join(', ') || 'none' %>) only members can download them.</p>
<% if (fileError) { %><p style="border:2px solid #dc2626;border-radius:6px;padding:10px 14px;"><%= fileError %></p><% } %>
<% if (files === null) { %>
  <p style="color:#b91c1c;">Files could not be loaded. Run migration 0010_add-textbook-lesson-files on the database.</p>
<% } else { %>
  <% if (files.length) { %>
  <table>
    <thead><tr><th>Title</th><th>File</th><th>Size</th><th></th></tr></thead>
    <tbody>
      <% files.forEach(function (file) { %>
      <tr>
        <td><%= file.title %></td>
        <td><a href="/textbook-companion/files/<%= file.id %>"><%= file.fileName %></a></td>
        <td><%= Math.max(1, Math.round(file.size / 1024)) %> KB</td>
        <td><form method="POST" action="/admin/textbooks/lessons/<%= lesson.id %>/files/<%= file.id %>/delete" onsubmit="return confirm('Delete this file?');"><button type="submit" class="danger">Delete</button></form></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
  <form method="POST" action="/admin/textbooks/lessons/<%= lesson.id %>/files" enctype="multipart/form-data" style="margin-top:12px;">
    <label>Title shown to teachers (optional, e.g. 第一课 作业单)</label>
    <input type="text" name="title" maxlength="200">
    <label>File</label>
    <input type="file" name="file" required accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.png,.jpg,.jpeg,.mp3,.mp4,.zip">
    <div class="actions"><button type="submit">Upload file</button></div>
  </form>
<% } %>
<% } %>
<%- include('layout-foot') %>
