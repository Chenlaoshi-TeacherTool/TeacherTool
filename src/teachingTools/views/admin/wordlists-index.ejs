<%- include('layout-head') %>
<h1>Word Lists</h1>
<p>
  <a class="button" href="/admin/wordlists/new">+ New word list</a>
  <a class="button" href="/admin/wordlists/import">+ Bulk import from Excel</a>
</p>
<label for="content-search">搜索当前列表</label>
<input id="content-search" type="search" data-admin-filter="content-table" placeholder="输入名称、分类或关键词">
<table id="content-table">
  <thead>
    <tr><th>Name</th><th>Slug</th><th>Theme</th><th>Level</th><th># Terms</th><th></th></tr>
  </thead>
  <tbody>
    <% lists.forEach(function (list) { %>
    <tr>
      <td><%= list.name %></td>
      <td><%= list.slug %></td>
      <td><%= list.theme || '' %></td>
      <td><%= list.level || '' %></td>
      <td><%= list.item_count %></td>
      <td>
        <a href="/admin/wordlists/<%= list.id %>/edit">Edit</a> ·
        <a href="/admin/wordlists/<%= list.id %>/import">Import</a> ·
        <a href="/admin/wordlists/<%= list.id %>/export">Export</a>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table>
<%- include('layout-foot') %>
