<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#356e57">
  <title><%= title %> - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'A student-made picture book with read-aloud narration.', noindex: true }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/low-prep/book-generator/book-generator.css?v=1">
  <link rel="stylesheet" href="/low-prep/book-generator/book-player.css?v=1">
</head>
<body class="book-player-page">
  <main class="book-player-wrap" id="playerWrap">
    <div class="book-player-title-row">
      <h1 class="book-player-title"><%= bookData.title %></h1>
      <button id="fullscreenBtn" class="book-gen-secondary" type="button"><%= t('bookPlayer.fullscreen') %></button>
    </div>

    <div class="book-player-stage">
      <img id="playerImage" class="book-player-image" alt="">
      <p id="playerCaption" class="book-player-caption"></p>
    </div>

    <div class="book-player-controls">
      <button id="prevPageBtn" class="book-gen-secondary" type="button" title="<%= t('bookPlayer.previousPage') %>">←</button>
      <button id="playPauseBtn" class="book-gen-primary" type="button"><%= t('bookPlayer.startReading') %></button>
      <button id="nextPageBtn" class="book-gen-secondary" type="button" title="<%= t('bookPlayer.nextPage') %>">→</button>
    </div>
    <p id="pageIndicator" class="book-player-page-indicator"></p>
  </main>

  <audio id="narrationAudio"></audio>
  <audio id="musicAudio" loop></audio>

  <script>
    window.__BOOK_DATA__ = <%- JSON.stringify(bookData) %>;
    window.__BOOK_PLAYER_I18N__ = <%- JSON.stringify({
      startReading: t('bookPlayer.startReading'),
      pause: t('bookPlayer.pause'),
      pageOf: t('bookPlayer.pageOf'),
      fullscreen: t('bookPlayer.fullscreen'),
      exitFullscreen: t('bookPlayer.exitFullscreen')
    }) %>;
  </script>
  <script src="/low-prep/book-generator/book-player.js?v=1"></script>
</body>
</html>
