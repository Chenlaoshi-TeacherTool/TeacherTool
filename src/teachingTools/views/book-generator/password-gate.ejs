<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#356e57">
  <title><%= title %> - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'Enter the password to read this student-made book.', noindex: true }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/low-prep/book-generator/book-generator.css?v=1">
  <link rel="stylesheet" href="/low-prep/book-generator/book-player.css?v=1">
</head>
<body class="book-player-page book-player-gate-page">
  <main class="book-player-gate">
    <h1><%= t('bookPlayer.passwordGateTitle') %></h1>
    <p><%= t('bookPlayer.passwordGateHelp') %></p>
    <% if (error) { %><p class="book-player-error"><%= error %></p><% } %>
    <form method="POST" action="/book/<%= bookId %>/unlock" class="book-player-gate-form">
      <label for="passwordInput"><%= t('bookPlayer.passwordInputLabel') %></label>
      <input id="passwordInput" name="password" type="password" autofocus required>
      <button type="submit" class="book-gen-primary"><%= t('bookPlayer.unlockButton') %></button>
    </form>
  </main>
</body>
</html>
