<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#356e57">
  <title><%= title %> - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'Draw a Chinese vocabulary word as pixel art and hand it in.', noindex: true }) %>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Andika:wght@400;700&display=swap">
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/low-prep/pixel-art/pixel-art.css?v=3">
</head>
<body class="game-share-page px-page px-student-page">
  <main class="px-wrap">
    <div id="pxDraw"></div>
    <noscript><p>请打开 JavaScript。 Please turn on JavaScript to draw.</p></noscript>
  </main>

  <script>window.__SHARED_GAME__ = <%- gameDataJson %>;</script>
  <script src="/low-prep/pixel-art/pixel-core.js?v=3"></script>
  <script src="/low-prep/pixel-art/pixel-draw.js?v=3"></script>
  <script>
    (function () {
      var game = window.__SHARED_GAME__;
      var config = Object.assign({}, game.data, { title: game.data.title || game.title });
      PixelArtDraw.mount(document.getElementById('pxDraw'), config, { shareId: game.shareId });
    })();
  </script>
</body>
</html>
