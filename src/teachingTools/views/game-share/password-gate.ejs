<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#194f45">
  <title><%= title %> - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'Enter the teacher-provided password to open this classroom game.', noindex: true }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/shared/game-share.css?v=1">
</head>
<body class="game-share-page game-share-gate-page">
  <main class="game-share-gate">
    <div class="game-share-mark" aria-hidden="true">🎮</div>
    <p class="game-share-eyebrow">Shared classroom game</p>
    <h1><%= title %></h1>
    <p>Enter the password your teacher gave you to start the activity.</p>
    <% if (error) { %><p class="game-share-error" role="alert"><%= error %></p><% } %>
    <form method="POST" action="/play/<%= shareId %>/unlock" class="game-share-gate-form">
      <label for="passwordInput">Game password</label>
      <input id="passwordInput" name="password" type="password" maxlength="64" autocomplete="current-password" autofocus required>
      <button type="submit">Open game</button>
    </form>
    <p class="game-share-small">No student account is needed.</p>
  </main>
</body>
</html>
