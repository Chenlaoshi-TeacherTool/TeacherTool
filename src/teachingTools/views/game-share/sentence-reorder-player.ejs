<% var assessment = JSON.parse(gameDataJson).data.mode === 'assessment'; %>
<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#194f45">
  <title><%= title %> - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'Complete a shared Sentence Reorder game online.', noindex: true }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/shared/game-share.css?v=1">
  <link rel="stylesheet" href="/low-prep/sentence-reorder/sentence-reorder-player.css?v=6">
</head>
<body class="game-share-page reorder-player-page">
  <header class="reorder-player-header">
    <div>
      <p class="game-share-eyebrow">Sentence Reorder · Online game</p>
      <h1 id="gameTitle"><%= title %></h1>
      <p>Drag the words into the correct sentence order.</p>
    </div>
    <div class="reorder-player-progress" aria-live="polite">
      <strong id="progressCount">0 / 0</strong>
      <span><%= assessment ? 'sentences visited' : 'sentences complete' %></span>
    </div>
  </header>

  <main class="reorder-player-main">
    <% if (assessment) { %>
    <section id="studentNameGate" class="reorder-player-card" aria-labelledby="studentNameHeading">
      <h2 id="studentNameHeading">Enter your name / 填写姓名</h2>
      <p>One submission per name. Use the name your teacher recognises. Students with the same name should add their class or student number.<br>每个姓名只能提交一次。请填写老师认可的姓名；同名学生请加班级或学号。</p>
      <form id="studentNameForm">
        <label for="studentNameInput">Student name / 学生姓名</label>
        <input id="studentNameInput" name="studentName" maxlength="80" required autocomplete="name">
        <button id="startQuizButton" type="submit" class="reorder-student-primary">Start / view results · 开始或查看结果</button>
        <p id="studentNameError" role="alert" hidden></p>
      </form>
    </section>
    <% } %>
    <section id="sentencePuzzleCard" class="reorder-player-card" <%= assessment ? "hidden" : "" %> aria-labelledby="sentenceHeading">
      <div class="reorder-card-heading">
        <div>
          <p class="game-share-eyebrow">Puzzle</p>
          <h2 id="sentenceHeading">Put this sentence in order</h2>
        </div>
        <p id="sentenceProgress" class="reorder-student-meta">Sentence 1 of 1</p>
      </div>

      <div id="studentSentenceStage" class="reorder-student-stage" aria-label="Sentence words"></div>
      <p id="gameStatus" class="reorder-student-status" role="status">Your progress is saved on this device.</p>

      <div class="reorder-player-actions">
        <button id="checkButton" type="button" <%= assessment ? "hidden" : "" %> class="reorder-student-primary">Check answer</button>
        <button id="submitButton" type="button" class="reorder-student-primary" <%= assessment ? "" : "hidden" %>>Submit all answers</button>
        <button id="shuffleButton" type="button" class="reorder-student-secondary">Shuffle again</button>
      </div>
      <div class="reorder-player-nav">
        <button id="prevButton" type="button" class="reorder-student-secondary">Previous</button>
        <button id="nextButton" type="button" class="reorder-student-primary">Next sentence</button>
      </div>
      <button id="resetButton" type="button" <%= assessment ? "hidden" : "" %> class="reorder-student-reset"><%= assessment ? "Reset my progress" : "Play again / 再来一次" %></button>
    </section>
    <section id="assessmentReview" class="reorder-player-card reorder-assessment-review" hidden aria-labelledby="assessmentReviewTitle">
      <p class="game-share-eyebrow">Quiz results / 测验结果</p>
      <h2 id="assessmentReviewTitle" tabindex="-1"><%= title %></h2>
      <p id="assessmentReviewName"></p>
      <p id="assessmentReviewScore" class="reorder-review-score"></p>
      <p>Screenshot these results and send them to your teacher.<br>请截图本页结果，发送给老师。题目较多时可分多张截图。</p>
      <ol id="assessmentReviewList" class="reorder-review-list"></ol>
    </section>
  </main>

  <div id="completionPanel" class="reorder-student-completion" hidden role="dialog" aria-modal="true" aria-labelledby="completionTitle">
    <div class="reorder-student-completion-card">
      <div class="reorder-student-completion-icon" aria-hidden="true">🎉</div>
      <h2 id="completionTitle"><%= assessment ? "Quiz result" : "Correct!" %></h2>
      <p id="completionMessage">Excellent work — the sentence is in the right order.</p>
      <button id="playAgainButton" type="button" class="reorder-student-secondary" <%= assessment ? "hidden" : "" %>>Play again / 再来一次</button>
      <button id="closeCompletionButton" type="button" class="reorder-student-primary"><%= assessment ? "Review my answers" : "Keep playing" %></button>
    </div>
  </div>

  <script>window.__SHARED_GAME__ = <%- gameDataJson %>;</script>
  <script src="/low-prep/sentence-reorder/sentence-reorder-player.js?v=8"></script>
</body>
</html>
