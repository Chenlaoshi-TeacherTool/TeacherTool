<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#194f45">
  <title><%= title %> - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'This shared classroom game link has expired.', noindex: true }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/shared/game-share.css?v=1">
</head>
<body class="game-share-page game-share-gate-page">
  <main class="game-share-gate">
    <div class="game-share-mark" aria-hidden="true">⌛</div>
    <p class="game-share-eyebrow">Link expired</p>
    <h1>This game is no longer available.</h1>
    <p>Ask your teacher to create a new game link.</p>
    <a class="game-share-home-link" href="/teaching-tools">Browse teaching tools</a>
  </main>
</body>
</html>
