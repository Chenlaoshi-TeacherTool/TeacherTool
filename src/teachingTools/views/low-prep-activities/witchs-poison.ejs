<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#194f45">
  <title><%= t('poisonGame.metaTitle') %></title>
  <%- include('../partials/seo', { pageDescription: t('poisonGame.metaDescription') }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/low-prep/witchs-poison/witchs-poison.css?v=14">
</head>
<body class="poison-page">
  <header class="header poison-header">
    <a href="/teaching-tools#low-prep-activities" class="back-btn"><%= t('poisonGame.backBtn') %></a>
    <div class="poison-header-inner">
      <div class="poison-header-icon" aria-hidden="true">🧪</div>
      <div>
        <p class="poison-kicker"><%= t('poisonGame.eyebrow') %></p>
        <h1><%= t('poisonGame.title') %></h1>
        <p><%= t('poisonGame.subtitle') %></p>
      </div>
      <span class="poison-header-badge"><%= t('poisonGame.heroBadge') %></span>
    </div>
  </header>

  <main
    id="poison-app"
    class="poison-main"
    data-card-count-template="<%= t('poisonGame.cardCountTemplate') %>"
    data-group-template="<%= t('poisonGame.groupTemplate') %>"
    data-progress-template="<%= t('poisonGame.progressTemplate') %>"
    data-poison-setup-progress-template="<%= t('poisonGame.poisonSetupProgressTemplate') %>"
    data-poison-setup-prompt-template="<%= t('poisonGame.poisonSetupPromptTemplate') %>"
    data-play-prompt="<%= t('poisonGame.readPrompt') %>"
    data-poison-group-template="<%= t('poisonGame.poisonGroupTemplate') %>"
    data-antidote-setup-progress-template="<%= t('poisonGame.antidoteSetupProgressTemplate') %>"
    data-antidote-setup-prompt-template="<%= t('poisonGame.antidoteSetupPromptTemplate') %>"
    data-placement-hold-prompt="<%= t('poisonGame.placementHoldPrompt') %>"
    data-antidote-found-template="<%= t('poisonGame.antidoteFoundTemplate') %>"
    data-antidote-used-template="<%= t('poisonGame.antidoteUsedTemplate') %>"
    data-antidote-cleared-template="<%= t('poisonGame.antidoteClearedTemplate') %>"
    data-antidote-held-template="<%= t('poisonGame.antidoteHeldTemplate') %>"
    data-poison-count-template="<%= t('poisonGame.poisonCountTemplate') %>"
    data-use-antidote-label="<%= t('poisonGame.useAntidoteLabel') %>"
    data-rename-group-label="<%= t('poisonGame.renameGroupLabel') %>"
    data-poison-cast-label="<%= t('poisonGame.poisonCastLabel') %>"
    data-antidote-cast-label="<%= t('poisonGame.antidoteCastLabel') %>"
    data-chooser-first-title="<%= t('poisonGame.chooserFirstTitle') %>"
    data-chooser-next-title="<%= t('poisonGame.chooserNextTitle') %>"
    data-game-start-title="<%= t('poisonGame.gameStartTitle') %>"
    data-game-start-sub="<%= t('poisonGame.gameStartSub') %>"
    data-game-over-title="<%= t('poisonGame.gameOverTitle') %>"
    data-game-over-win-title="<%= t('poisonGame.gameOverWinTitle') %>"
    data-game-over-winners-safe="<%= t('poisonGame.gameOverWinnersSafe') %>"
    data-game-over-winners-least="<%= t('poisonGame.gameOverWinnersLeast') %>"
    data-poison-witch-src="/low-prep/witchs-poison/poison-witch.png"
    data-antidote-witch-src="/low-prep/witchs-poison/antidote-witch.png"
    data-game-over-template="<%= t('poisonGame.gameOverTemplate') %>"
    data-invalid-cards="<%= t('poisonGame.invalidCards') %>"
    data-invalid-groups="<%= t('poisonGame.invalidGroups') %>"
    data-invalid-poison-count-template="<%= t('poisonGame.invalidPoisonCountTemplate') %>"
    data-save-success-template="<%= t('poisonGame.saveSuccessTemplate') %>"
    data-load-success-template="<%= t('poisonGame.loadSuccessTemplate') %>"
    data-save-missing-name="<%= t('poisonGame.saveMissingName') %>"
    data-saved-cards-placeholder="<%= t('poisonGame.savedCardsPlaceholder') %>"
    data-no-saved-cards="<%= t('poisonGame.noSavedCards') %>"
  >
    <section id="poison-setup" class="poison-panel" aria-labelledby="poison-setup-heading">
      <div class="poison-panel-heading">
        <div>
          <p class="poison-kicker"><%= t('poisonGame.setupKicker') %></p>
          <h2 id="poison-setup-heading"><%= t('poisonGame.setupHeading') %></h2>
        </div>
        <span aria-hidden="true">🧙‍♀️</span>
      </div>

      <form id="poison-setup-form">
        <label for="poison-card-input"><%= t('poisonGame.cardsLabel') %></label>
        <textarea id="poison-card-input" rows="10" required placeholder="<%= t('poisonGame.cardsPlaceholder') %>"></textarea>
        <p id="poison-card-count" class="poison-help" aria-live="polite"></p>

        <div class="poison-library">
          <label for="poison-saved-list"><%= t('poisonGame.savedCardsLabel') %></label>
          <div class="poison-library-row">
            <select id="poison-saved-list"></select>
            <button id="poison-load-cards" class="poison-secondary" type="button"><%= t('poisonGame.loadCardsButton') %></button>
          </div>
          <label for="poison-save-name"><%= t('poisonGame.saveNameLabel') %></label>
          <div class="poison-library-row">
            <input id="poison-save-name" type="text" maxlength="60" placeholder="<%= t('poisonGame.saveNamePlaceholder') %>">
            <button id="poison-save-cards" class="poison-secondary" type="button"><%= t('poisonGame.saveCardsButton') %></button>
          </div>
        </div>

        <div class="poison-options">
          <div>
            <label for="poison-group-count"><%= t('poisonGame.groupCountLabel') %></label>
            <input id="poison-group-count" type="number" min="1" max="20" step="1" value="4" required>
            <p class="poison-help"><%= t('poisonGame.groupCountHelp') %></p>
          </div>
          <div>
            <label for="poison-cards-per-group"><%= t('poisonGame.poisonCardsPerGroupLabel') %></label>
            <input id="poison-cards-per-group" type="number" min="1" max="10" step="1" value="1" required>
            <p class="poison-help"><%= t('poisonGame.poisonCardsPerGroupHelp') %></p>
          </div>
          <div class="poison-toggle-field">
            <label class="poison-toggle" for="poison-antidote-toggle">
              <input id="poison-antidote-toggle" type="checkbox">
              <span><%= t('poisonGame.antidoteToggleLabel') %></span>
            </label>
            <p class="poison-help"><%= t('poisonGame.antidoteToggleHelp') %></p>
          </div>
        </div>

        <button class="poison-primary" type="submit">▶ <%= t('poisonGame.startButton') %></button>
        <div class="poison-setup-toggles">
          <button class="poison-secondary poison-mute" type="button" aria-pressed="false" data-sound-on-label="<%= t('poisonGame.soundOnLabel') %>" data-sound-off-label="<%= t('poisonGame.soundOffLabel') %>"><%= t('poisonGame.soundOnLabel') %></button>
          <button class="poison-secondary poison-fullscreen" type="button" aria-pressed="false" data-enter-label="<%= t('poisonGame.fullscreenEnter') %>" data-exit-label="<%= t('poisonGame.fullscreenExit') %>"><%= t('poisonGame.fullscreenEnter') %></button>
        </div>
        <p id="poison-setup-status" class="poison-status" aria-live="polite"><%= t('poisonGame.setupStatusDefault') %></p>
      </form>
    </section>

    <section id="poison-game" class="poison-panel poison-game" aria-labelledby="poison-group-heading" hidden>
      <div class="poison-game-topline">
        <div>
          <p class="poison-kicker"><%= t('poisonGame.currentGroupLabel') %></p>
          <h2 id="poison-group-heading"><span id="poison-current-group"></span></h2>
        </div>
        <p id="poison-progress" class="poison-progress"></p>
      </div>

      <div id="poison-roster" class="poison-roster" aria-label="<%= t('poisonGame.rosterLabel') %>"></div>

      <p id="poison-board-prompt" class="poison-read-prompt"><%= t('poisonGame.readPrompt') %></p>
      <div id="poison-card-grid" class="poison-card-grid" aria-live="polite"></div>

      <p id="poison-game-status" class="poison-status poison-game-status" aria-live="polite"><%= t('poisonGame.gameStatusDefault') %></p>
      <div class="poison-game-actions">
        <button id="poison-reset-button" class="poison-secondary" type="button"><%= t('poisonGame.resetButton') %></button>
        <button class="poison-secondary poison-mute" type="button" aria-pressed="false" data-sound-on-label="<%= t('poisonGame.soundOnLabel') %>" data-sound-off-label="<%= t('poisonGame.soundOffLabel') %>"><%= t('poisonGame.soundOnLabel') %></button>
        <button class="poison-secondary poison-fullscreen" type="button" aria-pressed="false" data-enter-label="<%= t('poisonGame.fullscreenEnter') %>" data-exit-label="<%= t('poisonGame.fullscreenExit') %>"><%= t('poisonGame.fullscreenEnter') %></button>
      </div>
    </section>

    <div id="poison-chooser" class="poison-chooser" role="dialog" aria-modal="true" aria-labelledby="poison-chooser-title" aria-hidden="true" hidden>
      <div class="poison-chooser-card">
        <p id="poison-chooser-title" class="poison-chooser-title"></p>
        <div id="poison-chooser-groups" class="poison-chooser-groups"></div>
      </div>
    </div>

    <div id="poison-cast" class="poison-cast" aria-hidden="true" hidden></div>
    <div id="poison-banner" class="poison-banner" role="alert" aria-hidden="true" hidden></div>
    <audio id="poison-music" src="/low-prep/witchs-poison/magical-potion-march.mp3" loop preload="auto"></audio>
  </main>

  <script src="/low-prep/witchs-poison/witchs-poison.js?v=14" defer></script>
  <script src="/javascripts/account-coming-soon.js"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
