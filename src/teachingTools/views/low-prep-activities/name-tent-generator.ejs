<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#315f4f">
  <title>Desk Name Tent Generator - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'Turn a class list into printable desk name tents. Each student gets one letter-size sheet with fold lines marked—no cutting needed—that folds flat into a standing triangle. Choose Chinese, English, pinyin, or all three, plus a colored border.' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/low-prep/name-tent-generator/name-tent-generator.css">
</head>
<body class="tent-page">
  <main class="tent-wrap">
    <header class="tent-hero">
      <div class="tent-hero-copy">
        <a class="back-link" href="/teaching-tools#low-prep-activities"><%= t('nameTentGenerator.backLink') %></a>
        <p class="eyebrow"><%= t('nameTentGenerator.eyebrow') %></p>
        <h1><span aria-hidden="true">🔺</span> <%= t('nameTentGenerator.title') %></h1>
        <p><%= t('nameTentGenerator.subtitle') %></p>
        <div class="hero-points" aria-label="Tool highlights">
          <span><%= t('nameTentGenerator.heroPoint1') %></span>
          <span><%= t('nameTentGenerator.heroPoint2') %></span>
          <span><%= t('nameTentGenerator.heroPoint3') %></span>
        </div>
      </div>
    </header>

    <div class="privacy-banner" role="note">
      <span class="privacy-icon" aria-hidden="true">⚠️</span>
      <p><strong><%= t('nameTentGenerator.privacyStrong') %></strong> <%= t('nameTentGenerator.privacyText') %></p>
    </div>

    <div class="tent-grid">
      <section class="builder" aria-label="Build desk name tents">
        <form id="tent-form">
          <section class="panel">
            <div class="panel-heading">
              <div>
                <span class="step-number">1</span>
                <p class="eyebrow"><%= t('nameTentGenerator.classListKicker') %></p>
                <h2><%= t('nameTentGenerator.classListHeading') %></h2>
              </div>
              <button id="load-example" class="ghost-button" type="button"><%= t('nameTentGenerator.loadExample') %></button>
            </div>
            <label for="names"><%= t('nameTentGenerator.namesLabel') %>
              <textarea id="names" class="names-textarea" required placeholder="Lily | 丽丽&#10;Max | 马克斯&#10;Emma | 艾玛 | orange"></textarea>
            </label>
            <p class="field-help"><%= t('nameTentGenerator.fieldHelpPrefix') %><strong><%= t('nameTentGenerator.fieldHelpFormat') %></strong><%= t('nameTentGenerator.fieldHelpSuffix') %></p>
            <p id="name-count" class="name-count" aria-live="polite"><%= t('nameTentGenerator.noNamesDetected') %></p>
          </section>

          <section class="panel">
            <div class="panel-heading">
              <div>
                <span class="step-number">2</span>
                <p class="eyebrow"><%= t('nameTentGenerator.displayKicker') %></p>
                <h2><%= t('nameTentGenerator.displayHeading') %></h2>
              </div>
            </div>
            <div class="mode-switch" role="group" aria-label="Display languages">
              <label><input type="checkbox" name="displayMode" value="zh" checked> <%= t('nameTentGenerator.displayChinese') %></label>
              <label><input type="checkbox" name="displayMode" value="en" checked> <%= t('nameTentGenerator.displayEnglish') %></label>
              <label><input type="checkbox" name="displayMode" value="py" checked> <%= t('nameTentGenerator.displayPinyin') %></label>
            </div>
          </section>

          <section class="panel">
            <div class="panel-heading">
              <div>
                <span class="step-number">3</span>
                <p class="eyebrow"><%= t('nameTentGenerator.colorsKicker') %></p>
                <h2><%= t('nameTentGenerator.colorsHeading') %></h2>
              </div>
            </div>
            <div class="color-mode-switch" role="radiogroup" aria-label="Color mode">
              <label><input type="radio" name="colorMode" value="auto" checked> <%= t('nameTentGenerator.colorModeAuto') %></label>
              <label><input type="radio" name="colorMode" value="single"> <%= t('nameTentGenerator.colorModeSingle') %></label>
            </div>
            <div id="single-color-row" style="display:none; margin-bottom: 14px;">
              <label for="single-color-select"><%= t('nameTentGenerator.singleColorLabel') %>
                <select id="single-color-select">
                  <option value="red"><%= t('nameTentGenerator.colorRed') %></option>
                  <option value="orange"><%= t('nameTentGenerator.colorOrange') %></option>
                  <option value="yellow"><%= t('nameTentGenerator.colorYellow') %></option>
                  <option value="green" selected><%= t('nameTentGenerator.colorGreen') %></option>
                  <option value="blue"><%= t('nameTentGenerator.colorBlue') %></option>
                  <option value="purple"><%= t('nameTentGenerator.colorPurple') %></option>
                </select>
              </label>
            </div>
            <p class="field-help" style="margin-top:0;"><%= t('nameTentGenerator.paletteHelp') %></p>
            <div class="color-swatches" id="color-swatches">
              <label class="color-swatch" style="--swatch-color:var(--tent-red)"><input type="checkbox" value="red" checked><span><span class="color-dot"></span><%= t('nameTentGenerator.colorRed') %></span></label>
              <label class="color-swatch" style="--swatch-color:var(--tent-orange)"><input type="checkbox" value="orange" checked><span><span class="color-dot"></span><%= t('nameTentGenerator.colorOrange') %></span></label>
              <label class="color-swatch" style="--swatch-color:var(--tent-yellow)"><input type="checkbox" value="yellow" checked><span><span class="color-dot"></span><%= t('nameTentGenerator.colorYellow') %></span></label>
              <label class="color-swatch" style="--swatch-color:var(--tent-tgreen)"><input type="checkbox" value="green" checked><span><span class="color-dot"></span><%= t('nameTentGenerator.colorGreen') %></span></label>
              <label class="color-swatch" style="--swatch-color:var(--tent-blue)"><input type="checkbox" value="blue" checked><span><span class="color-dot"></span><%= t('nameTentGenerator.colorBlue') %></span></label>
              <label class="color-swatch" style="--swatch-color:var(--tent-purple)"><input type="checkbox" value="purple" checked><span><span class="color-dot"></span><%= t('nameTentGenerator.colorPurple') %></span></label>
            </div>
          </section>

          <div class="form-footer">
            <button class="generate-button" type="submit"><%= t('nameTentGenerator.generateButton') %></button>
            <p id="generation-status" class="generation-status" aria-live="polite"></p>
          </div>
          <div class="download-row">
            <button id="print-pdf" class="download-button" type="button" disabled><%= t('nameTentGenerator.printPdfButton') %></button>
          </div>
        </form>
      </section>

      <section class="preview-panel" aria-label="Generated name tents">
        <div class="preview-heading">
          <h2><%= t('nameTentGenerator.previewHeading') %></h2>
          <p><%= t('nameTentGenerator.previewSubtext') %></p>
        </div>
        <div class="fold-instructions">
          <strong><%= t('nameTentGenerator.assembleStrong') %></strong> <%= t('nameTentGenerator.assembleText') %>
        </div>
        <div id="preview-panel-body">
          <div id="preview-cards" class="preview-cards">
            <p class="preview-empty"><%= t('nameTentGenerator.previewEmptyPrefix') %>"<%= t('nameTentGenerator.previewEmptyButtonText') %>"<%= t('nameTentGenerator.previewEmptySuffix') %></p>
          </div>
        </div>
      </section>
    </div>
  </main>

  <div id="print-area" class="tent-print-area"></div>

  <%- include('../partials/tool-guide', { toolGuide: toolGuide }) %>

  <script src="/vendor/pinyin-pro.js" defer></script>
  <script src="/low-prep/name-tent-generator/name-tent-generator.js" defer></script>
  <script src="/javascripts/account-coming-soon.js"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
