<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#356e57">
  <title>图形密码解密练习纸 · Secret Message Worksheet - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'Turn any Chinese or English sentence into a printable emoji secret-message worksheet. Pick a holiday theme, get a code key and a puzzle row with writing lines or 田字格, and print it on one A4 or Letter page.' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/low-prep/secret-message/secret-message.css?v=1">
  <style id="sm-page-size">@media print { @page { size: A4 portrait; margin: 0; } }</style>
</head>
<body class="sm-page">
  <main class="sm-wrap">
    <header class="sm-header">
      <div class="sm-header-content">
        <a href="/teaching-tools#low-prep-activities" class="back-btn">← Back to Teaching Tools</a>
        <p class="sm-eyebrow">Emoji code worksheet</p>
        <h1>🔐 图形密码解密练习纸 · Secret Message</h1>
        <p>Type a sentence for your class and every character turns into an emoji. Students read the code key, decode your secret message and write each 字 or letter on the line underneath.</p>
        <div class="sm-hero-points" aria-label="Tool highlights">
          <span>中文 or English</span>
          <span>Holiday emoji themes</span>
          <span>Lines or 田字格 · One-page print</span>
        </div>
      </div>
    </header>

    <div class="sm-layout">
      <section class="sm-builder" aria-label="Build your worksheet">

        <section class="sm-panel">
          <div class="sm-panel-heading">
            <span class="sm-step">1</span>
            <p class="sm-kicker">Your secret message</p>
            <h2>输入句子 Sentence</h2>
          </div>
          <label for="sm-message">Message 秘密信息</label>
          <textarea id="sm-message" rows="3" placeholder="祝你万圣节快乐！&#10;Happy Halloween, my friends!">祝你万圣节快乐！</textarea>
          <div class="sm-counter-row">
            <p class="sm-hint">Spaces and punctuation are skipped — only 汉字, letters and numbers get an emoji.</p>
            <span id="sm-counter" class="sm-counter" aria-live="polite">0/30</span>
          </div>

          <label for="sm-limit">Character limit 字数上限</label>
          <select id="sm-limit">
            <option value="15">15</option>
            <option value="20">20</option>
            <option value="30" selected>30</option>
            <option value="40">40</option>
          </select>

          <label for="sm-title">Worksheet title 标题</label>
          <input type="text" id="sm-title" maxlength="60" value="来自老师的秘密信息 · A Secret Message From Your Teacher">
        </section>

        <section class="sm-panel">
          <div class="sm-panel-heading">
            <span class="sm-step">2</span>
            <p class="sm-kicker">Pick the look</p>
            <h2>节日主题 Theme</h2>
          </div>
          <div id="sm-theme-picker" class="sm-theme-picker" role="radiogroup" aria-label="Theme"></div>

          <label>Emoji matching 图标匹配</label>
          <div class="sm-segmented" role="group" aria-label="Emoji matching">
            <button type="button" class="is-active" data-match="random">🎲 Random 随机</button>
            <button type="button" data-match="ordered">➡️ In order 顺序</button>
          </div>

          <label for="sm-answer-style">Answer space 答题格</label>
          <select id="sm-answer-style">
            <option value="auto" selected>Auto (中文 → 田字格, English → line)</option>
            <option value="line">Underline 横线</option>
            <option value="tian">田字格</option>
            <option value="box">Box 方框</option>
          </select>
        </section>

        <section class="sm-panel">
          <div class="sm-panel-heading">
            <span class="sm-step">3</span>
            <p class="sm-kicker">Make it harder</p>
            <h2>对照表 Code key</h2>
          </div>
          <div class="sm-options">
            <label class="sm-check">
              <input type="checkbox" id="sm-full-alphabet" checked>
              <span>Show the full A–Z for English
                <small>Like a classic cipher sheet — unused letters still get an emoji.</small>
              </span>
            </label>
          </div>
          <label for="sm-decoys">Extra decoy characters 干扰字 (optional)</label>
          <input type="text" id="sm-decoys" maxlength="20" placeholder="e.g. 天 地 人 大 小">
          <p class="sm-hint">These appear in the code key but not in the message, so students can't just copy the key in order.</p>

          <div class="sm-options sm-options--spaced">
            <label class="sm-check">
              <input type="checkbox" id="sm-show-answers">
              <span>Show answers on screen 显示答案
                <small>Preview the answer key in red.</small>
              </span>
            </label>
            <label class="sm-check">
              <input type="checkbox" id="sm-print-key" checked>
              <span>Print an answer key on page 2 打印答案页</span>
            </label>
          </div>

          <button id="sm-generate" class="sm-primary" type="button">🎲 生成 / 重新打乱 · Generate / Reshuffle</button>
        </section>
      </section>

      <section class="sm-preview-panel" aria-label="Worksheet preview">
        <div class="sm-preview-toolbar">
          <div class="sm-paper-toggle sm-segmented" role="group" aria-label="Paper size">
            <button type="button" class="is-active" data-paper="a4">A4</button>
            <button type="button" data-paper="letter">Letter</button>
          </div>
          <button id="sm-print" class="sm-secondary" type="button">🖨️ 打印 / 下载 PDF · Print to PDF</button>
        </div>
        <p id="sm-status" class="sm-status" aria-live="polite"></p>

        <div id="sm-stage" class="sm-stage">
          <div id="sm-sheets" class="sm-sheets"></div>
        </div>
      </section>
    </div>
  </main>

  <%- include('../partials/tool-guide', { toolGuide: toolGuide }) %>

  <script src="/low-prep/secret-message/secret-message.js?v=1" defer></script>
  <script src="/javascripts/account-coming-soon.js"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
