<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#315f4f">
  <title>Tarsia Puzzle Generator - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'Turn vocabulary, pinyin, English meanings, Twemoji pictures, or question-and-answer pairs into a printable Tarsia triangle puzzle.' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/shared/library-picker.css">
  <link rel="stylesheet" href="/low-prep/tarsia-puzzle/tarsia-puzzle.css?v=topic-cards-1">
</head>
<body class="tarsia-page">
  <main class="tarsia-wrap">
    <header class="tarsia-hero">
      <div class="tarsia-hero-copy">
        <a class="back-link" href="/teaching-tools#low-prep-activities"><%= t('tarsiaPuzzle.backLink') %></a>
        <p class="eyebrow"><%= t('tarsiaPuzzle.eyebrow') %></p>
        <h1><span aria-hidden="true">🧩</span> <%= t('tarsiaPuzzle.title') %></h1>
        <p><%= t('tarsiaPuzzle.subtitle') %></p>
        <div class="hero-points" aria-label="Tool highlights">
          <span><%= t('tarsiaPuzzle.heroPoint1') %></span>
          <span><%= t('tarsiaPuzzle.heroPoint2') %></span>
          <span><%= t('tarsiaPuzzle.heroPoint3') %></span>
        </div>
      </div>
      <div class="hero-puzzle" aria-hidden="true">
        <svg viewBox="0 0 260 220" role="img">
          <path d="M130 10 20 200h220z" fill="#fffdf7" stroke="currentColor" stroke-width="5"/>
          <path d="M102.5 57.5h55M75 105h110M47.5 152.5h165M102.5 57.5 130 105 157.5 57.5M75 105l27.5 47.5L130 105l27.5 47.5L185 105M47.5 152.5 75 200l27.5-47.5L130 200l27.5-47.5L185 200l27.5-47.5" fill="none" stroke="currentColor" stroke-width="3"/>
          <text x="130" y="91" text-anchor="middle">苹果</text>
          <text x="116" y="121" text-anchor="middle">apple</text>
          <text x="165" y="169" text-anchor="middle">🍎</text>
        </svg>
      </div>
    </header>

    <div class="tarsia-grid">
      <section class="builder" aria-label="Build a Tarsia puzzle">
        <section class="panel details-panel">
          <div class="panel-heading">
            <div>
              <span class="step-number">1</span>
              <p class="eyebrow"><%= t('tarsiaPuzzle.setupKicker') %></p>
              <h2><%= t('tarsiaPuzzle.nameSizeHeading') %></h2>
            </div>
          </div>
          <div class="form-grid">
            <label for="puzzleTitle"><%= t('tarsiaPuzzle.titleLabel') %>
              <input id="puzzleTitle" type="text" maxlength="60" value="Vocabulary Tarsia Puzzle">
            </label>
            <label for="puzzleSize"><%= t('tarsiaPuzzle.sizeLabel') %>
              <select id="puzzleSize">
                <option value="4" selected><%= t('tarsiaPuzzle.sizeOption1') %></option>
                <option value="3"><%= t('tarsiaPuzzle.sizeOption2') %></option>
              </select>
            </label>
          </div>
          <div class="mode-switch" role="group" aria-label="Choose content type">
            <button type="button" class="active" data-mode="vocabulary" aria-pressed="true"><%= t('tarsiaPuzzle.modeVocabulary') %></button>
            <button type="button" data-mode="qa" aria-pressed="false"><%= t('tarsiaPuzzle.modeQa') %></button>
          </div>
        </section>

        <section class="panel content-panel">
          <div class="panel-heading">
            <div>
              <span class="step-number">2</span>
              <p class="eyebrow"><%= t('tarsiaPuzzle.matchingContentKicker') %></p>
              <h2 id="contentHeading"><%= t('tarsiaPuzzle.contentHeadingVocabulary') %></h2>
            </div>
            <span class="pair-count" id="pairCount"><%= t('tarsiaPuzzle.pairCountInitial') %></span>
          </div>

          <div id="vocabularyControls">
            <button id="toggleWordLibrary" class="word-library-toggle" type="button" aria-expanded="false" aria-controls="wordLibraryPanel">
              <span class="word-library-toggle-icon" aria-hidden="true">🗂️</span>
              <span class="word-library-toggle-copy">
                <small><%= t('tarsiaPuzzle.wordLibraryToggleSmall') %></small>
                <strong><%= t('tarsiaPuzzle.wordLibraryToggleStrong') %></strong>
              </span>
              <span class="word-library-toggle-arrow" aria-hidden="true">⌄</span>
            </button>

            <div id="wordLibraryPanel" class="word-library-panel" hidden>
              <div id="wordListPicker"></div>
            </div>

            <label class="bulk-label" for="vocabularyInput">
              <span><%= t('tarsiaPuzzle.pasteVocabLabel') %></span>
              <span id="vocabularyFormat"><%= t('tarsiaPuzzle.vocabularyFormat') %></span>
              <textarea id="vocabularyInput" rows="10" maxlength="3200" spellcheck="true" placeholder="苹果 | apple | píng guǒ | 🍎&#10;香蕉 | banana | xiāng jiāo | 🍌"></textarea>
            </label>
            <button id="buildVocabularyPairs" class="btn-secondary inline-action" type="button"><%= t('tarsiaPuzzle.autoFillMatches') %></button>

            <fieldset class="side-choice" aria-describedby="sideChoiceHelp">
              <legend><%= t('tarsiaPuzzle.sideChoiceLegend') %></legend>
              <div class="side-options">
                <label class="side-option"><input type="checkbox" name="vocabSide" value="chinese" checked><span><%= t('tarsiaPuzzle.sideChinese') %></span></label>
                <label class="side-option"><input type="checkbox" name="vocabSide" value="english" checked><span><%= t('tarsiaPuzzle.sideEnglish') %></span></label>
                <label class="side-option"><input type="checkbox" name="vocabSide" value="pinyin"><span><%= t('tarsiaPuzzle.sidePinyin') %></span></label>
                <label class="side-option"><input type="checkbox" name="vocabSide" value="emoji"><span><%= t('tarsiaPuzzle.sideEmoji') %></span></label>
              </div>
              <p id="sideChoiceHelp"><strong id="sideChoiceCount"><%= t('tarsiaPuzzle.sideChoiceCountInitial') %></strong><%= t('tarsiaPuzzle.sideChoiceHelpSuffix') %></p>
            </fieldset>
          </div>

          <div id="qaControls" hidden>
            <div id="questionBankPicker"></div>
            <label class="bulk-label" for="qaInput">
              <span><%= t('tarsiaPuzzle.pasteQaLabel') %></span>
              <span><%= t('tarsiaPuzzle.qaHelp') %></span>
              <textarea id="qaInput" rows="10" maxlength="5200" spellcheck="true" placeholder="What is 1/2 as a decimal? | 0.5&#10;The capital of France is… | Paris"></textarea>
            </label>
            <button id="buildQaPairs" class="btn-secondary inline-action" type="button"><%= t('tarsiaPuzzle.buildMatchingPairs') %></button>
          </div>

          <div class="review-heading">
            <div>
              <p class="eyebrow"><%= t('tarsiaPuzzle.reviewHeadingKicker') %></p>
              <h3><%= t('tarsiaPuzzle.editSidesHeading') %></h3>
            </div>
            <button id="loadSample" class="text-button" type="button"><%= t('tarsiaPuzzle.loadSampleButton') %></button>
          </div>
          <div id="pairEditor" class="pair-editor" aria-live="polite"></div>
          <p id="validationMessage" class="validation-message" aria-live="polite"></p>
        </section>

        <section class="panel generate-panel">
          <div>
            <span class="step-number">3</span>
            <p class="eyebrow"><%= t('tarsiaPuzzle.generatePanelKicker') %></p>
            <h2><%= t('tarsiaPuzzle.generateHeading') %></h2>
            <p><%= t('tarsiaPuzzle.generateHelp') %></p>
          </div>
          <div class="generate-actions">
            <button id="generatePuzzle" class="btn-primary" type="button"><%= t('tarsiaPuzzle.generatePuzzleButton') %></button>
            <button id="reshufflePuzzle" class="btn-secondary" type="button"><%= t('tarsiaPuzzle.freshLayoutButton') %></button>
            <button id="clearPuzzle" class="text-button" type="button"><%= t('tarsiaPuzzle.clearAllButton') %></button>
          </div>
        </section>
      </section>

      <aside class="preview-panel" aria-label="Puzzle preview">
        <div class="preview-heading">
          <div>
            <p class="eyebrow"><%= t('tarsiaPuzzle.livePreviewKicker') %></p>
            <h2><%= t('tarsiaPuzzle.printablePagesHeading') %></h2>
          </div>
          <span id="previewStatus" class="ready-pill"><%= t('tarsiaPuzzle.previewStatusInitial') %></span>
        </div>
        <div class="preview-tabs" role="tablist" aria-label="Preview page">
          <button id="cutTab" class="active" type="button" role="tab" aria-selected="true" data-preview="cut"><%= t('tarsiaPuzzle.cutTab') %></button>
          <button id="answerTab" type="button" role="tab" aria-selected="false" data-preview="answer"><%= t('tarsiaPuzzle.answerTab') %></button>
        </div>
        <div id="pagePreview" class="page-preview" aria-label="Tarsia worksheet preview"></div>
        <p class="preview-note" id="previewNote"><%= t('tarsiaPuzzle.previewNoteInitial') %></p>
        <div class="download-actions">
          <button id="printPuzzle" class="btn-primary" type="button"><%= t('tarsiaPuzzle.printSavePdf') %></button>
          <button id="downloadPdf" class="btn-secondary" type="button"><%= t('tarsiaPuzzle.downloadPdf') %></button>
          <button id="downloadPptx" class="btn-secondary" type="button"><%= t('tarsiaPuzzle.downloadPptx') %></button>
        </div>
        <p class="export-note"><%= t('tarsiaPuzzle.exportNote') %></p>
      </aside>
    </div>
  </main>

  <section id="emojiPicker" class="emoji-picker" hidden aria-label="Choose a Twemoji picture">
    <div class="emoji-picker-card" role="dialog" aria-modal="true" aria-labelledby="emojiPickerTitle">
      <div class="emoji-picker-heading">
        <div>
          <p class="eyebrow"><%= t('tarsiaPuzzle.emojiPickerEyebrow') %></p>
          <h2 id="emojiPickerTitle"><%= t('tarsiaPuzzle.chooseAPicture') %></h2>
        </div>
        <button id="closeEmojiPicker" class="picker-close" type="button" aria-label="Close emoji picker">×</button>
      </div>
      <label for="emojiSearch"><%= t('tarsiaPuzzle.searchPicturesLabel') %>
        <input id="emojiSearch" type="search" placeholder="Try apple, weather, 学校…" autocomplete="off">
      </label>
      <div id="emojiGrid" class="emoji-grid"></div>
      <label class="custom-emoji" for="customEmoji"><%= t('tarsiaPuzzle.customEmojiLabel') %>
        <span>
          <input id="customEmoji" type="text" maxlength="12" placeholder="🐼">
          <button id="useCustomEmoji" class="btn-secondary" type="button"><%= t('tarsiaPuzzle.useButton') %></button>
        </span>
      </label>
      <p class="twemoji-credit"><%= t('tarsiaPuzzle.twemojiCredit') %></p>
    </div>
  </section>

  <div id="printPages" class="print-pages" aria-hidden="true"></div>
  <div id="tarsiaToast" class="toast" role="status" aria-live="polite"></div>

  <%- include('../partials/tool-guide', { toolGuide: toolGuide }) %>

  <script src="/shared/wordlist-core.js"></script>
  <script src="/shared/deck-export.js"></script>
  <script src="/shared/library-picker.js"></script>
  <!-- Twemoji artwork: Twitter, Inc. and contributors (CC-BY 4.0), loaded as SVGs from the official repository. -->
  <script src="/low-prep/tarsia-puzzle/tarsia-puzzle.js?v=topic-cards-1"></script>
  <script src="/javascripts/account-coming-soon.js"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
