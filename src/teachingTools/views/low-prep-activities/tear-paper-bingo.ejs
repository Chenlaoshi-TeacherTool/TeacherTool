<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#194f45">
    <title>Tear-Paper Bingo - Chen Laoshi's Teaching Toolkit</title>
    <%- include('../partials/seo', { pageDescription: 'Make a printable tear-paper bingo game for listening, reading, and Chinese vocabulary review.' }) %>
    <link rel="stylesheet" href="/stylesheets/site-theme.css">
    <style>
        .bingo-header { text-align: center; }
        .bingo-header .back-btn { position: absolute; top: 20px; left: 20px; }
        .bingo-header h1 { margin: 0 0 10px; font-size: clamp(2.2rem, 5vw, 3.4rem); }
        .bingo-header p { max-width: 640px; margin: 0 auto; font-size: 1.08rem; }
        .bingo-main { max-width: 1120px; margin: 0 auto; padding: 44px 20px 64px; }
        .bingo-overview { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 22px; align-items: start; margin-bottom: 26px; padding: 28px 30px; border: 1px solid var(--line); border-radius: 20px; background: var(--paper); box-shadow: var(--shadow); }
        .bingo-icon { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 19px; background: #fff0c5; font-size: 2rem; }
        .bingo-overview h2 { margin: 0 0 7px; color: var(--chalk); font-family: 'DM Serif Display', 'Noto Sans SC', serif; font-size: 1.8rem; font-weight: 400; }
        .bingo-overview p { max-width: 730px; margin: 0; color: var(--muted); }
        .bingo-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
        .how-to { display: grid; grid-template-columns: repeat(3, 1fr); gap: 13px; margin: 0 0 26px; }
        .how-to-step { padding: 21px; border: 1px solid #dce7cf; border-radius: 17px; background: #f3f8e9; }
        .how-to-step span { display: grid; place-items: center; width: 30px; height: 30px; margin-bottom: 11px; border-radius: 50%; background: var(--sun); color: var(--chalk-deep); font-weight: 900; }
        .how-to-step p { margin: 0; color: var(--ink); font-size: .96rem; }
        .preview-card { overflow: hidden; border: 1px solid var(--line); border-radius: 22px; background: var(--paper); box-shadow: var(--shadow); }
        .preview-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 20px 24px; border-bottom: 1px solid var(--line); background: #fff8df; }
        .preview-toolbar h2 { margin: 0; color: var(--chalk); font-family: 'DM Serif Display', 'Noto Sans SC', serif; font-size: 1.5rem; font-weight: 400; }
        .preview-toolbar p { margin: 2px 0 0; color: var(--muted); font-size: .9rem; }
        .download-btn { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 8px; padding: 10px 17px; text-decoration: none; }
        .pdf-frame { display: block; width: 100%; height: min(76vh, 880px); min-height: 610px; border: 0; background: #edf1e9; }
        .pdf-fallback { margin: 0; padding: 30px; color: var(--muted); text-align: center; }
        .pdf-fallback a { color: var(--coral); font-weight: 800; }
        @media (max-width: 760px) {
            .bingo-header .back-btn { top: 16px; left: 16px; }
            .bingo-main { padding: 30px 16px 46px; }
            .bingo-overview { grid-template-columns: 1fr; padding: 24px; }
            .how-to { grid-template-columns: 1fr; }
            .preview-toolbar { align-items: flex-start; flex-direction: column; padding: 20px; }
            .pdf-frame { height: 68vh; min-height: 520px; }
        }
    </style>
</head>
<body>
    <header class="header bingo-header">
        <a href="/teaching-tools#low-prep-activities" class="back-btn"><%= t('tearPaperBingo.backBtn') %></a>
        <h1>🟨 <%= t('tearPaperBingo.title') %></h1>
        <p><%= t('tearPaperBingo.subtitle') %></p>
    </header>

    <main class="bingo-main">
        <section class="bingo-overview" aria-labelledby="activity-overview-title">
            <div class="bingo-icon" aria-hidden="true">✂️</div>
            <div>
                <h2 id="activity-overview-title"><%= t('tearPaperBingo.overviewTitle') %></h2>
                <p><%= t('tearPaperBingo.overviewText') %></p>
                <div class="bingo-tags" aria-label="Activity details">
                    <span class="tag"><%= t('tearPaperBingo.tag1') %></span>
                    <span class="tag"><%= t('tearPaperBingo.tag2') %></span>
                    <span class="tag"><%= t('tearPaperBingo.tag3') %></span>
                    <span class="tag"><%= t('tearPaperBingo.tag4') %></span>
                </div>
            </div>
        </section>

        <section class="how-to" aria-label="How to use Tear-Paper Bingo">
            <article class="how-to-step">
                <span>1</span>
                <p><%= t('tearPaperBingo.step1') %></p>
            </article>
            <article class="how-to-step">
                <span>2</span>
                <p><%= t('tearPaperBingo.step2') %></p>
            </article>
            <article class="how-to-step">
                <span>3</span>
                <p><%= t('tearPaperBingo.step3') %></p>
            </article>
        </section>

        <section class="preview-card" aria-labelledby="preview-title">
            <div class="preview-toolbar">
                <div>
                    <h2 id="preview-title"><%= t('tearPaperBingo.previewTitle') %></h2>
                    <p><%= t('tearPaperBingo.previewText') %></p>
                </div>
                <a class="btn download-btn" href="/pdf/tear-paper-bingo-listening-reading.pdf" download="tear-paper-bingo-listening-reading.pdf"><%= t('tearPaperBingo.downloadBtn') %></a>
            </div>
            <iframe class="pdf-frame" src="/pdf/tear-paper-bingo-listening-reading.pdf#view=FitH" title="Tear-Paper Bingo PDF resource preview">
                <p class="pdf-fallback"><%= t('tearPaperBingo.pdfFallbackPrefix') %><a href="/pdf/tear-paper-bingo-listening-reading.pdf" download="tear-paper-bingo-listening-reading.pdf"><%= t('tearPaperBingo.pdfFallbackLinkText') %></a><%= t('tearPaperBingo.pdfFallbackSuffix') %></p>
            </iframe>
        </section>
    </main>
    <%- include('../partials/tool-guide', { toolGuide: toolGuide }) %>
    <script src="/javascripts/account-coming-soon.js"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
