<% var zh = lang === 'zh'; function L(en, cn) { return zh ? cn : en; } %><!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#356e57">
  <title>学生设计桌游 · Student-Designed Board Games - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'Student-designed board games for the classroom projector, starting with Escape the Path. Teams roll the dice and answer question cards you write or make from a word list. 学生自己设计的投影桌游，老师自定义题卡，全班分队玩。' }) %>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Andika:wght@400;700&display=swap">
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/shared/game-sharing.css?v=template1">
  <link rel="stylesheet" href="/low-prep/escape-the-path/escape-the-path.css?v=12">
</head>
<body class="ep-page">
  <main class="ep-wrap">
    <header class="ep-header">
      <a href="/teaching-tools#low-prep-activities" class="back-btn"><%= L('← Back to Teaching Tools', '← 返回教学工具') %></a>
      <p class="ep-eyebrow"><%= L('Projector board games · designed by students', '投影桌游 · 学生设计') %></p>
      <h1>🎲 <%= L('Student-Designed Board Games', '学生设计桌游') %></h1>
      <p><%= L('Board games my students designed. Project the board, split the class into teams and take turns rolling the dice. Land on 抽卡 and the team answers one of your question cards. Games so far: Escape the Path, Candy Race, Escape the Classroom, Mochi Salamander Escape, 太大一 and 汉字大富翁.', '我的学生自己设计的桌游。把棋盘投到屏幕上，全班分队轮流掷骰子，走到"抽卡"就答一张你出的题卡。现在有：Escape the Path、Candy Race、Escape the Classroom、Mochi Salamander Escape、太大一、汉字大富翁。') %></p>
    </header>

    <div class="ep-layout">
      <section class="ep-panel" aria-labelledby="epCardsHeading">
        <div class="ep-panel-head">
          <div>
            <p class="ep-kicker"><%= L('Step 1', '第一步') %></p>
            <h2 id="epCardsHeading"><%= L('Question cards', '题卡') %></h2>
          </div>
          <button id="epSaveTemplate" class="ep-btn ep-btn-ghost" type="button" disabled>💾 <%= L('Save', '保存') %></button>
        </div>

        <div class="ep-options" role="radiogroup" aria-label="<%= L('Where the cards come from', '题卡来源') %>">
          <label><input type="radio" name="epSource" value="own" checked> <span>✏️ <%= L('Write my own', '自己出题') %></span></label>
          <label><input type="radio" name="epSource" value="words"> <span>📚 <%= L('Make from a word list', '用词表出题') %></span></label>
        </div>

        <div id="epOwnBox" class="ep-source">
          <label for="epCards" class="ep-label"><%= L('One question per line', '每行一道题') %></label>
          <p class="ep-hint"><%= L('Add the answer after a | if you want one to reveal. Leave the box empty to try the sample cards.', '想显示参考答案，就在 | 后面写上。框里空着就用示例题。') %> <code>请用「旁边」说一句话。| 桌子旁边有一把椅子。</code></p>
          <textarea id="epCards" class="ep-input" rows="9" spellcheck="false" placeholder="请读出「客厅」。| kè tīng&#10;「书架」是什么意思？| bookshelf&#10;说一说，你的房间里有什么？&#10;一（把／张）椅子？| 一把椅子"></textarea>
        </div>

        <div id="epWordsBox" class="ep-source" hidden>
          <label for="epWords" class="ep-label"><%= L('One word per line', '每行一个词') %></label>
          <p class="ep-hint"><%= L('Pinyin and English are filled in for you. To set them yourself:', '拼音和英文会自动配好。也可以自己写：') %> <code>书架 | shū jià | bookshelf</code></p>
          <textarea id="epWords" class="ep-input" rows="7" spellcheck="false" placeholder="客厅&#10;书架&#10;旁边&#10;沙发&#10;窗户"></textarea>
          <fieldset class="ep-field">
            <legend><%= L('Card types', '题型') %></legend>
            <div class="ep-checks">
              <label><input type="checkbox" name="epType" value="read" checked> <%= L('Read it aloud (answer: pinyin)', '读一读（答案：拼音）') %></label>
              <label><input type="checkbox" name="epType" value="meaning" checked> <%= L('What does it mean? (answer: English)', '是什么意思？（答案：英文）') %></label>
              <label><input type="checkbox" name="epType" value="say"> <%= L('English → say it in Chinese', '看英文说中文') %></label>
              <label><input type="checkbox" name="epType" value="sentence"> <%= L('Make a sentence with the word', '用这个词说一句话') %></label>
            </div>
          </fieldset>
        </div>
        <p id="epCount" class="ep-count" role="status" aria-live="polite"></p>
      </section>

      <section class="ep-panel" aria-labelledby="epTeamsHeading">
        <p class="ep-kicker"><%= L('Step 2', '第二步') %></p>
        <h2 id="epTeamsHeading"><%= L('Pick a game and teams', '选游戏和分队') %></h2>

        <fieldset class="ep-field">
          <legend><%= L('Game', '玩哪一款') %></legend>
          <div class="ep-games">
            <label class="ep-game"><input type="radio" name="epGame" value="escape-the-path" checked>
              <img src="/low-prep/escape-the-path/board.webp?v=3" alt="" loading="lazy">
              <span><b>Escape the Path</b><small><%= L('Snakes, jail, step squares', '蛇、监狱、走几步') %></small></span></label>
            <label class="ep-game"><input type="radio" name="epGame" value="candy-race">
              <img src="/low-prep/candy-race/board.webp?v=6" alt="" loading="lazy">
              <span><b>Candy Race</b><small><%= L('Earn money, choose forks, buy an RV', '赚钱、选岔路、买房车') %></small></span></label>
            <label class="ep-game"><input type="radio" name="epGame" value="escape-classroom">
              <img src="/low-prep/escape-classroom/board.webp?v=3" alt="" loading="lazy">
              <span><b>Escape the Classroom</b><small><%= L('Sneak past the teacher, desk to desk', '绕着桌子跑，别被老师抓到') %></small></span></label>
            <label class="ep-game"><input type="radio" name="epGame" value="mochi">
              <img src="/low-prep/mochi/board.webp?v=2" alt="" loading="lazy">
              <span><b>Mochi Salamander Escape</b><small><%= L('Colour cards, shields, rescue the salamanders', '翻颜色卡、拿盾牌、救小火蜥') %></small></span></label>
            <label class="ep-game"><input type="radio" name="epGame" value="space">
              <img src="/low-prep/space/board.webp?v=1" alt="" loading="lazy">
              <span><b>太大一</b><small><%= L('Space loop: grow a moon into a star', '太空绕圈：月亮长成恒星') %></small></span></label>
            <label class="ep-game"><input type="radio" name="epGame" value="money">
              <img src="/low-prep/money/board.webp?v=2" alt="" loading="lazy">
              <span><b>汉字大富翁</b><small><%= L('Answer to buy land, collect rent', '答对买地，收租金') %></small></span></label>
          </div>
          <p class="ep-hint"><%= L('The same question cards work in every game.', '同一套题卡，每款游戏都能用。') %></p>
        </fieldset>

        <fieldset class="ep-field">
          <legend><%= L('Number of teams', '几队') %></legend>
          <div class="ep-options" id="epTeamCount">
            <% for (var n = 2; n <= 6; n++) { %>
            <label><input type="radio" name="epTeams" value="<%= n %>"<%= n === 4 ? ' checked' : '' %>> <span><%= n %></span></label>
            <% } %>
          </div>
        </fieldset>
        <div id="epNames" class="ep-names"></div>

        <fieldset class="ep-field" id="epLapsField" hidden>
          <legend><%= L('How many laps', '走几圈') %></legend>
          <div class="ep-options">
            <label><input type="radio" name="epLaps" value="1"> <span><%= L('1 lap (about 10 min)', '1 圈（约 10 分钟）') %></span></label>
            <label><input type="radio" name="epLaps" value="2" checked> <span><%= L('2 laps', '2 圈') %></span></label>
            <label><input type="radio" name="epLaps" value="3"> <span><%= L('3 laps', '3 圈') %></span></label>
          </div>
          <p class="ep-hint"><%= L('You can also press "End & count" any time during the game.', '游戏中也可以随时按"结算"提前结束。') %></p>
        </fieldset>

        <fieldset class="ep-field" id="epDeskField" hidden>
          <legend><%= L('Desk cards', '停在桌子上') %></legend>
          <div class="ep-options">
            <label><input type="radio" name="epDesk" value="phrase" checked> <span><%= L('Ask about the desk phrase', '用桌子上的话出情景题') %></span></label>
            <label><input type="radio" name="epDesk" value="cards"> <span><%= L('Use my question cards', '用我的题卡') %></span></label>
          </div>
          <label for="epDeskWords" class="ep-label"><%= L('Words on the desks (optional)', '桌上的字（可以不填）') %></label>
          <p class="ep-hint"><%= L('One word or phrase per line, written on the desks in order and repeated if there are fewer words than desks (21). Leave it empty to use the student\'s own words.', '每行一个词或短语，按顺序写到桌子上；词不够 21 个会重复使用。空着就用学生原来写的字。') %></p>
          <textarea id="epDeskWords" class="ep-input" rows="4" spellcheck="false" placeholder="你好&#10;谢谢&#10;对不起&#10;没关系&#10;再见"></textarea>
          <button id="epDeskFromWords" class="ep-btn ep-btn-ghost ep-btn-small" type="button"><%= L('Use my step-1 word list', '用第一步的词表') %></button>
          <p id="epDeskWordsHint" class="ep-hint" role="status"></p>
          <p class="ep-hint"><%= L('Polite phrases (你好, 对不起…) get a situation question; other words get "read it and make a sentence". Desks without a word use your cards.', '礼貌用语（你好、对不起……）会出情景题；其他词是"读一读，用它说一句话"。没写字的桌子用你的题卡。') %></p>
        </fieldset>

        <fieldset class="ep-field" id="epJailField">
          <legend><%= L('Leaving jail early', '提前出狱') %></legend>
          <p class="ep-hint"><%= L('A team in jail can skip the wait by answering this many cards in a row.', '在监狱里的队伍，连续答对几题就能马上出狱。') %></p>
          <div class="ep-options">
            <label><input type="radio" name="epJail" value="1"> <span><%= L('1 card', '1 题') %></span></label>
            <label><input type="radio" name="epJail" value="3"> <span><%= L('3 cards', '3 题') %></span></label>
            <label><input type="radio" name="epJail" value="5" checked> <span><%= L('5 cards (original)', '5 题（原版）') %></span></label>
          </div>
        </fieldset>

        <details class="ep-rules">
          <summary><%= L('How to play', '玩法') %></summary>
          <ol data-game="escape-the-path">
            <li><%= L('Roll the dice and move. Do what the square says.', '掷骰子走棋，按格子上写的做。') %></li>
            <li><%= L('抽卡 Draw a card: answer right and stay; answer wrong and move back one space. 抽四张卡 means four cards in a row.', '抽卡：答对留在原地，答错退一格。抽四张卡要连答四张。') %></li>
            <li><%= L('去监狱 Go to jail: wait two turns, then come out on the space after that 去监狱 square.', '去监狱：停两轮，出狱后回到那个"去监狱"格的下一格。') %></li>
            <li><%= L('In jail you can also try to answer cards in a row to leave at once, unless the next space is 结束: then you have to wait.', '在监狱里也可以挑战连续答题，答对就马上出狱。但如果下一格就是"结束"，不能挑战，只能等。') %></li>
            <li><%= L('往前走 / 往后走 Move ahead or back, 从蛇身上滑下去 slide along the snake, 再来一次 roll again.', '往前走几步、往后走几步、从蛇身上滑下去：照做。再来一次：再掷一次。') %></li>
            <li><%= L('Teams that reach 结束 take 第一名, 第二名 and 第三名. The game ends when three teams are in (or only one team is left).', '到达"结束"的队伍依次拿第一名、第二名、第三名。三个名次出来后游戏结束（或只剩一队还没到）。') %></li>
          </ol>
          <ol data-game="money" hidden>
            <li><%= L('Every team starts with $1000. Passing 起点 pays $200.', '每队开始有 $1000。经过起点拿 $200。') %></li>
            <li><%= L('Unowned land: answer a card. Right = you may buy it ($100 / $150 / $200).', '没人买的地：答一张卡，答对就可以买（$100 / $150 / $200）。') %></li>
            <li><%= L('Someone else\'s land: pay the owner $100. A team that cannot pay is out.', '别人的地：付给主人 $100。付不起就破产出局。') %></li>
            <li><%= L('? special card: right = $100. Your own land and other squares: right = $50.', '❓ 特别卡：答对得 $100。自己的地和其他格子：答对得 $50。') %></li>
            <li><%= L('Banana peel or jail: skip a turn. Airplane: fly back to 起点 (+$200).', '香蕉皮或监狱：停一轮。飞机：飞回起点（+$200）。') %></li>
            <li><%= L('After the laps (or when you press End & count), teams rank by money + land value.', '走完圈数（或按"结算"）后，按钱数加地价排名次。') %></li>
          </ol>
          <ol data-game="space" hidden>
            <li><%= L('Start at 开始, go once round the loop, then up the diagonal to 结果.', '从"开始"出发，绕一圈，再走对角线到"结果"。') %></li>
            <li><%= L('Green and yellow squares: forward 3. Red, orange and teal: back 3. Black hole: back 6. Cobweb (you died): back to the start.', '绿色、黄色格前进 3 格；红色、橙色、青色格后退 3 格；黑洞后退 6 格；蜘蛛网（you died）回到起点。') %></li>
            <li><%= L('拿卡片: answer a card. Right = grow one step: 🌙 moon → 🪐 dwarf planet → 🌍 planet → ⭐ star. Wrong = back one square.', '拿卡片：回答一张卡。答对升一级：🌙 月亮 → 🪐 矮行星 → 🌍 行星 → ⭐ 恒星；答错后退一格。') %></li>
            <li><%= L('Rolling past 结果 lands on "you died": back to the start of the diagonal.', '走过"结果"就到了"you died"：回到对角线的起点。') %></li>
            <li><%= L('To win, reach 结果 with a star. Without one you stay on 结果 and answer a card each turn until you form it. The first three teams win.', '带着恒星到"结果"才算赢。还没有恒星就留在"结果"，每轮回答一张卡，直到形成恒星。最先完成的三队获胜。') %></li>
          </ol>
          <ol data-game="mochi" hidden>
            <li><%= L('Start at 开始 and reach 结束 出口. Roll the die as a colour card: 1 yellow, 2 red, 3 blue, 4 green, 5 alarm, 6 step to any neighbouring square.', '从"开始"出发，走到"结束 出口"。掷骰子当颜色卡：1 黄、2 红、3 蓝、4 绿、5 警报、6 走到旁边任意一格。') %></li>
            <li><%= L('A colour sends you to the nearest square of that colour (choose if two are as near).', '翻到什么颜色，就走到离你最近的那个颜色的格子；两个一样近就自己选。') %></li>
            <li><%= L('Plain squares: answer a card. Right stays, wrong goes back. 问题 L1: right = one more step. L2: right = a shield. L3: right = an action card. 抽动作卡: take one. 走一步: step on.', '普通格答一张题卡：答对留下，答错退回去。问题 L1 答对多走一格，L2 答对得盾牌，L3 答对得动作卡。"抽动作卡"直接拿一张，"走一步"再走一格。') %></li>
            <li><%= L('Alarm: answer the alarm question. Right rescues a mochi salamander 🦎 (it breaks ties). Wrong: back one square, unless a shield blocks it.', '警报：回答警报题。答对救出一只麻糬小火蜥 🦎（名次一样时比谁救得多）；答错退一格，有盾牌可以挡住。') %></li>
            <li><%= L('Action cards (move twice, shield, swap with the leading team, push the leading team back) work from the next round, after a right answer.', '动作卡（再走一次、盾牌、和最前面的队换位置、让最前面的队退一格）下一轮起才能用，而且要先答对一题。') %></li>
            <li><%= L('The first three teams out of the exit win.', '最先走到出口的三队获胜。') %></li>
          </ol>
          <ol data-game="escape-classroom" hidden>
            <li><%= L('Start at 开始 and escape through the door at 结束. Roll: 1–2 = half a table, 3–4 = one table, 5–6 = one and a half tables.', '从"开始"出发，从"结束"的门逃出去。掷骰子：1–2 点走半张桌子，3–4 点走一张，5–6 点走一张半。') %></li>
            <li><%= L('On a desk, answer a card. Right: flip a special card. Wrong: back half a table.', '停在桌子上要回答一张卡。答对翻一张特别卡；答错退半张桌子。') %></li>
            <li><%= L('Special cards: 🛡️ shield blocks the teacher once, 🚀 bullet goes one and a half tables, 💥 Dang it sends you to prison, 🎉 Yay gets you out of prison (keep it).', '特别卡：🛡️ 盾牌挡老师一次；🚀 子弹再走一张半桌子；💥 Dang it 去监狱；🎉 Yay 出狱（可以留着用）。') %></li>
            <li><%= L('After every round the teacher walks two steps toward the leading team. Caught in the aisle: prison for two turns. Desks are safe.', '每轮结束，老师朝最前面的队走两步。在过道被抓到就进监狱停两轮。站在桌子上很安全。') %></li>
            <li><%= L('The first three teams out of the door win.', '最先从门逃出去的三队获胜。') %></li>
          </ol>
          <ol data-game="candy-race" hidden>
            <li><%= L('Start at 开始 and roll the dice. At a 岔路 fork, the team chooses which way to go.', '从"开始"出发，掷骰子走。走到"岔路"，由这一队自己选往哪走。') %></li>
            <li><%= L('Coloured squares and $ squares: answer a card. Right: earn the money ($ squares pay what they show, coloured squares pay $40). Wrong: no money, and go back to where you were before this roll.', '彩色格和 $ 格：答一张题卡。答对拿钱（$ 格按上面写的给，彩色格给 $40）；答错不给钱，回到这次掷骰子前的位置。') %></li>
            <li><%= L('Candy tails are side paths: walk in to collect money, and the arrow brings you back to the main path.', '有糖果的尾巴是岔出去的小路，可以进去赚钱，走到头顺着箭头回到大路。') %></li>
            <li><%= L('The bridge (桥) is a shortcut, open only to teams with at least $200.', '桥是近路，手上有 $200 才能走。') %></li>
            <li><%= L('With $350 a team can buy an RV (房车) by answering a card. The RV gets the team out of jail, up to 3 times. (The student wrote $2000 and $3500; the board pays in small amounts, so the prices are scaled down.)', '有 $350 可以答一张题卡买房车，房车能帮你出监狱，最多用 3 次。（学生原规则写的是 $2000 和 $3500，棋盘上的钱比较小，所以按比例改小了。）') %></li>
            <li><%= L('去监狱: wait two turns, then come out on the next square.', '去监狱：停两轮，出狱后走到下一格。') %></li>
            <li><%= L('Teams that reach 终点 take first, second and third place. The game ends when three teams are in.', '到达"终点"的队伍依次拿第一、二、三名，三个名次出来后游戏结束。') %></li>
          </ol>
        </details>

        <div id="epZhSlot" class="zh-script-slot"></div>
        <p id="epError" class="ep-error" role="alert"></p>
        <button id="epStart" class="ep-btn ep-btn-big" type="button">▶ <%= L('Start the game', '开始游戏') %></button>
      </section>
    </div>
    <p class="ep-credit"><%= L('Boards and original games designed by students.', '棋盘和原版游戏由学生设计。') %></p>
  </main>

  <div id="epStage" class="ep-stage" hidden>
    <div class="ep-stage-board" id="epBoardArea">
      <div class="ep-board" id="epBoard">
        <img id="epBoardImg" src="/low-prep/escape-the-path/board.webp?v=3" alt="<%= L('Student-drawn game board', '学生手绘的棋盘') %>" draggable="false">
        <svg class="ep-overlay" viewBox="0 0 2494 2076" aria-hidden="true">
          <defs><marker id="epArrow" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="4" markerHeight="4" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="#20473a"></path></marker></defs>
          <path id="epConnector" class="ep-connector" d="" marker-end="url(#epArrow)"></path>
          <g id="epMarks"></g>
          <circle id="epTarget" class="ep-target" r="46" cx="-100" cy="-100"></circle>
        </svg>
        <div id="epTokens" class="ep-tokens" aria-hidden="true"></div>
        <div id="epToast" class="ep-toast" aria-hidden="true"></div>
      </div>

      <div id="epCard" class="ep-card-layer" hidden>
        <div class="ep-card" role="dialog" aria-modal="false" aria-labelledby="epCardQ">
          <div class="ep-card-top">
            <span id="epCardTeam" class="ep-card-team"></span>
            <span id="epCardCount" class="ep-card-count"></span>
          </div>
          <p id="epCardLabel" class="ep-card-label"></p>
          <p id="epCardQ" class="ep-card-q" tabindex="-1"></p>
          <button id="epReveal" class="ep-btn ep-btn-ghost" type="button"><%= L('Show answer', '显示答案') %></button>
          <p id="epCardA" class="ep-card-a" hidden></p>
          <div class="ep-card-judge">
            <button id="epCorrect" class="ep-btn ep-btn-yes" type="button">✓ <%= L('Correct', '答对') %></button>
            <button id="epWrong" class="ep-btn ep-btn-no" type="button">✗ <%= L('Wrong', '答错') %></button>
          </div>
        </div>
      </div>

      <div id="epResults" class="ep-card-layer" hidden>
        <div class="ep-card ep-results" role="dialog" aria-labelledby="epResultsTitle">
          <h2 id="epResultsTitle">🏆 <%= L('Results', '比赛结果') %></h2>
          <ol id="epRanking" class="ep-ranking"></ol>
          <div class="ep-card-judge">
            <button id="epAgain" class="ep-btn" type="button">🔁 <%= L('Play again', '再玩一局') %></button>
            <button id="epCloseResults" class="ep-btn ep-btn-ghost" type="button"><%= L('Look at the board', '看看棋盘') %></button>
          </div>
        </div>
      </div>
    </div>

    <aside class="ep-side">
      <div class="ep-turn" id="epTurnBox">
        <span id="epTurnToken" class="ep-token-face"></span>
        <div>
          <p class="ep-turn-label"><%= L('Now playing', '现在轮到') %></p>
          <h2 id="epTurnName" aria-live="polite"></h2>
        </div>
      </div>

      <div class="ep-dice-row">
        <button id="epDie" class="ep-die" type="button" aria-label="<%= L('Roll the dice', '掷骰子') %>" data-face="1"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></button>
        <p id="epStatus" class="ep-status" role="status"></p>
      </div>

      <div class="ep-actions">
        <button id="epRoll" class="ep-btn ep-btn-big" type="button">🎲 <%= L('Roll', '掷骰子') %></button>
        <div id="epManual" class="ep-manual" hidden>
          <p><%= L('Rolled a real die? Tap the number:', '用的是真骰子？点点数：') %></p>
          <div><% for (var f = 1; f <= 6; f++) { %><button type="button" class="ep-btn ep-btn-ghost" data-roll="<%= f %>"><%= f %></button><% } %></div>
        </div>
        <div id="epFork" class="ep-fork" hidden></div>
        <button id="epBuy" class="ep-btn ep-btn-ghost" type="button" hidden></button>
        <button id="epUseRv" class="ep-btn ep-btn-big" type="button" hidden></button>
        <button id="epChallenge" class="ep-btn ep-btn-big" type="button" hidden></button>
        <button id="epWait" class="ep-btn ep-btn-ghost" type="button" hidden>⏳ <%= L('Wait this turn', '这轮等待') %></button>
        <button id="epNext" class="ep-btn ep-btn-big" type="button" hidden><%= L('Next team ▶', '下一队 ▶') %></button>
      </div>

      <ol id="epTeamList" class="ep-team-list"></ol>

      <div class="ep-side-tools">
        <label class="ep-check"><input type="checkbox" id="epRealDie"> <%= L('Real die', '用真骰子') %></label>
        <button id="epRulesBtn" class="ep-btn ep-btn-ghost ep-btn-small" type="button"><%= L('Rules', '规则') %></button>
        <button id="epEndGame" class="ep-btn ep-btn-ghost ep-btn-small" type="button" hidden>🧮 <%= L('End & count', '结算') %></button>
        <button id="epFullscreen" class="ep-btn ep-btn-ghost ep-btn-small" type="button"><%= L('Full screen', '全屏') %></button>
        <button id="epExit" class="ep-btn ep-btn-ghost ep-btn-small" type="button"><%= L('Settings', '返回设置') %></button>
      </div>
      <p class="ep-side-credit"><%= L('Board designed by a student', '棋盘由学生设计') %></p>
    </aside>

    <dialog id="epRulesDialog" class="ep-rules-dialog">
      <h2><%= L('How to play', '玩法') %></h2>
      <ol id="epRulesList"></ol>
      <form method="dialog"><button class="ep-btn" type="submit"><%= L('Got it', '知道了') %></button></form>
    </dialog>
  </div>

  <%- include('../partials/tool-guide', { toolGuide: toolGuide }) %>

  <script src="/shared/zh-script.js?v=4"></script>
  <script src="/shared/zh-content.js?v=4"></script>
  <script src="/shared/wordlist-core.js?v=zh-1"></script>
  <script src="/shared/wordlist-handoff.js?v=1"></script>
  <script src="/shared/game-template.js?v=4" defer></script>
  <script src="/low-prep/escape-the-path/escape-the-path-core.js?v=10"></script>
  <script src="/low-prep/candy-race/candy-race-core.js?v=6"></script>
  <script src="/low-prep/escape-classroom/escape-classroom-core.js?v=3"></script>
  <script src="/low-prep/mochi/mochi-core.js?v=2"></script>
  <script src="/low-prep/space/space-core.js?v=1"></script>
  <script src="/low-prep/money/money-core.js?v=2"></script>
  <script src="/low-prep/escape-the-path/escape-the-path.js?v=16" defer></script>
  <script src="/javascripts/account-coming-soon.js"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
