<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#356e57">
  <title>Image Revealer - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'Upload photos, cover them in a grid, and reveal one tile at a time as a guessing warm-up. Images stay in your browser and never touch a server.' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/low-prep/image-revealer/image-revealer.css?v=fullscreen-fallback-1">
</head>
<body class="reveal-page">
  <main class="reveal-wrap">
    <header class="reveal-header">
      <div class="reveal-header-content">
        <a href="/teaching-tools#low-prep-activities" class="back-btn">← Back to Teaching Tools</a>
        <p class="reveal-eyebrow">Guessing warm-up</p>
        <h1>🖼️ Image Revealer</h1>
        <p>Upload as many pictures as you like, pick a grid size, then click Start and watch the tiles disappear one by one until the whole picture is revealed. Great for guess-the-picture warm-ups, vocabulary reviews, or "what do you see" discussions.</p>
        <div class="reveal-hero-points" aria-label="Tool highlights">
          <span>Images never leave your browser</span>
          <span>Any grid size, any reveal speed</span>
          <span>Click Next Image to move on</span>
        </div>
      </div>
    </header>

    <div class="reveal-layout">
      <section class="reveal-builder" aria-label="Set up the game">
        <section class="reveal-panel">
          <div class="reveal-panel-heading">
            <div>
              <span class="reveal-step">1</span>
              <p class="reveal-kicker">Images</p>
              <h2>Upload your pictures</h2>
            </div>
          </div>
          <label class="reveal-upload-drop" for="image-input">
            <input id="image-input" type="file" accept="image/*" multiple hidden>
            <span class="reveal-upload-icon" aria-hidden="true">＋</span>
            <span class="reveal-upload-text">Click to choose images (you can select several at once)</span>
          </label>
          <p class="reveal-help">Images are read directly in your browser and are never uploaded anywhere.</p>
          <ul id="image-list" class="reveal-image-list" aria-label="Uploaded images"></ul>
        </section>

        <section class="reveal-panel">
          <div class="reveal-panel-heading">
            <div>
              <span class="reveal-step">2</span>
              <p class="reveal-kicker">Grid</p>
              <h2>How many tiles?</h2>
            </div>
          </div>
          <div class="reveal-preset-row" role="group" aria-label="Grid presets">
            <button type="button" class="reveal-preset" data-rows="3" data-cols="3">3 × 3</button>
            <button type="button" class="reveal-preset is-active" data-rows="5" data-cols="5">5 × 5</button>
            <button type="button" class="reveal-preset" data-rows="6" data-cols="8">6 × 8</button>
            <button type="button" class="reveal-preset" data-rows="8" data-cols="10">8 × 10</button>
          </div>
          <div class="reveal-form-grid">
            <label for="grid-rows">Rows
              <input id="grid-rows" type="number" min="1" max="14" step="1" value="5">
            </label>
            <label for="grid-cols">Columns
              <input id="grid-cols" type="number" min="1" max="14" step="1" value="5">
            </label>
          </div>
        </section>

        <section class="reveal-panel">
          <div class="reveal-panel-heading">
            <div>
              <span class="reveal-step">3</span>
              <p class="reveal-kicker">Reveal</p>
              <h2>How should it reveal?</h2>
            </div>
          </div>
          <div class="reveal-mode-switch" role="radiogroup" aria-label="Reveal order">
            <label><input type="radio" name="revealOrder" value="random" checked> Random tiles</label>
            <label><input type="radio" name="revealOrder" value="sequential"> Row by row</label>
          </div>
          <label for="reveal-speed">Seconds between tiles: <output id="speed-value">1.0</output>s
            <input id="reveal-speed" type="range" min="0.2" max="4" step="0.1" value="1">
          </label>
        </section>

        <p id="setup-status" class="reveal-setup-status" aria-live="polite">Upload at least one image to begin.</p>
      </section>

      <section class="reveal-preview-panel" aria-label="Reveal stage">
        <div class="reveal-preview-heading">
          <h2>Reveal stage</h2>
          <p id="progress-text" class="reveal-progress-text">No image loaded yet.</p>
        </div>

        <div id="reveal-stage" class="reveal-stage">
          <p class="reveal-stage-empty">Upload images on the left, then click Start.</p>
        </div>

        <div class="reveal-stage-controls">
          <button id="start-button" class="reveal-primary" type="button" disabled>▶ Start</button>
          <button id="pause-button" class="reveal-secondary" type="button" disabled>⏸ Pause</button>
          <button id="reveal-all-button" class="reveal-secondary" type="button" disabled>⏭ Reveal all</button>
          <button id="restart-button" class="reveal-secondary" type="button" disabled>↺ Restart image</button>
          <button id="fullscreen-button" class="reveal-secondary" type="button" disabled>⛶ Fullscreen</button>
        </div>
        <div class="reveal-nav-controls">
          <button id="prev-button" class="reveal-secondary" type="button" disabled>← Previous</button>
          <button id="next-button" class="reveal-primary" type="button" disabled>Next image →</button>
        </div>
      </section>
    </div>
  </main>

  <%- include('../partials/tool-guide', { toolGuide: toolGuide }) %>

  <script src="/low-prep/image-revealer/image-revealer.js?v=fullscreen-fallback-1" defer></script>
  <script src="/javascripts/account-coming-soon.js"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
