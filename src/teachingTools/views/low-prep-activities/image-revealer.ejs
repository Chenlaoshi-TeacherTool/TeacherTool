<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#356e57">
  <title>Image Revealer - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'Upload photos, cover them in a grid, and reveal one tile at a time as a guessing warm-up. Images stay in your browser and never touch a server.' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/low-prep/image-revealer/image-revealer.css?v=fullscreen-fallback-1">
</head>
<body class="reveal-page">
  <main class="reveal-wrap">
    <header class="reveal-header">
      <div class="reveal-header-content">
        <a href="/teaching-tools#low-prep-activities" class="back-btn"><%= t('imageRevealer.backBtn') %></a>
        <p class="reveal-eyebrow"><%= t('imageRevealer.eyebrow') %></p>
        <h1>🖼️ <%= t('imageRevealer.title') %></h1>
        <p><%= t('imageRevealer.subtitle') %></p>
        <div class="reveal-hero-points" aria-label="Tool highlights">
          <span><%= t('imageRevealer.heroPoint1') %></span>
          <span><%= t('imageRevealer.heroPoint2') %></span>
          <span><%= t('imageRevealer.heroPoint3') %></span>
        </div>
      </div>
    </header>

    <div class="reveal-layout">
      <section class="reveal-builder" aria-label="Set up the game">
        <section class="reveal-panel">
          <div class="reveal-panel-heading">
            <div>
              <span class="reveal-step">1</span>
              <p class="reveal-kicker"><%= t('imageRevealer.imagesKicker') %></p>
              <h2><%= t('imageRevealer.uploadHeading') %></h2>
            </div>
          </div>
          <label class="reveal-upload-drop" for="image-input">
            <input id="image-input" type="file" accept="image/*" multiple hidden>
            <span class="reveal-upload-icon" aria-hidden="true">＋</span>
            <span class="reveal-upload-text"><%= t('imageRevealer.uploadText') %></span>
          </label>
          <p class="reveal-help"><%= t('imageRevealer.uploadHelp') %></p>
          <ul id="image-list" class="reveal-image-list" aria-label="Uploaded images"></ul>
        </section>

        <section class="reveal-panel">
          <div class="reveal-panel-heading">
            <div>
              <span class="reveal-step">2</span>
              <p class="reveal-kicker"><%= t('imageRevealer.gridKicker') %></p>
              <h2><%= t('imageRevealer.gridHeading') %></h2>
            </div>
          </div>
          <div class="reveal-preset-row" role="group" aria-label="Grid presets">
            <button type="button" class="reveal-preset" data-rows="3" data-cols="3">3 × 3</button>
            <button type="button" class="reveal-preset is-active" data-rows="5" data-cols="5">5 × 5</button>
            <button type="button" class="reveal-preset" data-rows="6" data-cols="8">6 × 8</button>
            <button type="button" class="reveal-preset" data-rows="8" data-cols="10">8 × 10</button>
          </div>
          <div class="reveal-form-grid">
            <label for="grid-rows"><%= t('imageRevealer.rowsLabel') %>
              <input id="grid-rows" type="number" min="1" max="14" step="1" value="5">
            </label>
            <label for="grid-cols"><%= t('imageRevealer.colsLabel') %>
              <input id="grid-cols" type="number" min="1" max="14" step="1" value="5">
            </label>
          </div>
        </section>

        <section class="reveal-panel">
          <div class="reveal-panel-heading">
            <div>
              <span class="reveal-step">3</span>
              <p class="reveal-kicker"><%= t('imageRevealer.revealKicker') %></p>
              <h2><%= t('imageRevealer.revealHeading') %></h2>
            </div>
          </div>
          <div class="reveal-mode-switch" role="radiogroup" aria-label="Reveal order">
            <label><input type="radio" name="revealOrder" value="random" checked> <%= t('imageRevealer.revealRandom') %></label>
            <label><input type="radio" name="revealOrder" value="sequential"> <%= t('imageRevealer.revealSequential') %></label>
          </div>
          <label for="reveal-speed"><%= t('imageRevealer.speedLabel') %> <output id="speed-value">1.0</output>s
            <input id="reveal-speed" type="range" min="0.2" max="4" step="0.1" value="1">
          </label>
        </section>

        <p id="setup-status" class="reveal-setup-status" aria-live="polite"><%= t('imageRevealer.setupStatus') %></p>
      </section>

      <section class="reveal-preview-panel" aria-label="Reveal stage">
        <div class="reveal-preview-heading">
          <h2><%= t('imageRevealer.stageHeading') %></h2>
          <p id="progress-text" class="reveal-progress-text"><%= t('imageRevealer.progressEmpty') %></p>
        </div>

        <div id="reveal-stage" class="reveal-stage">
          <p class="reveal-stage-empty"><%= t('imageRevealer.stageEmpty') %></p>
        </div>

        <div class="reveal-stage-controls">
          <button id="start-button" class="reveal-primary" type="button" disabled>▶ <%= t('imageRevealer.startButton') %></button>
          <button id="pause-button" class="reveal-secondary" type="button" disabled>⏸ <%= t('imageRevealer.pauseButton') %></button>
          <button id="reveal-all-button" class="reveal-secondary" type="button" disabled>⏭ <%= t('imageRevealer.revealAllButton') %></button>
          <button id="restart-button" class="reveal-secondary" type="button" disabled>↺ <%= t('imageRevealer.restartButton') %></button>
          <button id="fullscreen-button" class="reveal-secondary" type="button" disabled>⛶ <%= t('imageRevealer.fullscreenButton') %></button>
        </div>
        <div class="reveal-nav-controls">
          <button id="prev-button" class="reveal-secondary" type="button" disabled>← <%= t('imageRevealer.previousButton') %></button>
          <button id="next-button" class="reveal-primary" type="button" disabled><%= t('imageRevealer.nextImageButton') %> →</button>
        </div>
      </section>
    </div>
  </main>

  <%- include('../partials/tool-guide', { toolGuide: toolGuide }) %>

  <script src="/low-prep/image-revealer/image-revealer.js?v=fullscreen-fallback-1" defer></script>
  <script src="/javascripts/account-coming-soon.js"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
