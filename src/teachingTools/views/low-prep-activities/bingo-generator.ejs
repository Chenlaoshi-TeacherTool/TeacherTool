<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#315f4f">
  <title>Bingo Generator - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'Turn any list of vocabulary or sentences into a set of unique, printable bingo sheets in Chinese, English, pinyin, or all three.' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/shared/library-picker.css">
  <link rel="stylesheet" href="/low-prep/bingo-generator/bingo-generator.css">
</head>
<body class="bingo-page">
  <main class="bingo-wrap">
    <header class="bingo-hero">
      <div class="bingo-hero-copy">
        <a class="back-link" href="/teaching-tools#low-prep-activities"><%= t('bingoGenerator.backLink') %></a>
        <p class="eyebrow"><%= t('bingoGenerator.eyebrow') %></p>
        <h1><span aria-hidden="true">🎯</span> <%= t('bingoGenerator.title') %></h1>
        <p><%= t('bingoGenerator.subtitle') %></p>
        <div class="hero-points" aria-label="Tool highlights">
          <span><%= t('bingoGenerator.heroPoint1') %></span>
          <span><%= t('bingoGenerator.heroPoint2') %></span>
          <span><%= t('bingoGenerator.heroPoint3') %></span>
        </div>
      </div>
    </header>

    <div class="bingo-grid">
      <section class="builder" aria-label="Build a bingo game">
        <form id="bingo-form">
          <section class="panel">
            <div class="panel-heading">
              <div>
                <span class="step-number">1</span>
                <p class="eyebrow"><%= t('bingoGenerator.setupKicker') %></p>
                <h2><%= t('bingoGenerator.nameYourGame') %></h2>
              </div>
              <button id="load-example" class="ghost-button" type="button"><%= t('bingoGenerator.loadExample') %></button>
            </div>
            <div class="form-grid">
              <label for="title"><%= t('bingoGenerator.titleLabel') %>
                <input id="title" type="text" maxlength="70" placeholder="<%= t('bingoGenerator.titlePlaceholder') %>" value="Vocabulary Bingo">
              </label>
              <label for="sheets"><%= t('bingoGenerator.sheetsLabel') %>
                <input id="sheets" type="number" min="1" max="60" step="1" value="10" required>
              </label>
            </div>
            <div class="form-grid">
              <label for="gridSize"><%= t('bingoGenerator.gridSizeLabel') %>
                <select id="gridSize">
                  <option value="5" selected><%= t('bingoGenerator.gridOption5') %></option>
                  <option value="4"><%= t('bingoGenerator.gridOption4') %></option>
                </select>
              </label>
              <label class="checkbox-field" for="freeSpace">
                <input id="freeSpace" type="checkbox" checked>
                <%= t('bingoGenerator.freeSpaceLabel') %>
              </label>
            </div>
          </section>

          <section class="panel">
            <div class="panel-heading">
              <div>
                <span class="step-number">2</span>
                <p class="eyebrow"><%= t('bingoGenerator.contentKicker') %></p>
                <h2><%= t('bingoGenerator.addTermsHeading') %></h2>
              </div>
            </div>
            <label for="terms"><%= t('bingoGenerator.termsLabel') %>
              <textarea id="terms" class="terms-textarea" required placeholder="猫 | māo | cat&#10;狗 | gǒu | dog&#10;鸟 | niǎo | bird"></textarea>
            </label>
            <p class="field-help"><%= t('bingoGenerator.formatHelpPrefix') %><strong><%= t('bingoGenerator.formatHelpFields') %></strong><%= t('bingoGenerator.formatHelpSuffix') %></p>
            <p id="term-count" class="term-count" aria-live="polite"><%= t('bingoGenerator.termCountEmpty') %></p>
            <div id="bingoLibraryPicker"></div>
          </section>

          <section class="panel">
            <div class="panel-heading">
              <div>
                <span class="step-number">3</span>
                <p class="eyebrow"><%= t('bingoGenerator.displayKicker') %></p>
                <h2><%= t('bingoGenerator.displayHeading') %></h2>
              </div>
            </div>
            <div class="mode-switch" role="radiogroup" aria-label="Display language">
              <label><input type="radio" name="displayMode" value="zh" checked> <%= t('bingoGenerator.modeZh') %></label>
              <label><input type="radio" name="displayMode" value="en"> <%= t('bingoGenerator.modeEn') %></label>
              <label><input type="radio" name="displayMode" value="py"> <%= t('bingoGenerator.modePy') %></label>
              <label><input type="radio" name="displayMode" value="all"> <%= t('bingoGenerator.modeAll') %></label>
            </div>
          </section>

          <div class="form-footer">
            <button class="generate-button" type="submit"><%= t('bingoGenerator.generateButton') %></button>
            <p id="generation-status" class="generation-status" aria-live="polite"></p>
          </div>
          <div class="download-row">
            <button id="download-word" class="download-button" type="button" disabled><%= t('bingoGenerator.downloadWord') %></button>
            <button id="print-pdf" class="download-button" type="button" disabled><%= t('bingoGenerator.printPdf') %></button>
          </div>
        </form>
      </section>

      <section class="preview-panel" aria-label="Generated bingo sheets">
        <div class="preview-heading">
          <h2><%= t('bingoGenerator.previewHeading') %></h2>
          <p><%= t('bingoGenerator.previewHelp') %></p>
        </div>
        <div id="preview-area" class="preview-area">
          <p class="preview-empty"><%= t('bingoGenerator.previewEmptyPrefix') %>“<%= t('bingoGenerator.generateButton') %>”<%= t('bingoGenerator.previewEmptySuffix') %></p>
        </div>
      </section>
    </div>
  </main>

  <%- include('../partials/tool-guide', { toolGuide: toolGuide }) %>

  <script src="/shared/wordlist-core.js"></script>
  <script src="/shared/library-picker.js"></script>
  <script src="/vendor/docx.iife.js" defer></script>
  <script src="/low-prep/bingo-generator/bingo-generator.js" defer></script>
  <script src="/javascripts/account-coming-soon.js"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
