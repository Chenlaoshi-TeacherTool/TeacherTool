<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#356e57">
  <title>Maze Generator - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'Create a printable, editable PowerPoint maze from eight questions and answers for your Chinese language classroom.' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/shared/library-picker.css">
  <link rel="stylesheet" href="/low-prep/maze-generator/maze-generator.css?v=single-pair-input-1">
</head>
<body class="maze-page">
  <main class="maze-wrap">
    <header class="maze-header">
      <div class="maze-header-content">
        <a href="/teaching-tools#low-prep-activities" class="back-btn"><%= t('mazeGenerator.backBtn') %></a>
        <p class="maze-eyebrow"><%= t('mazeGenerator.eyebrow') %></p>
        <h1>🧭 <%= t('mazeGenerator.title') %></h1>
        <p><%= t('mazeGenerator.subtitle') %></p>
      </div>
      <figure class="maze-header-sample">
        <img src="/images/maze-generator-sample.png" alt="Sample four seasons vocabulary maze worksheet">
        <figcaption><%= t('mazeGenerator.sampleWorksheet') %></figcaption>
      </figure>
    </header>

    <div class="maze-layout">
      <section class="maze-builder" aria-label="Build your maze">
        <section class="maze-panel maze-intro">
          <div>
            <span class="maze-step">1</span>
            <p class="maze-kicker"><%= t('mazeGenerator.worksheetDetailsKicker') %></p>
            <h2><%= t('mazeGenerator.nameYourMaze') %></h2>
          </div>
          <label class="maze-title-field" for="mazeTitle"><%= t('mazeGenerator.worksheetTitleLabel') %>
            <input id="mazeTitle" type="text" maxlength="60" placeholder="e.g. Unit 3 Vocabulary Maze">
          </label>
          <p class="maze-help"><%= t('mazeGenerator.titleHelp') %></p>
        </section>

        <section class="maze-panel">
          <div class="maze-panel-heading">
            <div>
              <span class="maze-step">2</span>
              <p class="maze-kicker"><%= t('mazeGenerator.qaKicker') %></p>
              <h2><%= t('mazeGenerator.addEightQuestions') %></h2>
            </div>
            <button id="loadMazeSample" class="maze-secondary" type="button"><%= t('mazeGenerator.loadSample') %></button>
          </div>
          <p class="maze-help"><%= t('mazeGenerator.qaHelpPrefix') %><strong>|</strong><%= t('mazeGenerator.qaHelpSuffix') %></p>
          <div id="mazeBankPicker"></div>
          <section id="mazePersonalBankPicker" class="maze-personal-library" aria-labelledby="mazePersonalTitle">
            <h3 id="mazePersonalTitle">My question banks</h3>
            <p>Use a question bank saved in your <a href="/teaching-tools/question-bank-library/question-bank-library.html">unified My Library</a>. Preview first, then apply eight questions with distinct answers.</p>
            <label for="mazePersonalBank">Personal question bank</label>
            <select id="mazePersonalBank" disabled></select>
            <p id="mazePersonalStatus" role="status" aria-live="polite">Loading personal question banks…</p>
            <button id="mazePersonalPreview" class="maze-secondary" type="button" disabled>Preview 8 questions</button>
            <div id="mazePersonalResults"></div>
            <label id="mazePersonalReplaceLabel" hidden><input id="mazePersonalReplace" type="checkbox"> Replace my current maze questions with this preview.</label>
            <button id="mazePersonalApply" class="maze-secondary" type="button" hidden disabled>Use these 8 questions</button>
          </section>
          <div class="maze-pair-editor">
            <label class="maze-pair-label" for="mazePairInput">
              <span><%= t('mazeGenerator.eightPairsLabel') %></span>
              <span class="maze-pair-example"><%= t('mazeGenerator.formatExample') %></span>
            </label>
            <textarea id="mazePairInput" class="maze-pair-input" rows="12" maxlength="1500" spellcheck="true" aria-describedby="mazePairHelp" placeholder="1. The puppy is sitting ___ the table. | under"></textarea>
            <p id="mazePairHelp" class="maze-pair-help"><%= t('mazeGenerator.pairHelp') %></p>
          </div>
          <div class="maze-generate-row">
            <button id="generateMaze" class="maze-primary" type="button"><%= t('mazeGenerator.generateButton') %></button>
            <span><%= t('mazeGenerator.readyText') %></span>
          </div>
        </section>
        <section class="maze-panel maze-actions-panel">
          <div>
            <p class="maze-kicker"><%= t('mazeGenerator.startOverKicker') %></p>
            <h2><%= t('mazeGenerator.makeAnotherMaze') %></h2>
            <p class="maze-help"><%= t('mazeGenerator.clearHelp') %></p>
          </div>
          <div class="maze-actions">
            <button id="clearMaze" class="maze-secondary" type="button"><%= t('mazeGenerator.clearAllButton') %></button>
          </div>
        </section>
      </section>
    </div>
  </main>

  <%- include('../partials/tool-guide', { toolGuide: toolGuide }) %>

  <div id="mazeToast" class="maze-toast" role="status" aria-live="polite"></div>

  <script src="/vendor/jszip.min.js"></script>
  <script src="/shared/library-picker.js"></script>
  <script src="/shared/library-v2.js"></script>
  <script src="/shared/library-store.js"></script>
  <script src="/low-prep/maze-generator/maze-library.js"></script>
  <script src="/low-prep/maze-generator/maze-generator.js?v=personal-library-1"></script>
  <script src="/javascripts/account-coming-soon.js"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
