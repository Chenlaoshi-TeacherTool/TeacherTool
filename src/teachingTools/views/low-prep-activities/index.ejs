<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%- include('../partials/adsense') %>
    <title>Low-Prep Activities - Teacher Toolkit</title>
    <%- include('../partials/seo', { pageDescription: 'Explore quick, classroom-ready activities, printable games, and flexible teaching ideas for busy days.' }) %>
    <style>
        * {
            box-sizing: border-box;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            background-color: #f8f9fa;
            color: #333;
            line-height: 1.6;
        }
        .header {
            position: relative;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 64px 20px 54px;
            text-align: center;
        }
        .header h1 {
            margin: 0 0 10px;
            font-size: 2.4rem;
        }
        .header p {
            max-width: 650px;
            margin: 0 auto;
            font-size: 1.08rem;
            opacity: 0.94;
        }
        .back-btn {
            position: absolute;
            top: 20px;
            left: 20px;
            background-color: rgba(255, 255, 255, 0.18);
            border: 1px solid rgba(255, 255, 255, 0.8);
            color: white;
            padding: 9px 14px;
            text-decoration: none;
            border-radius: 7px;
            transition: background-color 0.2s;
        }
        .back-btn:hover {
            background-color: rgba(255, 255, 255, 0.3);
        }
        .activities-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 22px;
            max-width: 1200px;
            margin: 0 auto;
            padding: 24px 20px 56px;
        }
        .activity-search {
            max-width: 760px;
            margin: 0 auto;
            padding: 28px 20px 0;
        }
        .activity-search label {
            display: block;
            margin-bottom: 8px;
            color: #243553;
            font-weight: 700;
        }
        .activity-search-field {
            position: relative;
        }
        .activity-search-icon {
            position: absolute;
            top: 50%;
            left: 16px;
            color: #667eea;
            font-size: 1.25rem;
            line-height: 1;
            pointer-events: none;
            transform: translateY(-50%);
        }
        #activitySearch {
            width: 100%;
            min-height: 50px;
            padding: 12px 16px 12px 48px;
            border: 1px solid #d4d9eb;
            border-radius: 10px;
            font: inherit;
        }
        .activity-search-status {
            min-height: 1.5em;
            margin: 7px 0 0;
            color: #65718b;
            font-size: 0.9rem;
        }
        .no-activity-results {
            grid-column: 1 / -1;
            margin: 0;
            padding: 30px;
            border: 1px dashed #c7cde5;
            border-radius: 14px;
            color: #5261bd;
            text-align: center;
        }
        .activity-card {
            display: flex;
            flex-direction: column;
            min-height: 270px;
            padding: 28px;
            background: white;
            border: 1px solid #e6e8f0;
            border-radius: 14px;
            box-shadow: 0 4px 12px rgba(44, 51, 73, 0.08);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .activity-card[hidden] {
            display: none !important;
        }
        .activity-card:not(.coming-soon):hover {
            transform: translateY(-4px);
            box-shadow: 0 10px 24px rgba(44, 51, 73, 0.13);
        }
        .activity-card h2 {
            margin: 0 0 12px;
            color: #5d6fd3;
            font-size: 1.35rem;
        }
        .activity-card p {
            margin: 0 0 18px;
        }
        .tags {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 22px;
        }
        .tag {
            padding: 4px 10px;
            background-color: #eef0ff;
            color: #5261bd;
            border-radius: 999px;
            font-size: 0.82rem;
            font-weight: 600;
        }
        .card-action {
            margin-top: auto;
        }
        .open-btn {
            display: inline-block;
            padding: 10px 19px;
            background-color: #667eea;
            color: white;
            border: 0;
            border-radius: 6px;
            text-decoration: none;
            font: inherit;
            font-weight: 600;
        }
        .open-btn:hover {
            background-color: #5a67d8;
        }
        .coming-soon {
            opacity: 0.72;
        }
        .coming-soon .open-btn {
            background-color: #a8acb9;
            cursor: not-allowed;
        }
        @media (max-width: 640px) {
            .header {
                padding-top: 82px;
            }
            .header h1 {
                font-size: 2rem;
            }
            .back-btn {
                right: 20px;
                text-align: center;
            }
            .activities-grid {
                grid-template-columns: 1fr;
                padding-top: 28px;
            }
        }
    </style>
    <link rel="stylesheet" href="/stylesheets/site-theme.css">
</head>
<body>
    <header class="header">
        <a href="/" class="back-btn">← Back to Homepage</a>
        <h1>⚡ Low-Prep Activities</h1>
        <p>Quick, classroom-ready activities for busy teaching days. Add your own content for math, science, language arts, social studies, world languages, and more.</p>
    </header>

    <section class="activity-search" aria-label="Search activities">
        <label for="activitySearch">Find an activity</label>
        <div class="activity-search-field">
            <span class="activity-search-icon" aria-hidden="true">⌕</span>
            <input id="activitySearch" type="search" placeholder="Search by keyword, skill, or topic" autocomplete="off">
        </div>
        <p class="activity-search-status" id="activitySearchStatus" aria-live="polite">Search by title, skill, or topic.</p>
    </section>

    <main class="activities-grid">
        <article class="activity-card">
            <h2>🧩 Word Sudoku Generator</h2>
            <p>Enter nine subject terms, match each one with an icon, and generate a printable 9×9 vocabulary Sudoku.</p>
            <div class="tags">
                <span class="tag">5–10 min</span>
                <span class="tag">Printable</span>
                <span class="tag">Any Subject</span>
            </div>
            <div class="card-action">
                <a href="/low-prep-activities/word-sudoku" class="open-btn">Learn &amp; open</a>
            </div>
        </article>

        <article class="activity-card">
            <h2>☁️ Word Cloud Game Generator</h2>
            <p>Enter terms from any unit and generate a printable word cloud for finding, sorting, connecting, and explaining.</p>
            <div class="tags">
                <span class="tag">5 min</span>
                <span class="tag">Printable</span>
                <span class="tag">Any Subject</span>
            </div>
            <div class="card-action">
                <a href="/low-prep-activities/word-cloud" class="open-btn">Learn &amp; open</a>
            </div>
        </article>

        <article class="activity-card">
            <h2>📖 Vocabulary Mini Booklet</h2>
            <p>Turn a saved term list into a folded, self-paced student booklet for definitions, sketches, and retrieval practice.</p>
            <div class="tags">
                <span class="tag">10–15 min</span>
                <span class="tag">Printable</span>
                <span class="tag">Any Subject</span>
            </div>
            <div class="card-action">
                <a href="/teaching-tools/vocabulary-booklet" class="open-btn">Learn &amp; open</a>
            </div>
        </article>

        <article class="activity-card">
            <h2>📖 Independent Reading</h2>
            <p>Create a printable reading packet with your own text, comprehension questions, rewrite page, and storyboard.</p>
            <div class="tags">
                <span class="tag">10–20 min</span>
                <span class="tag">Reading</span>
            </div>
            <div class="card-action">
                <a href="/low-prep-activities/independent-reading" class="open-btn">Open Activity</a>
            </div>
        </article>

        <article class="activity-card">
            <h2>🟨 Tear-Paper Bingo</h2>
            <p>A listen-and-recognize game: students tear matching terms from either end as they hear a word, definition, example, or clue.</p>
            <div class="tags">
                <span class="tag">8–12 min</span>
                <span class="tag">Listening</span>
                <span class="tag">Printable</span>
            </div>
            <div class="card-action">
                <a href="/low-prep-activities/tear-paper-bingo" class="open-btn">Preview &amp; Download</a>
            </div>
        </article>

        <article class="activity-card">
            <h2>🤔 Would You Rather</h2>
            <p>Build either-or discussion slides that ask students to choose, justify, compare, and respond to a classmate.</p>
            <div class="tags">
                <span class="tag">5–10 min</span>
                <span class="tag">Discussion</span>
                <span class="tag">Any Subject</span>
            </div>
            <div class="card-action">
                <a href="/low-prep-activities/would-you-rather" class="open-btn">Open Generator</a>
            </div>
        </article>

        <article class="activity-card">
            <h2>🏆 Jeopardy</h2>
            <p>Create a timed team review game with your own categories, questions, answers, and scoring for any course.</p>
            <div class="tags">
                <span class="tag">15–25 min</span>
                <span class="tag">Review Game</span>
                <span class="tag">Any Subject</span>
            </div>
            <div class="card-action">
                <a href="/low-prep-activities/jeopardy" class="open-btn">Open Activity</a>
            </div>
        </article>

        <article class="activity-card">
            <h2>🌻 Term Race</h2>
            <p>Arrange terms in a sunflower wheel and grid for a fast partner clue-and-find game.</p>
            <div class="tags">
                <span class="tag">5–10 min</span>
                <span class="tag">Game</span>
                <span class="tag">Any Subject</span>
            </div>
            <div class="card-action">
                <a href="/low-prep-activities/character-race" class="open-btn">Open Activity</a>
            </div>
        </article>

        <article class="activity-card">
            <h2>🧭 Maze Generator</h2>
            <p>Turn eight questions and answers into an editable PowerPoint maze for practice in any subject.</p>
            <div class="tags">
                <span class="tag">10–15 min</span>
                <span class="tag">Printable</span>
                <span class="tag">Review</span>
            </div>
            <div class="card-action">
                <a href="/low-prep-activities/maze-generator" class="open-btn">Open Activity</a>
            </div>
        </article>

        <article class="activity-card coming-soon">
            <h2>🧩 Tarsia Puzzle</h2>
            <p>Turn matching pairs into a printable triangle puzzle—cut it apart, shuffle the pieces, and rebuild it by matching edges.</p>
            <div class="tags">
                <span class="tag">10–15 min</span>
                <span class="tag">Printable</span>
                <span class="tag">Any Subject</span>
            </div>
            <div class="card-action">
                <button class="open-btn" type="button" disabled>Coming Soon</button>
            </div>
        </article>

        <article class="activity-card coming-soon">
            <h2>💬 5-Minute Speaking Prompts</h2>
            <p>Ready-to-use questions for partners, small groups, or a quick whole-class warm-up.</p>
            <div class="tags">
                <span class="tag">5 min</span>
                <span class="tag">Speaking</span>
            </div>
            <div class="card-action">
                <button class="open-btn" type="button" disabled>Coming Soon</button>
            </div>
        </article>

        <article class="activity-card coming-soon">
            <h2>✍️ Quick Write</h2>
            <p>Short writing prompts that help students review key terms, concepts, or lesson themes.</p>
            <div class="tags">
                <span class="tag">5–10 min</span>
                <span class="tag">Writing</span>
            </div>
            <div class="card-action">
                <button class="open-btn" type="button" disabled>Coming Soon</button>
            </div>
        </article>

        <article class="activity-card coming-soon">
            <h2>🎟️ Exit Ticket</h2>
            <p>A fast end-of-class check for understanding, reflection, or one final learning challenge.</p>
            <div class="tags">
                <span class="tag">3–5 min</span>
                <span class="tag">Assessment</span>
            </div>
            <div class="card-action">
                <button class="open-btn" type="button" disabled>Coming Soon</button>
            </div>
        </article>

        <article class="activity-card coming-soon">
            <h2>🔄 Think–Pair–Share</h2>
            <p>A simple discussion routine with prompts that move students from independent thinking to partner talk and class sharing.</p>
            <div class="tags">
                <span class="tag">5–8 min</span>
                <span class="tag">Discussion</span>
            </div>
            <div class="card-action">
                <button class="open-btn" type="button" disabled>Coming Soon</button>
            </div>
        </article>

        <p class="no-activity-results" id="noActivityResults" hidden>No activities match that search yet. Try another keyword.</p>
    </main>
    <script>
        (function () {
            var search = document.getElementById('activitySearch');
            var status = document.getElementById('activitySearchStatus');
            var empty = document.getElementById('noActivityResults');
            var cards = Array.prototype.slice.call(document.querySelectorAll('.activity-card'));

            function filterActivities() {
                var query = search.value.trim().toLocaleLowerCase();
                var visible = 0;

                cards.forEach(function (card) {
                    var matches = !query || card.textContent.toLocaleLowerCase().indexOf(query) !== -1;
                    card.hidden = !matches;
                    if (matches) visible += 1;
                });

                empty.hidden = visible !== 0;
                status.textContent = query
                    ? 'Showing ' + visible + ' ' + (visible === 1 ? 'activity' : 'activities') + ' for “' + search.value.trim() + '”.'
                    : 'Search by title, skill, or topic.';
            }

            search.addEventListener('input', filterActivities);
        }());
    </script>
    <script src="/javascripts/account-coming-soon.js"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
