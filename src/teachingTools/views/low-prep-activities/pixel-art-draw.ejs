<!DOCTYPE html>
<html lang="zh">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#356e57">
  <title>像素画 · Pixel Art - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'Draw a Chinese vocabulary word as pixel art and write about it.', noindex: true }) %>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Andika:wght@400;700&display=swap">
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/low-prep/pixel-art/pixel-art.css?v=3">
</head>
<body class="px-page px-student-page">
  <main class="px-wrap">
    <div id="pxDraw"></div>
    <noscript><p>请打开 JavaScript。 Please turn on JavaScript to draw.</p></noscript>
  </main>

  <script src="/shared/wordlist-core.js?v=cedict-1"></script>
  <script src="/low-prep/pixel-art/pixel-core.js?v=3"></script>
  <script src="/low-prep/pixel-art/pixel-draw.js?v=3"></script>
  <script>
    (function () {
      var match = /[#&]c=([^&]+)/.exec(location.hash);
      var config = match ? PixelArtCore.decodeConfig(match[1]) : null;
      if (!config || !config.words.length) {
        config = { title: PixelArtCore.DEFAULT_TITLE, grid: 16, words: PixelArtCore.parseWords(PixelArtCore.DEFAULT_WORDS), prompts: PixelArtCore.parsePrompts(PixelArtCore.DEFAULT_PROMPTS) };
      }
      document.title = config.title + ' · 像素画';
      PixelArtDraw.mount(document.getElementById('pxDraw'), config);
    })();
  </script>
</body>
</html>
