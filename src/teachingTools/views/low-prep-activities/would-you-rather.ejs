<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#194f45">
  <title>Would You Rather Generator - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'Build lively Would You Rather speaking cards from your own prompts, vocabulary, or saved word lists.' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/shared/library-picker.css">
  <link rel="stylesheet" href="/low-prep/would-you-rather/would-you-rather.css?v=vocabulary-library-3">
</head>
<body class="wyr-page">
  <header class="header wyr-header">
    <a href="/teaching-tools#low-prep-activities" class="back-btn"><%= t('wouldYouRather.backBtn') %></a>
    <div class="wyr-header-inner">
      <div class="wyr-header-icon" aria-hidden="true">🤔</div>
      <div>
        <p class="wyr-kicker"><%= t('wouldYouRather.kicker') %></p>
        <h1><%= t('wouldYouRather.title') %></h1>
        <p><%= t('wouldYouRather.subtitle') %></p>
      </div>
      <div class="wyr-header-badge"><%= t('wouldYouRather.headerBadge') %></div>
    </div>
  </header>

  <main class="wyr-main">
    <section class="wyr-intro" aria-labelledby="wyr-intro-title">
      <div>
        <p class="wyr-kicker"><%= t('wouldYouRather.introKicker') %></p>
        <h2 id="wyr-intro-title"><%= t('wouldYouRather.introTitle') %></h2>
        <p><%= t('wouldYouRather.introText') %></p>
      </div>
      <div class="wyr-intro-tags" aria-label="Activity features">
        <span><%= t('wouldYouRather.tag1') %></span><span><%= t('wouldYouRather.tag2') %></span><span><%= t('wouldYouRather.tag3') %></span>
      </div>
    </section>

    <section class="wyr-workspace" aria-label="Would You Rather deck builder">
      <article class="wyr-panel wyr-template-panel">
        <div class="wyr-step"><span>1</span><p><%= t('wouldYouRather.step1Label') %></p></div>
        <div class="wyr-template-layout">
          <div>
            <h2><%= t('wouldYouRather.templateHeading') %></h2>
            <p class="wyr-help"><%= t('wouldYouRather.templateHelpPrefix') %><strong>{A}</strong><%= t('wouldYouRather.templateHelpMid') %><strong>{B}</strong><%= t('wouldYouRather.templateHelpSuffix') %></p>
            <label for="questionTemplate"><%= t('wouldYouRather.questionTemplateLabel') %></label>
            <input id="questionTemplate" value="Would you rather {A} or {B}?" maxlength="90">
            <p class="wyr-sample" id="templateSample"><%= t('wouldYouRather.templateSampleInitial') %></p>
          </div>
          <div>
            <p class="wyr-label"><%= t('wouldYouRather.commonTemplatesLabel') %></p>
            <div class="wyr-template-grid">
              <button class="wyr-template active" type="button" data-template="Would you rather {A} or {B}?"><%= t('wouldYouRather.templateButton1') %></button>
              <button class="wyr-template" type="button" data-template="Which would you choose: {A} or {B}?"><%= t('wouldYouRather.templateButton2') %></button>
              <button class="wyr-template" type="button" data-template="Which is more useful: {A} or {B}?"><%= t('wouldYouRather.templateButton3') %></button>
              <button class="wyr-template" type="button" data-template="Which is a better strategy: {A} or {B}?"><%= t('wouldYouRather.templateButton4') %></button>
              <button class="wyr-template" type="button" data-template="If you could choose only one, would you pick {A} or {B}?"><%= t('wouldYouRather.templateButton5') %></button>
              <button class="wyr-template" type="button" data-template="Which is more interesting: {A} or {B}?"><%= t('wouldYouRather.templateButton6') %></button>
              <button class="wyr-template" type="button" data-template="For this task, would you prefer {A} or {B}?"><%= t('wouldYouRather.templateButton7') %></button>
            </div>
            <button class="wyr-secondary-btn wyr-apply-all" id="applyTemplate" type="button"><%= t('wouldYouRather.applyToAll') %></button>
          </div>
        </div>
      </article>

      <article class="wyr-panel wyr-vocabulary-panel">
        <div class="wyr-step"><span>2</span><p><%= t('wouldYouRather.step2Label') %></p></div>
        <div class="wyr-vocabulary-layout">
          <div>
            <h2><%= t('wouldYouRather.buildChoicesHeading') %></h2>
            <p class="wyr-help"><%= t('wouldYouRather.buildChoicesHelp') %></p>
            <label for="pairInput"><%= t('wouldYouRather.pairsLabel') %></label>
            <textarea id="pairInput" rows="7" spellcheck="false" aria-describedby="pairInputHelp">explain with a diagram / explain with a table
read a biography / read historical fiction
work alone / work with a partner
show your answer in writing / explain it aloud
start with an example / start with a rule</textarea>
            <p id="pairInputHelp" class="wyr-small"><%= t('wouldYouRather.pairInputHelp') %></p>
          </div>
          <div class="wyr-vocabulary-actions">
            <button class="btn wyr-generate" id="generateDeck" type="button">✨ <%= t('wouldYouRather.generateCards') %></button>
            <button class="wyr-secondary-btn" id="appendDeck" type="button">＋ <%= t('wouldYouRather.addToDeck') %></button>
            <button class="wyr-secondary-btn" id="shuffleDeck" type="button">↻ <%= t('wouldYouRather.shuffleOrder') %></button>
            <button class="wyr-secondary-btn wyr-danger-button" id="clearDeck" type="button"><%= t('wouldYouRather.clearDeck') %></button>
            <button class="wyr-secondary-btn" id="addBlankCard" type="button">＋ <%= t('wouldYouRather.addOneCard') %></button>
            <button class="wyr-secondary-btn" id="loadExample" type="button"><%= t('wouldYouRather.loadExample') %></button>
            <div id="wyrLibraryPicker"></div>
          </div>
        </div>
        <p class="wyr-status" id="statusMessage" role="status"><%= t('wouldYouRather.statusMessageInitial') %></p>
        <p class="wyr-editing-help"><%= t('wouldYouRather.editingHelp') %></p>
        <div class="wyr-card-editor-heading"><strong id="cardCount"><%= t('wouldYouRather.cardCountInitial') %></strong><span><%= t('wouldYouRather.editingEachCard') %></span></div>
        <div id="cardList" class="wyr-card-list wyr-card-editor" aria-label="Generated prompt list"></div>
      </article>

      <section class="wyr-deck-panel" aria-labelledby="preview-title">
        <div class="wyr-deck-toolbar">
          <div>
            <p class="wyr-kicker"><%= t('wouldYouRather.step3Kicker') %></p>
            <h2 id="preview-title"><%= t('wouldYouRather.previewTitle') %></h2>
            <p><%= t('wouldYouRather.previewSubtitle') %></p>
          </div>
          <div class="wyr-deck-actions">
            <button class="wyr-secondary-btn" id="printDeck" type="button">🖨 <%= t('wouldYouRather.printButton') %></button>
            <button class="wyr-secondary-btn" id="exportPdf" type="button">↓ <%= t('wouldYouRather.exportPdf') %></button>
            <button class="wyr-secondary-btn" id="exportPptx" type="button">↓ <%= t('wouldYouRather.exportPptx') %></button>
            <button class="btn" id="presentDeck" type="button">▶ <%= t('wouldYouRather.presentDeck') %></button>
          </div>
        </div>
        <div class="wyr-preview-area"><div id="slidePreview" class="wyr-slide-preview" aria-label="Selected generated slide"></div></div>
      </section>
    </section>
  </main>

  <%- include('../partials/tool-guide', { toolGuide: toolGuide }) %>

  <div id="presentation" class="wyr-presentation" hidden aria-modal="true" role="dialog" aria-label="Would You Rather presentation">
    <div class="wyr-presentation-bar">
      <span id="presentationCount">1 / 5</span>
      <button id="closePresentation" type="button">× <%= t('wouldYouRather.close') %></button>
    </div>
    <div id="presentationSlide" class="wyr-presentation-slide"></div>
    <div class="wyr-presentation-controls">
      <button id="previousSlide" type="button">← <%= t('wouldYouRather.previous') %></button>
      <span><%= t('wouldYouRather.votingHint') %></span>
      <button id="nextSlide" type="button"><%= t('wouldYouRather.next') %> →</button>
    </div>
  </div>
  <div id="printArea" aria-hidden="true"></div>
  <div id="artPicker" class="wyr-art-picker" hidden role="dialog" aria-modal="true" aria-labelledby="artPickerTitle">
    <div class="wyr-picker-card">
      <div class="wyr-picker-heading"><div><p class="wyr-kicker"><%= t('wouldYouRather.artPickerKicker') %></p><h2 id="artPickerTitle"><%= t('wouldYouRather.chooseImage') %></h2></div><button id="closePicker" type="button" aria-label="Close image picker">×</button></div>
      <div class="wyr-picker-actions"><input id="iconSearch" type="search" placeholder="<%= t('wouldYouRather.iconSearchPlaceholder') %>"><label class="wyr-upload-label" for="imageUpload"><%= t('wouldYouRather.uploadPhotoLabel') %><input id="imageUpload" type="file" accept="image/*"></label></div>
      <p class="wyr-small"><%= t('wouldYouRather.pickerHelp') %></p>
      <div id="iconGrid" class="wyr-icon-grid" aria-label="Searchable icon choices"></div>
    </div>
  </div>

  <footer><p><%= t('wouldYouRather.footer') %></p></footer>
  <script src="/shared/wordlist-core.js"></script>
  <script src="/shared/deck-export.js"></script>
  <script src="/shared/library-picker.js"></script>
  <script src="/low-prep/would-you-rather/material-symbols-catalog.js"></script>
  <script src="/low-prep/would-you-rather/would-you-rather.js?v=vocabulary-library-3"></script>
  <script src="/javascripts/account-coming-soon.js"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
