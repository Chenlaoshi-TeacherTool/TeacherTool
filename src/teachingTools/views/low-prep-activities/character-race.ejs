<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#35604C">
<title>Term Race - Chen Laoshi's Teaching Toolkit</title>
<%- include('../partials/seo', { pageDescription: 'Arrange subject terms on a word track and grid for a fast partner clue-and-find game.' }) %>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Andika:wght@400;700&display=swap">
<link rel="stylesheet" href="/stylesheets/site-theme.css">
<link rel="stylesheet" href="/shared/library-picker.css">
<link rel="stylesheet" href="/low-prep/character-race/character-race.css">
</head>
<body class="cr-page">
<div class="cr-wrap">
  <header class="cr-header">
    <a href="/teaching-tools#low-prep-activities" class="back-btn"><%= t('characterRace.backBtn') %></a>
    <div class="fl"><svg viewBox="0 0 100 100"><g fill="#F6C43C" stroke="#1B2A47" stroke-width="3"><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(0 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(30 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(60 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(90 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(120 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(150 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(180 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(210 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(240 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(270 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(300 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(330 50 50)"/></g><circle cx="50" cy="50" r="15" fill="#4A3520" stroke="#1B2A47" stroke-width="3"/></svg><svg viewBox="0 0 100 100"><g fill="#F6C43C" stroke="#1B2A47" stroke-width="3"><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(0 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(30 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(60 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(90 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(120 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(150 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(180 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(210 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(240 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(270 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(300 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(330 50 50)"/></g><circle cx="50" cy="50" r="15" fill="#4A3520" stroke="#1B2A47" stroke-width="3"/></svg></div>
    <h1><%= t('characterRace.title') %></h1>
    <p><%= t('characterRace.subtitle') %></p>
  </header>

  <div id="coreWarn" class="warn" style="display:none">
    <%= t('characterRace.coreWarn') %>
  </div>

  <section>
    <h2><span class="num">1</span><%= t('characterRace.addTermsHeading') %> <span style="font-size:14px;font-weight:400;color:#5A6B57"><%= t('characterRace.totalLabel') %> <b id="count">0</b></span></h2>
    <p class="hint"><%= t('characterRace.termsHint') %></p>
    <textarea id="src" placeholder="hypothesis&#10;evidence&#10;variable&#10;observe&#10;measure"></textarea>
    <p class="hint"><%= t('characterRace.pronunciationHintPrefix') %><code>term | pronunciation | definition</code><%= t('characterRace.pronunciationHintSuffix') %></p>
    <div id="raceLibraryPicker"></div>
    <div class="row" style="margin-top:10px">
      <button id="btnMake" class="primary"><%= t('characterRace.btnMake') %></button>
      <button id="btnFromList"><%= t('characterRace.btnFromList') %></button>
      <button id="btnDemo" class="ghost"><%= t('characterRace.btnDemo') %></button>
      <button id="btnShuffle"><%= t('characterRace.btnShuffle') %></button>
      <button id="btnClear" class="mini"><%= t('characterRace.btnClear') %></button>
    </div>
    <div class="row" style="margin-top:12px">
      <input type="text" id="title" placeholder="Title, e.g. Lesson 3 · New Words" style="flex:1 1 240px">
    </div>
    <div id="chips" class="chips" style="margin-top:12px"></div>
    <p class="hint" id="empty" style="margin:8px 0 0"><%= t('characterRace.emptyHintPrefix') %>“<%= t('characterRace.loadSampleLinkText') %>”<%= t('characterRace.emptyHintSuffix') %></p>
  </section>

  <section>
    <h2><span class="num">2</span><%= t('characterRace.layoutHeading') %></h2>
    <p class="hint"><%= t('characterRace.layoutHint') %></p>
    <div class="row">
      <span class="field"><%= t('characterRace.supportLineLabel') %>
        <select id="optTargetLanguage" aria-label="Support line">
          <option value="english" selected><%= t('characterRace.definitionOption') %></option>
          <option value="pinyin"><%= t('characterRace.pinyinOption') %></option>
          <option value="none"><%= t('characterRace.noneOption') %></option>
        </select>
      </span>
      <span class="field"><%= t('characterRace.trackShapeLabel') %>
        <select id="optShape">
          <option value="circle" selected><%= t('characterRace.shapeCircle') %></option>
          <option value="oval"><%= t('characterRace.shapeOval') %></option>
          <option value="square"><%= t('characterRace.shapeSquare') %></option>
          <option value="heart"><%= t('characterRace.shapeHeart') %></option>
          <option value="cloud"><%= t('characterRace.shapeCloud') %></option>
          <option value="butterfly"><%= t('characterRace.shapeButterfly') %></option>
        </select>
      </span>
      <span class="field"><%= t('characterRace.ringsLabel') %>
        <select id="optRings"><option value="auto"><%= t('characterRace.autoOption') %></option><option value="1"><%= t('characterRace.oneOption') %></option><option value="2"><%= t('characterRace.twoOption') %></option><option value="3"><%= t('characterRace.threeOption') %></option></select>
      </span>
      <span class="field"><%= t('characterRace.textSizeLabel') %>
        <select id="optSize"><option value="auto"><%= t('characterRace.autoOption') %></option><option value="34"><%= t('characterRace.smallOption') %></option><option value="46"><%= t('characterRace.mediumOption') %></option><option value="60"><%= t('characterRace.largeOption') %></option></select>
      </span>
      <span class="field"><%= t('characterRace.gridSquaresLabel') %>
        <select id="optGrid"><option value="16">16</option><option value="20" selected>20</option><option value="25">25</option></select>
      </span>
    </div>
    <div class="cr-theme-block">
      <span class="field"><%= t('characterRace.themeLabel') %></span>
      <div id="themePicker" class="cr-theme-picker" role="radiogroup" aria-label="<%= t('characterRace.themeLabel') %>"></div>
      <p class="hint" style="margin:6px 0 0"><%= t('characterRace.themeHint') %></p>
    </div>
    <p class="hint" id="targetLanguageHint" aria-live="polite" style="margin:8px 0 0"><%= t('characterRace.targetLanguageHint') %></p>
  </section>

  <section>
    <h2><span class="num">3</span><%= t('characterRace.previewHeading') %></h2>
    <div id="preview"></div>
    <p class="hint" id="printSizeHint" aria-live="polite" style="margin:8px 0 0" data-ok="<%= t('characterRace.printSizeOk') %>" data-warn="<%= t('characterRace.printSizeWarn') %>"></p>
  </section>

  <section>
    <h2><span class="num">4</span><%= t('characterRace.playExportHeading') %></h2>
    <div class="row">
      <button id="btnGame" class="dark">▶ <%= t('characterRace.btnGame') %></button>
      <button id="btnBattle" class="dark">⚔ <%= t('characterRace.btnBattle') %></button>
      <button id="btnPrint1" class="primary"><%= t('characterRace.btnPrint1') %></button>
      <button id="btnPrint4"><%= t('characterRace.btnPrint4') %></button>
      <button id="btnPPTX"><%= t('characterRace.btnPPTX') %></button>
      <button id="btnPDF"><%= t('characterRace.btnPDF') %></button>
      <button id="btnPNG"><%= t('characterRace.btnPNG') %></button>
    </div>
    <p class="hint" style="margin-top:10px">
      <%= t('characterRace.printHint') %>
    </p>
  </section>

  <footer><%= t('characterRace.footer') %></footer>
  <div id="printArea"></div>
</div>

<%- include('../partials/tool-guide', { toolGuide: toolGuide }) %>

<div id="game">
  <div id="gstage"></div>
  <div id="gbar">
    <button id="gNext" class="primary"><%= t('characterRace.gDrawTerm') %></button>
    <button id="gSay" class="mini"><%= t('characterRace.gSayAgain') %></button>
    <label class="check" style="color:#F2F6EF"><input type="checkbox" id="optSpeak" checked> <%= t('characterRace.gReadAloud') %></label>
    <span style="width:16px"></span>
    <span class="big"><%= t('characterRace.gCorrect') %> <span id="gscore">0</span></span>
    <span class="big"><%= t('characterRace.gMissed') %> <span id="gmiss">0</span></span>
    <span class="big"><%= t('characterRace.gTimeLeft') %> <span id="gleft">60</span>s</span>
    <span class="field" style="color:#F2F6EF"><%= t('characterRace.gDuration') %>
      <select id="gtime"><option value="30">30</option><option value="60" selected>60</option><option value="120">120</option></select>
    </span>
    <button id="gStart"><%= t('characterRace.gStartTimer') %></button>
    <button id="gStop" class="mini"><%= t('characterRace.gPause') %></button>
    <button id="gAgain" class="mini"><%= t('characterRace.gReset') %></button>
    <button id="gExit"><%= t('characterRace.gExit') %></button>
  </div>
</div>

<div id="battle" data-text="<%= JSON.stringify({ listen: t('characterRace.bListen'), pressNext: t('characterRace.bPressNext'), scored: t('characterRace.bScored'), winner: t('characterRace.bWinner'), judgeTip: t('characterRace.bJudgeTip'), tooMany: t('characterRace.bTooMany'), allUsed: t('characterRace.bAllUsed') }) %>">
  <div id="bbar">
    <button id="bNext" class="primary"><%= t('characterRace.bNext') %></button>
    <button id="bSay" class="mini"><%= t('characterRace.bSay') %></button>
    <button id="bPeek" class="mini"><%= t('characterRace.bPeek') %></button>
    <button id="bShuffle" class="mini"><%= t('characterRace.bShuffle') %></button>
    <label class="check"><input type="checkbox" id="bSpeak" checked> <%= t('characterRace.bSpeak') %></label>
    <label class="check"><input type="checkbox" id="bHint"> <%= t('characterRace.bHint') %></label>
    <label class="check"><input type="checkbox" id="bSame"> <%= t('characterRace.bSame') %></label>
    <label class="check"><input type="checkbox" id="bReshuffle"> <%= t('characterRace.bReshuffle') %></label>
    <label class="check"><input type="checkbox" id="bJudge"> <%= t('characterRace.bJudge') %></label>
    <span class="field"><%= t('characterRace.bGoal') %>
      <select id="bGoal"><option value="0"><%= t('characterRace.bGoalNone') %></option><option value="5">5</option><option value="10" selected>10</option><option value="15">15</option></select>
    </span>
    <button id="bSwap" class="mini"><%= t('characterRace.bSwap') %></button>
    <button id="bReset" class="mini"><%= t('characterRace.bReset') %></button>
    <button id="bExit"><%= t('characterRace.bExit') %></button>
  </div>
  <div id="bstatus" role="status" aria-live="polite"></div>
  <div class="bteams">
    <section class="bteam" data-side="0" style="--team:#127c83" data-wait="<%= t('characterRace.bWait') %>">
      <div class="bteam-head">
        <input type="text" class="bname" aria-label="Team name" value="<%= t('characterRace.teamA') %>">
        <input type="color" class="bcolor" aria-label="Team color" value="#127c83">
        <button type="button" class="bminus" aria-label="-1">−1</button>
        <output class="bscore" aria-live="polite">0</output>
        <button type="button" class="bplus" aria-label="+1">+1</button>
      </div>
      <div class="bstage"></div>
    </section>
    <section class="bteam" data-side="1" style="--team:#b25435" data-wait="<%= t('characterRace.bWait') %>">
      <div class="bteam-head">
        <input type="text" class="bname" aria-label="Team name" value="<%= t('characterRace.teamB') %>">
        <input type="color" class="bcolor" aria-label="Team color" value="#b25435">
        <button type="button" class="bminus" aria-label="-1">−1</button>
        <output class="bscore" aria-live="polite">0</output>
        <button type="button" class="bplus" aria-label="+1">+1</button>
      </div>
      <div class="bstage"></div>
    </section>
  </div>
</div>

<div id="toast" class="toast"></div>

<script src="/shared/wordlist-core.js"></script>
<script src="/shared/deck-export.js"></script>
<script src="/shared/wordlist-handoff.js?v=1"></script>
<script src="/shared/library-picker.js?v=2"></script>
<script src="/low-prep/character-race/character-race.js"></script>
<script src="/javascripts/account-coming-soon.js"></script>
<script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
