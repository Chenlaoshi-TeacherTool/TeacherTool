<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#356e57">
  <title>Zoom Reveal - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'Upload a photo, pick a spot, and zoom in super close. Zoom out slowly while students guess what the picture is. Images stay in your browser and never touch a server.' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/low-prep/zoom-reveal/zoom-reveal.css?v=1">
</head>
<body class="reveal-page">
  <main class="reveal-wrap">
    <header class="reveal-header">
      <div class="reveal-header-content">
        <a href="/teaching-tools#low-prep-activities" class="back-btn"><%= t('zoomReveal.backBtn') %></a>
        <p class="reveal-eyebrow"><%= t('zoomReveal.eyebrow') %></p>
        <h1>🔍 <%= t('zoomReveal.title') %></h1>
        <p><%= t('zoomReveal.subtitle') %></p>
        <div class="reveal-hero-points" aria-label="Tool highlights">
          <span><%= t('zoomReveal.heroPoint1') %></span>
          <span><%= t('zoomReveal.heroPoint2') %></span>
          <span><%= t('zoomReveal.heroPoint3') %></span>
        </div>
      </div>
    </header>

    <div class="reveal-layout">
      <section class="reveal-builder" aria-label="Set up the game">
        <section class="reveal-panel">
          <div class="reveal-panel-heading">
            <div>
              <span class="reveal-step">1</span>
              <p class="reveal-kicker"><%= t('zoomReveal.imagesKicker') %></p>
              <h2><%= t('zoomReveal.uploadHeading') %></h2>
            </div>
          </div>
          <label class="reveal-upload-drop" for="image-input">
            <input id="image-input" type="file" accept="image/*" multiple hidden>
            <span class="reveal-upload-icon" aria-hidden="true">＋</span>
            <span class="reveal-upload-text"><%= t('zoomReveal.uploadText') %></span>
          </label>
          <p class="reveal-help"><%= t('zoomReveal.uploadHelp') %></p>
          <ul id="image-list" class="reveal-image-list" aria-label="Uploaded images"></ul>
        </section>

        <section class="reveal-panel">
          <div class="reveal-panel-heading">
            <div>
              <span class="reveal-step">2</span>
              <p class="reveal-kicker"><%= t('zoomReveal.zoomKicker') %></p>
              <h2><%= t('zoomReveal.zoomHeading') %></h2>
            </div>
          </div>
          <label for="max-zoom"><%= t('zoomReveal.maxZoomLabel') %> <output id="max-zoom-value">8</output>×
            <input id="max-zoom" type="range" min="2" max="20" step="0.5" value="8">
          </label>
          <p class="reveal-help"><%= t('zoomReveal.maxZoomHelp') %></p>
        </section>

        <section class="reveal-panel">
          <div class="reveal-panel-heading">
            <div>
              <span class="reveal-step">3</span>
              <p class="reveal-kicker"><%= t('zoomReveal.autoplayKicker') %></p>
              <h2><%= t('zoomReveal.autoplayHeading') %></h2>
            </div>
          </div>
          <label for="zoom-duration"><%= t('zoomReveal.durationLabel') %> <output id="duration-value">20</output>s
            <input id="zoom-duration" type="range" min="4" max="60" step="1" value="20">
          </label>
        </section>

        <p id="setup-status" class="reveal-setup-status" aria-live="polite"><%= t('zoomReveal.setupStatus') %></p>
      </section>

      <section class="reveal-preview-panel" aria-label="Reveal stage">
        <div class="reveal-preview-heading">
          <h2><%= t('zoomReveal.stageHeading') %></h2>
          <p id="progress-text" class="reveal-progress-text"><%= t('zoomReveal.progressEmpty') %></p>
        </div>

        <div id="reveal-stage" class="reveal-stage">
          <p class="reveal-stage-empty"><%= t('zoomReveal.stageEmpty') %></p>
        </div>

        <label for="zoom-slider" class="reveal-zoom-slider-label"><%= t('zoomReveal.zoomLevelLabel') %>
          <input id="zoom-slider" type="range" min="1" max="8" step="0.05" value="8" disabled>
        </label>

        <div class="reveal-stage-controls">
          <button id="start-button" class="reveal-primary" type="button" disabled>🔍 <%= t('zoomReveal.zoomInButton') %></button>
          <button id="play-button" class="reveal-secondary" type="button" disabled>▶ <%= t('zoomReveal.autoZoomOutButton') %></button>
          <button id="reveal-all-button" class="reveal-secondary" type="button" disabled>⏭ <%= t('zoomReveal.revealFullButton') %></button>
          <button id="restart-button" class="reveal-secondary" type="button" disabled>↺ <%= t('zoomReveal.restartButton') %></button>
          <button id="fullscreen-button" class="reveal-secondary" type="button" disabled>⛶ <%= t('zoomReveal.fullscreenButton') %></button>
        </div>
        <div class="reveal-nav-controls">
          <button id="prev-button" class="reveal-secondary" type="button" disabled>← <%= t('zoomReveal.previousButton') %></button>
          <button id="next-button" class="reveal-primary" type="button" disabled><%= t('zoomReveal.nextImageButton') %> →</button>
        </div>
      </section>
    </div>
  </main>

  <%- include('../partials/tool-guide', { toolGuide: toolGuide }) %>

  <script src="/low-prep/zoom-reveal/zoom-reveal.js?v=1" defer></script>
  <script src="/javascripts/account-coming-soon.js"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
