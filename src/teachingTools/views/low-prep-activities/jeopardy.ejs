<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#35604C">
<title>Jeopardy - Chen Laoshi's Teaching Toolkit</title>
<%- include('../partials/seo', { pageDescription: 'Create an energetic classroom Jeopardy review game with timed questions, Daily Doubles, and automatic scoring.' }) %>
<link rel="stylesheet" href="/stylesheets/site-theme.css">
<link rel="stylesheet" href="/shared/library-picker.css">
<link rel="stylesheet" href="/low-prep/jeopardy/jeopardy.css">
</head>
<body class="jp-page">
<div class="jp-wrap">
  <header class="jp-header">
    <a href="/teaching-tools#low-prep-activities" class="back-btn"><%= t('jeopardy.backBtn') %></a>
    <div class="fl"><svg viewBox="0 0 100 100"><g fill="#F6C43C" stroke="#1B2A47" stroke-width="3"><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(0 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(30 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(60 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(90 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(120 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(150 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(180 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(210 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(240 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(270 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(300 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(330 50 50)"/></g><circle cx="50" cy="50" r="15" fill="#4A3520" stroke="#1B2A47" stroke-width="3"/></svg><svg viewBox="0 0 100 100"><g fill="#F6C43C" stroke="#1B2A47" stroke-width="3"><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(0 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(30 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(60 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(90 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(120 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(150 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(180 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(210 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(240 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(270 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(300 50 50)"/><ellipse cx="50" cy="20" rx="9" ry="17" transform="rotate(330 50 50)"/></g><circle cx="50" cy="50" r="15" fill="#4A3520" stroke="#1B2A47" stroke-width="3"/></svg></div>
    <h1><%= t('jeopardy.title') %></h1>
    <p><%= t('jeopardy.subtitle') %></p>
  </header>

  <div id="coreWarn" class="warn" style="display:none">
    <%= t('jeopardy.coreWarn') %>
  </div>

  <section>
    <h2><span class="num">1</span><%= t('jeopardy.step1Heading') %></h2>
    <div class="row">
      <input type="text" id="gname" class="grow" placeholder="<%= t('jeopardy.boardNamePlaceholder') %>">
    </div>
    <div class="row" style="margin-top:10px">
      <button id="btnSave" class="primary"><%= t('jeopardy.saveBoard') %></button>
      <button id="btnNew"><%= t('jeopardy.newBoard') %></button>
    </div>
    <p class="hint" style="margin:12px 0 6px"><%= t('jeopardy.savedBoards') %></p>
    <div id="saved" class="saved"></div>
  </section>

  <section>
    <h2><span class="num">2</span><%= t('jeopardy.step2Heading') %> <span style="font-size:14px;font-weight:400;color:#5A6B57"><%= t('jeopardy.filled') %> <b id="fillinfo">0 / 0</b></span></h2>
    <p class="hint"><%= t('jeopardy.step2Hint') %></p>
    <div class="row" style="margin-bottom:10px">
      <span class="field"><%= t('jeopardy.categoriesLabel') %> <select id="optCats"><option>2</option><option>3</option><option>4</option><option selected>5</option><option>6</option></select></span>
      <span class="field"><%= t('jeopardy.questionsPerCategoryLabel') %> <select id="optRows"><option>3</option><option>4</option><option selected>5</option><option>6</option></select></span>
      <span class="field"><%= t('jeopardy.startingPointsLabel') %> <input type="number" id="optBase" value="100" step="50" style="width:88px"></span>
      <span class="field"><%= t('jeopardy.pointStepLabel') %> <input type="number" id="optStep" value="100" step="50" style="width:88px"></span>
      <span class="field"><%= t('jeopardy.answerTimeLabel') %> <input type="number" id="optSec" value="20" min="5" style="width:74px"></span>
      <button id="btnBlank" class="ghost"><%= t('jeopardy.clearQuestions') %></button>
      <button id="btnImport" class="ghost"><%= t('jeopardy.importJson') %></button>
      <input type="file" id="file" accept=".json" style="display:none">
    </div>
    <div class="row" style="margin-bottom:12px">
      <button id="btnGen" class="dark"><%= t('jeopardy.buildFromVocabulary') %></button>
      <span class="field"><%= t('jeopardy.questionTypeLabel') %>
        <select id="genMode" style="min-width:170px">
          <option value="mixed" selected><%= t('jeopardy.modeMixed') %></option>
          <option value="py2zh"><%= t('jeopardy.modePy2Zh') %></option>
          <option value="en2zh"><%= t('jeopardy.modeEn2Zh') %></option>
          <option value="zh2en"><%= t('jeopardy.modeZh2En') %></option>
          <option value="zh2py"><%= t('jeopardy.modeZh2Py') %></option>
          <option value="sentence"><%= t('jeopardy.modeSentence') %></option>
        </select>
      </span>
    </div>
    <div id="bankSource"></div>
    <div id="cats" class="cats"></div>
  </section>

  <section>
    <h2><span class="num">3</span><%= t('jeopardy.step3Heading') %></h2>
    <div class="row" style="margin-bottom:10px">
      <input type="text" id="teamName" placeholder="<%= t('jeopardy.teamNamePlaceholder') %>" style="flex:0 1 240px">
      <button id="btnAddTeam"><%= t('jeopardy.addTeam') %></button>
    </div>
    <div id="teams" class="teams"></div>
  </section>

  <section>
    <h2><span class="num">4</span><%= t('jeopardy.step4Heading') %></h2>
    <div class="row">
      <button id="btnStart" class="dark">▶ <%= t('jeopardy.startFullScreenGame') %></button>
      <button id="btnPPTX" class="primary"><%= t('jeopardy.exportPptx') %></button>
      <button id="btnPDF" class="primary"><%= t('jeopardy.exportPdf') %></button>
      <button id="btnJSON"><%= t('jeopardy.exportJson') %></button>
    </div>
    <p class="hint" style="margin-top:10px">
      <%= t('jeopardy.playHintPrefix') %><b>T</b><%= t('jeopardy.playHintMid1') %><b>Space</b><%= t('jeopardy.playHintMid2') %><b>Enter</b><%= t('jeopardy.playHintSuffix') %>
    </p>
  </section>

  <footer><%= t('jeopardy.footer') %></footer>
</div>

<!-- 出题弹窗 -->
<div class="modal" id="modal">
  <div class="sheet">
    <h3 id="mTitle"><%= t('jeopardy.editQuestion') %></h3>
    <label class="hint" style="display:block;margin:0"><%= t('jeopardy.questionShownLabel') %></label>
    <textarea id="mQ" placeholder="<%= t('jeopardy.questionPlaceholder') %>"></textarea>
    <label class="hint" style="display:block;margin:8px 0 0"><%= t('jeopardy.answerLabel') %></label>
    <textarea id="mA" placeholder="Evaporation" style="min-height:60px"></textarea>
    <div class="row" style="margin-top:10px">
      <label class="check"><input type="checkbox" id="mDD"> <%= t('jeopardy.dailyDoubleLabel') %></label>
      <span class="grow"></span>
      <button id="mClear" class="ghost"><%= t('jeopardy.clearCell') %></button>
      <button id="mCancel"><%= t('jeopardy.cancel') %></button>
      <button id="mSave" class="primary"><%= t('jeopardy.save') %></button>
    </div>
  </div>
</div>

<!-- 比赛界面 -->
<div id="game">
  <div id="gtop">
    <h2 id="gtitle"><%= t('jeopardy.title') %></h2>
    <button id="gExit"><%= t('jeopardy.exit') %></button>
  </div>
  <div id="gboard"></div>
  <div id="scores"></div>
</div>

<!-- 题目界面 -->
<div id="clue">
  <div id="chead"></div>
  <div id="cbody">
    <div>
      <div id="cq"></div>
      <div id="ca"></div>
    </div>
  </div>
  <div id="timerbar"><div id="timerfill"></div></div>
  <div id="cfoot">
    <button id="cTimer" class="primary"><%= t('jeopardy.startTimer') %></button>
    <button id="cStop" class="mini"><%= t('jeopardy.pause') %></button>
    <span style="font-weight:700"><span id="tleft">20</span> <%= t('jeopardy.secondsLeft') %></span>
    <button id="cReveal"><%= t('jeopardy.revealAnswer') %></button>
    <span style="width:14px"></span>
    <div id="cteams" style="display:flex;gap:8px;flex-wrap:wrap"></div>
    <span style="width:14px"></span>
    <button id="cDone" class="dark"><%= t('jeopardy.finishQuestion') %></button>
    <button id="cBack" class="mini"><%= t('jeopardy.returnWithoutCompleting') %></button>
  </div>
</div>

<%- include('../partials/tool-guide', { toolGuide: toolGuide }) %>

<div id="toast" class="toast"></div>

<script src="/shared/wordlist-core.js"></script>
<script src="/shared/deck-export.js"></script>
<script src="/shared/library-picker.js"></script>
<script src="/low-prep/jeopardy/jeopardy.js"></script>
<script src="/javascripts/account-coming-soon.js"></script>
<script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
