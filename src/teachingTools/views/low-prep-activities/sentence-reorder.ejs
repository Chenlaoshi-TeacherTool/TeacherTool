<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#356e57">
  <title>Sentence Reorder - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'Type in sentences and turn them into drag-and-drop word puzzles. Students drag the scrambled words back into the correct order, right in the browser.' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/shared/library-picker.css">
  <link rel="stylesheet" href="/low-prep/sentence-reorder/sentence-reorder.css?v=4">
</head>
<body class="reorder-page">
  <main class="reorder-wrap">
    <header class="reorder-header">
      <div class="reorder-header-content">
        <a href="/teaching-tools#low-prep-activities" class="back-btn"><%= t('sentenceReorder.backBtn') %></a>
        <p class="reorder-eyebrow"><%= t('sentenceReorder.eyebrow') %></p>
        <h1>🧩 <%= t('sentenceReorder.title') %></h1>
        <p><%= t('sentenceReorder.subtitle') %></p>
        <div class="reorder-hero-points" aria-label="Tool highlights">
          <span><%= t('sentenceReorder.heroPoint1') %></span>
          <span><%= t('sentenceReorder.heroPoint2') %></span>
          <span><%= t('sentenceReorder.heroPoint3') %></span>
        </div>
      </div>
    </header>

    <div class="reorder-layout">
      <section class="reorder-builder" aria-label="Set up the puzzle">
        <section class="reorder-panel">
          <div class="reorder-panel-heading">
            <div>
              <span class="reorder-step">1</span>
              <p class="reorder-kicker"><%= t('sentenceReorder.sentencesKicker') %></p>
              <h2><%= t('sentenceReorder.sentencesHeading') %></h2>
            </div>
          </div>
          <label for="sentence-input"><%= t('sentenceReorder.sentencesLabel') %></label>
          <textarea id="sentence-input" rows="6" placeholder="The quick brown fox jumps over the lazy dog.&#10;She sells seashells by the seashore."></textarea>
          <p class="reorder-help"><%= t('sentenceReorder.punctuationHelp') %></p>
          <div id="sentenceLibraryPicker"></div>
        </section>

        <section class="reorder-panel">
          <div class="reorder-panel-heading">
            <div>
              <span class="reorder-step">2</span>
              <p class="reorder-kicker"><%= t('sentenceReorder.optionsKicker') %></p>
              <h2><%= t('sentenceReorder.optionsHeading') %></h2>
            </div>
          </div>
          <label class="reorder-checkbox">
            <input type="checkbox" id="hide-punctuation-case">
            <%= t('sentenceReorder.ignoreCaseLabel') %>
          </label>
        </section>

        <button id="generate-button" class="reorder-primary" type="button">🧩 <%= t('sentenceReorder.generateButton') %></button>
        <p id="setup-status" class="reorder-setup-status" aria-live="polite"><%= t('sentenceReorder.setupStatusDefault') %></p>
      </section>

      <section id="reorder-fullscreen-shell" class="reorder-preview-panel" aria-label="Puzzle stage">
        <div class="reorder-preview-heading">
          <h2><%= t('sentenceReorder.stageHeading') %></h2>
          <p id="progress-text" class="reorder-progress-text"><%= t('sentenceReorder.noPuzzleYet') %></p>
        </div>

        <div id="puzzle-stage" class="reorder-stage">
          <p class="reorder-stage-empty"><%= t('sentenceReorder.stageEmpty') %></p>
        </div>

        <p id="feedback-text" class="reorder-feedback" aria-live="polite"></p>

        <div class="reorder-stage-controls">
          <button id="check-button" class="reorder-primary" type="button" disabled>✓ <%= t('sentenceReorder.checkButton') %></button>
          <button id="shuffle-button" class="reorder-secondary" type="button" disabled>🔀 <%= t('sentenceReorder.shuffleButton') %></button>
          <button id="reveal-button" class="reorder-secondary" type="button" disabled>👀 <%= t('sentenceReorder.revealButton') %></button>
          <button
            id="fullscreen-button"
            class="reorder-secondary"
            type="button"
            aria-pressed="false"
            data-enter-label="⛶ <%= t('sentenceReorder.fullscreenButton') %>"
            data-exit-label="✕ <%= t('sentenceReorder.exitFullscreenButton') %>"
            disabled
          >⛶ <%= t('sentenceReorder.fullscreenButton') %></button>
        </div>
        <div class="reorder-nav-controls">
          <button id="prev-button" class="reorder-secondary" type="button" disabled>← <%= t('sentenceReorder.prevButton') %></button>
          <button id="next-button" class="reorder-primary" type="button" disabled><%= t('sentenceReorder.nextButton') %> →</button>
        </div>

        <div id="reorder-celebration" class="reorder-celebration" aria-hidden="true" role="status">
          <div id="reorder-confetti" class="reorder-confetti" aria-hidden="true"></div>
          <div class="reorder-celebration-card">
            <span class="reorder-celebration-icon" aria-hidden="true">🎉</span>
            <p class="reorder-celebration-title"><%= t('sentenceReorder.celebrationTitle') %></p>
            <p class="reorder-celebration-subtitle"><%= t('sentenceReorder.celebrationSubtitle') %></p>
          </div>
        </div>
      </section>
    </div>
  </main>

  <%- include('../partials/tool-guide', { toolGuide: toolGuide }) %>

  <script src="/shared/library-picker.js" defer></script>
  <script src="/low-prep/sentence-reorder/sentence-reorder.js?v=6" defer></script>
  <script src="/javascripts/account-coming-soon.js"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
