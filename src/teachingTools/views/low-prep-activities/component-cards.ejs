<% var zh = lang === 'zh'; function L(en, cn) { return zh ? cn : en; } %><!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#356e57">
  <title>部件卡片 · Component Cards - Chen Laoshi's Teaching Toolkit</title>
  <%- include('../partials/seo', { pageDescription: 'Type Chinese characters and colour each component: show colour cards like 好 = 女 + 子 on the projector, print a colour-by-component worksheet, or print the components as cut-out pieces students glue back together. 输入汉字，按部件上色：彩色字卡、部件涂色练习纸、部件拼图。' }) %>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Andika:wght@400;700&display=swap">
  <link rel="stylesheet" href="/stylesheets/site-theme.css">
  <link rel="stylesheet" href="/low-prep/component-cards/component-cards.css?v=7">
  <style id="cc-page-size">@page { size: A4; margin: 0; }</style>
</head>
<body class="cc-page">
  <main class="cc-wrap">
    <header class="cc-header">
      <a href="/teaching-tools#low-prep-activities" class="back-btn back-btn--light"><%= L('← Back to Teaching Tools', '← 返回教学工具') %></a>
      <p class="cc-eyebrow"><%= L('Characters · components', '汉字 · 部件') %></p>
      <h1>🎨 <%= L('Component Cards', '部件卡片') %></h1>
      <p><%= L('Type characters and every component gets its own colour. Show colour cards on the projector, print a colour-by-component sheet, or print the components as pieces to cut out and glue back together.', '输入汉字，每个部件自动换一种颜色。可以投影彩色字卡，打印照图例涂色的练习纸，或把部件印成小块，让学生剪下来拼回原字。') %></p>
    </header>

    <div class="cc-layout">
      <section class="cc-builder" aria-label="<%= L('Settings', '设置') %>">
        <section class="cc-panel">
          <p class="cc-kicker"><span class="cc-step">1</span><%= L('Characters', '汉字') %></p>
          <label for="ccChars"><%= L('Characters or words', '汉字或词语') %> <small><%= L('(up to 24 characters)', '（最多 24 个字）') %></small></label>
          <textarea id="ccChars" rows="3" spellcheck="false">好 明 休 林 河 想</textarea>
          <div id="ccChips" class="cc-chips" aria-live="polite"></div>
          <p id="ccStatus" class="cc-note" role="status"></p>
        </section>

        <section class="cc-panel">
          <p class="cc-kicker"><span class="cc-step">2</span><%= L('What to make', '做什么') %></p>
          <div class="cc-modes" role="radiogroup" aria-label="<%= L('Output', '输出') %>">
            <button type="button" role="radio" data-mode="color" aria-checked="true">🌈 <b><%= L('Colour cards', '彩色字卡') %></b><small><%= L('Projector or print', '投影或打印') %></small></button>
            <button type="button" role="radio" data-mode="coloring" aria-checked="false">🖍️ <b><%= L('Colouring sheet', '部件涂色') %></b><small><%= L('Students colour by legend', '学生照图例涂色') %></small></button>
            <button type="button" role="radio" data-mode="puzzle" aria-checked="false">✂️ <b><%= L('Cut-out puzzle', '部件拼图') %></b><small><%= L('Cut, then glue back', '剪下来拼回原字') %></small></button>
            <button type="button" role="radio" data-mode="tracing" aria-checked="false">✏️ <b><%= L('Component tracing', '部件描红') %></b><small><%= L('Trace part by part, then write', '一个部件一个部件地描') %></small></button>
            <button type="button" role="radio" data-mode="explain" aria-checked="false">🖼️ <b><%= L('Component guide cards', '部件图解卡') %></b><small><%= L('What a component means, with examples', '部件的意思和例字') %></small></button>
            <button type="button" role="radio" data-mode="family" aria-checked="false">🌳 <b><%= L('Component family', '部件家族图') %></b><small><%= L('One component, many characters', '一个部件，一串字') %></small></button>
          </div>
        </section>

        <section class="cc-panel" data-for="explain">
          <p class="cc-kicker"><span class="cc-step">🖼️</span><%= L('Components', '部件') %> <small id="ccGuideCount" class="cc-note"></small></p>
          <div class="cc-gd-tools">
            <button type="button" id="ccGuideFromChars" class="cc-btn cc-btn-ghost">🔎 <%= L('Find them in the characters above', '从上面的字里找部件') %></button>
            <button type="button" id="ccGuideClear" class="cc-btn cc-btn-ghost"><%= L('Clear', '清空') %></button>
          </div>
          <div id="ccGuideList" class="cc-gd-list"></div>
          <label class="cc-check"><input type="checkbox" id="ccGuidePractice" checked> <%= L('Add a “write more characters” row (1–2 per page)', '加“写一写”练习格（每页 1–2 张时）') %></label>
          <label class="cc-check"><input type="checkbox" id="ccGuideEn" checked> <%= L('Show English', '显示英文') %></label>
          <p class="cc-note"><%= L('On the preview, click the meaning or the explanation to change the words, and click an example character to swap it. Your changes stay in this browser.', '在预览上点“意思”或“讲解”可以直接改字，点例字可以换成别的字。改过的内容存在这个浏览器里。') %></p>
          <button type="button" id="ccGuideReset" class="cc-btn cc-btn-ghost" hidden><%= L('Undo my changes', '撤销我的修改') %></button>
        </section>

        <section class="cc-panel" data-for="family">
          <p class="cc-kicker"><span class="cc-step">🌳</span><%= L('Family', '家族') %></p>
          <div class="cc-two">
            <div>
              <label for="ccFamComp"><%= L('Component in the middle', '中间的部件') %></label>
              <input id="ccFamComp" type="text" maxlength="2" value="氵" class="cc-fam-comp">
            </div>
            <div>
              <label for="ccFamCount"><%= L('Characters around it', '周围几个字') %></label>
              <select id="ccFamCount">
                <option value="4">4</option>
                <option value="6" selected>6</option>
                <option value="8">8</option>
              </select>
            </div>
          </div>
          <label for="ccFamCaption"><%= L('Words under the component', '部件下面的说明') %> <small><%= L('(optional)', '（可不填）') %></small></label>
          <input id="ccFamCaption" type="text" maxlength="30" placeholder="<%= L('e.g. water (三点水)', '比如：三点水 · 和水有关') %>">
          <label for="ccFamBlank"><%= L('Empty boxes for students to fill in', '留几个空格让学生写') %></label>
          <select id="ccFamBlank">
            <option value="0"><%= L('None (teacher display)', '不留（老师展示）') %></option>
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="all"><%= L('All of them', '全部留空') %></option>
          </select>
          <p class="cc-note"><%= L('Characters you typed above that contain this component come first; click the suggestions to add or remove characters.', '上面输入的字里含有这个部件的会排在前面；点下面的推荐字可以加入或拿掉。') %></p>
          <div id="ccFamPick" class="cc-chips"></div>
        </section>

        <section class="cc-panel">
          <p class="cc-kicker"><span class="cc-step">3</span><%= L('Settings', '设置') %></p>
          <label for="ccTitle"><%= L('Title on the sheet', '纸上的标题') %> <small><%= L('(optional)', '（可不填）') %></small></label>
          <input id="ccTitle" type="text" maxlength="60" placeholder="<%= L('e.g. Lesson 3 characters', '比如：第三课 生字') %>">
          <div class="cc-two">
            <div>
              <label for="ccPer"><%= L('Characters per page', '每页几个字') %></label>
              <select id="ccPer"></select>
            </div>
            <div>
              <label for="ccPaper"><%= L('Paper', '纸张') %></label>
              <select id="ccPaper">
                <option value="A4">A4</option>
                <option value="Letter">Letter</option>
              </select>
            </div>
          </div>
          <div data-for="tracing">
            <label for="ccRows"><%= L('Practice rows per character', '每个字练几行') %></label>
            <select id="ccRows">
              <option value="1">1</option>
              <option value="2" selected>2</option>
            </select>
          </div>
          <label class="cc-check"><input type="checkbox" id="ccPinyin" checked> <%= L('Show pinyin', '显示拼音') %></label>
          <label class="cc-check" data-for="coloring family"><input type="checkbox" id="ccKey" checked> <%= L('Add a coloured answer page', '加一页彩色答案') %></label>
          <label class="cc-check" data-for="puzzle"><input type="checkbox" id="ccHint" checked> <%= L('Faint outline on the gluing board', '拼贴格里印淡淡的轮廓') %></label>
          <label class="cc-check" data-for="puzzle"><input type="checkbox" id="ccPieceColor"> <%= L('Pieces in colour (otherwise black)', '部件印成彩色（不勾就是黑色）') %></label>
        </section>

        <section class="cc-panel">
          <p class="cc-kicker"><span class="cc-step">4</span><%= L('Adjust a split (optional)', '调整拆法（可不做）') %></p>
          <p class="cc-note"><%= L('Click a character above, then click its strokes to move them to another component. Type the component names below.', '先点上面的某个字，再点它的笔画，就能把这一笔换到别的部件。部件名称可以在下面改。') %></p>
          <div id="ccEditor" class="cc-editor" hidden>
            <div id="ccEditorChar" class="cc-editor-char"></div>
            <div>
              <div id="ccEditorParts" class="cc-editor-parts"></div>
              <button id="ccEditorReset" type="button" class="cc-btn cc-btn-ghost"><%= L('Back to the original split', '恢复原来的拆法') %></button>
            </div>
          </div>
        </section>
      </section>

      <section class="cc-preview" aria-label="<%= L('Preview', '预览') %>">
        <div class="cc-toolbar">
          <button id="ccPrint" type="button" class="cc-btn">🖨️ <%= L('Print / Save PDF', '打印 / 存成 PDF') %></button>
          <button id="ccShow" type="button" class="cc-btn cc-btn-ghost">📽️ <%= L('Show on projector', '投影展示') %></button>
          <button id="ccBundle" type="button" class="cc-btn cc-btn-ghost">📦 <%= L('Print several together', '一起打印') %></button>
        </div>
        <div id="ccBundlePanel" class="cc-bundle" hidden>
          <p><b><%= L('Which outputs go into one PDF?', '哪几种放进同一个 PDF？') %></b> <small><%= L('Each uses the settings you chose in its own mode.', '每种都用你在它那里选的设置。') %></small></p>
          <div id="ccBundleModes" class="cc-bundle-modes"></div>
          <label class="cc-check"><input type="checkbox" id="ccBundleCovers" checked> <%= L('A divider page before each one', '每种前面加一张分隔页') %></label>
          <button id="ccBundleGo" type="button" class="cc-btn"><%= L('Put them together', '合在一起预览') %></button>
        </div>
        <div id="ccBundleBar" class="cc-bundle-bar" hidden>
          <span id="ccBundleBarText"></span>
          <button id="ccBundleBack" type="button" class="cc-btn cc-btn-ghost"><%= L('Back to one output', '返回单项') %></button>
        </div>
        <div id="ccStage" class="cc-stage"><div id="ccSheets" class="cc-sheets"></div></div>
      </section>
    </div>
  </main>

  <div id="ccShowBox" class="cc-show" hidden>
    <button type="button" class="cc-show-close" id="ccShowClose" aria-label="<%= L('Close', '关闭') %>">✕</button>
    <div id="ccShowCard" class="cc-show-card"></div>
    <div class="cc-show-bar">
      <button type="button" id="ccShowPrev" class="cc-btn cc-btn-ghost">←</button>
      <button type="button" id="ccShowSplit" class="cc-btn"><%= L('Split apart', '拆开') %></button>
      <span id="ccShowCount"></span>
      <button type="button" id="ccShowNext" class="cc-btn cc-btn-ghost">→</button>
    </div>
  </div>

  <div id="ccGuidePop" class="cc-gd-pop" hidden></div>

  <%- include('../partials/tool-guide', { toolGuide: toolGuide }) %>

  <script>window.CC_LANG = <%- JSON.stringify(zh ? 'zh' : 'en') %>;</script>
  <script src="/shared/wordlist-core.js?v=zh-1"></script>
  <script src="/shared/wordlist-handoff.js?v=1"></script>
  <script src="/shared/print-pack.js?v=1"></script>
  <script src="/low-prep/component-cards/component-cards.js?v=6" defer></script>
  <script src="/javascripts/account-coming-soon.js"></script>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
