<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><meta name="theme-color" content="#194f45">
  <title>Contact Chen Laoshi - Chen Laoshi's Teaching Toolkit</title>
  <%- include('partials/seo', { pageDescription: 'Contact Chen Laoshi about a teaching tool, suggest a classroom resource, or ask a question about site content and privacy.' }) %>
  <link rel="stylesheet" href="/stylesheets/site-theme.css"><link rel="stylesheet" href="/stylesheets/content-pages.css">
</head>
<body>
  <header class="content-hero"><div class="content-shell"><p class="content-kicker"><%= t('contact.kicker') %></p><h1><%= t('contact.title') %></h1><p><%= t('contact.intro') %></p></div></header>
  <main class="content-section"><div class="content-shell contact-grid">
    <section class="contact-card"><h2><%= t('contact.emailTitle') %></h2><p><a href="mailto:clsteachingtools@gmail.com">clsteachingtools@gmail.com</a></p><p><%= t('contact.emailHelp') %></p><a class="btn" href="mailto:clsteachingtools@gmail.com?subject=Chen%20Laoshi%20Teaching%20Toolkit%20feedback"><%= t('contact.emailCta') %></a></section>
    <section class="contact-card"><h2><%= t('contact.reasonsTitle') %></h2><ul><li><%= t('contact.reason1') %></li><li><%= t('contact.reason2') %></li><li><%= t('contact.reason3') %></li><li><%= t('contact.reason4') %></li></ul></section>
    <section class="contact-card contact-card--wide"><h2><%= t('contact.privacyTitle') %></h2><p><%= t('contact.privacyP1') %></p><p><%= t('contact.privacyP2Prefix') %><a href="/privacy"><%= t('contact.privacyP2Link') %></a><%= t('contact.privacyP2Suffix') %></p></section>
  </div></main>
  <script src="/javascripts/milk-tea-footer.js"></script>
</body>
</html>
