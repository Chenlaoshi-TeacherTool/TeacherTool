<header class="site-header">
    <div class="site-header-inner">
        <a class="site-header-brand" href="/">
            <img src="/images/chen-laoshi-logo.svg" alt="">
            <span><%= t('nav.brand') %></span>
        </a>
        <nav class="site-header-nav" aria-label="Main">
            <a href="/teaching-tools"><%= t('nav.tools') %></a>
            <a href="/theme-activities"><%= t('nav.activities') %></a>
            <a href="/resources"><%= t('nav.resources') %></a>
            <a href="/about"><%= t('nav.about') %></a>
            <a href="/contact"><%= t('nav.contact') %></a>
        </nav>
        <div class="site-header-lang" role="group" aria-label="Language / 语言">
            <a class="<%= lang === 'en' ? 'is-active' : '' %>" href="/set-language?lang=en&redirect=<%= encodeURIComponent(requestPath || '/') %>" hreflang="en" lang="en">EN</a>
            <a class="<%= lang === 'zh' ? 'is-active' : '' %>" href="/set-language?lang=zh&redirect=<%= encodeURIComponent(requestPath || '/') %>" hreflang="zh" lang="zh">中文</a>
        </div>
    </div>
</header>
